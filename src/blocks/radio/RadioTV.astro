---
/**
 * Robo Radio — TV player
 * Figma: Robo Radio "1 hero" (10105:275, 1730×983) and Episode player (10105:2825, 1730×872)
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10105-275
 * The TV is a static poster (the screen, its CRT look and the robot). Play puts the
 * episode's YouTube video on the screen with Figma's CRT shader over it (CrtScreen in
 * overlay mode, the screen's Figma settings: scanlines 59 / 3, shadow mask 9 / 12, static
 * 18, vignette 24, flicker 62, roll 0.93).
 * Controls (Figma "player nav", 504×80): previous · play / pause · next, the progress
 * line (seekable), and a sound button at the end (episodes play muted until it's on). They play the episodes that have a video, newest first: the hero starts
 * with the newest, an episode page with its own; previous / next move along that list in
 * place, and the next one starts when an episode ends.
 * Previous / next slide the screens sideways like the TV's row of screens: the screen
 * moves out and the next one (the cut-off screen at the edge) slides into its place, then
 * the episode starts on it.
 * The YouTube player (privacy-enhanced, youtube-nocookie) loads only on the first play. Its
 * own overlays (title, logo) sit at the frame's edges, so the frame is a little bigger
 * than the screen and they fall outside it; captions are switched off; the screen takes no
 * pointer input, so YouTube's hover overlays never show.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import WebGLSlot from '../../components/ui/WebGLSlot.astro';
import CrtScreen from '../../components/ui/CrtScreen.astro';
import hero from '../../assets/radio/tv-hero.png';
import episode from '../../assets/radio/tv-episode.png';

interface Props {
  variant?: 'hero' | 'episode';
  /** YouTube id of the episode to start with (episode page); the hero starts with the newest */
  start?: string;
}
const { variant = 'hero', start } = Astro.props;
const playlist = (await getCollection('episodes', (e) => !!e.data.youtube))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({ id: e.data.youtube!, title: e.data.title }));
const first = Math.max(0, start ? playlist.findIndex((p) => p.id === start) : 0);
const poster = variant === 'hero' ? hero : episode;
const h = variant === 'hero' ? 983 : 872;
// Player bar: hero (105, 843) · episode (110, 759) — Figma's controls frame + its 5px inset
const bar = variant === 'hero' ? { x: 105, y: 843 } : { x: 110, y: 759 };
const crt = { scanlines: 59, scanlineSize: 3, vignette: 24, curvature: 10, jitter: 3 };
---
<section
  class:list={['radio-tv', `radio-tv--${variant}`]}
  style={`aspect-ratio: 1730 / ${h}`}
  aria-label="Robo Radio player"
  data-tv
  data-playlist={JSON.stringify(playlist)}
  data-index={first}
>
  <WebGLSlot name="radio-tv" class="radio-tv__scene">
    <Image src={poster} alt="" widths={[1730, 3460]} sizes="100vw" loading={variant === 'hero' ? 'eager' : 'lazy'} />
  </WebGLSlot>
  <div class="radio-tv__screen" data-screen>
    <div class="radio-tv__video" data-video></div>
    <CrtScreen overlay settings={crt} />
  </div>
  <!-- The next screen in the row, sliding in on previous / next -->
  <div class="radio-tv__ghost" aria-hidden="true" data-ghost></div>

  {playlist.length > 0 && (
    <div class="radio-tv__bar" style={`left:${(bar.x / 1730) * 100}%;top:${(bar.y / h) * 100}%`} role="group" aria-label="Player">
      <button type="button" class="radio-tv__btn radio-tv__btn--prev" aria-label="Previous episode" data-prev>
        <svg viewBox="0 24 32 32" fill="none" aria-hidden="true"><path stroke="currentColor" stroke-width="1.5" d="m12.75 40.97 11.53 6.96 1.97-1.13V32.83l-1.89-1.15-11.61 6.9zm-.5-9.42h-5.5v16.5h5.5z" /></svg>
      </button>
      <button type="button" class="radio-tv__btn radio-tv__btn--play" aria-label="Play" data-play>
        <svg class="radio-tv__icon-play" viewBox="46.4 9.8 60 60" fill="none" aria-hidden="true"><path stroke="currentColor" stroke-width="1.5" d="M85.38 41.55 70.4 50.34l-2.74-1.53V31.23l2.63-1.56 15.08 8.72z" /></svg>
        <svg class="radio-tv__icon-pause" viewBox="46.4 9.8 60 60" fill="none" aria-hidden="true"><path stroke="currentColor" stroke-width="1.5" d="M68.4 31.25h5v17.5h-5zm11 0h5v17.5h-5z" /></svg>
      </button>
      <button type="button" class="radio-tv__btn radio-tv__btn--next" aria-label="Next episode" data-next>
        <svg viewBox="124 24 32 32" fill="none" aria-hidden="true"><path stroke="currentColor" stroke-width="1.5" d="M141.05 40.97l-11.53 6.96-1.97-1.13V32.83l1.89-1.15 11.61 6.9zm.5-9.42h5.5v16.5h-5.5z" /></svg>
      </button>
      <input class="radio-tv__seek" type="range" min="0" max="1000" value="0" step="1" aria-label="Position in the episode" data-seek />
      <button type="button" class="radio-tv__btn radio-tv__btn--sound" aria-label="Sound on" aria-pressed="false" data-sound>
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path stroke="currentColor" stroke-width="1.5" d="M7 13h4l6-5v16l-6-5H7z" />
          <path class="radio-tv__icon-muted" stroke="currentColor" stroke-width="1.5" d="m20.5 12.5 7 7m0-7-7 7" />
          <path class="radio-tv__icon-sound" stroke="currentColor" stroke-width="1.5" d="M20.5 12.5a5 5 0 0 1 0 7m3-10a9 9 0 0 1 0 13" />
        </svg>
      </button>
      <p class="radio-tv__title visually-hidden" aria-live="polite" data-title></p>
    </div>
  )}
</section>

<script>
  type Item = { id: string; title: string };
  type YTPlayer = {
    playVideo(): void;
    pauseVideo(): void;
    mute(): void;
    unMute(): void;
    loadVideoById(id: string): void;
    getCurrentTime(): number;
    getDuration(): number;
    seekTo(s: number, allowAhead: boolean): void;
    getPlayerState(): number;
    getIframe(): HTMLIFrameElement;
    unloadModule?(name: string): void;
  };
  type YTNamespace = {
    Player: new (el: HTMLElement, opts: Record<string, unknown>) => YTPlayer;
    PlayerState: { ENDED: number; PLAYING: number; PAUSED: number };
  };
  const w = window as unknown as { YT?: YTNamespace; onYouTubeIframeAPIReady?: () => void };

  // Load YouTube's player API once, on the first play
  let api: Promise<YTNamespace> | null = null;
  const loadApi = () =>
    (api ??= new Promise((resolve) => {
      if (w.YT?.Player) return resolve(w.YT);
      const prev = w.onYouTubeIframeAPIReady;
      w.onYouTubeIframeAPIReady = () => {
        prev?.();
        resolve(w.YT!);
      };
      const s = document.createElement('script');
      s.src = 'https://www.youtube.com/iframe_api';
      document.head.append(s);
    }));

  for (const root of document.querySelectorAll<HTMLElement>('[data-tv]')) {
    const list: Item[] = JSON.parse(root.dataset.playlist || '[]');
    if (!list.length) continue;
    let index = Number(root.dataset.index) || 0;
    const mount = root.querySelector<HTMLElement>('[data-video]')!;
    const screen = root.querySelector<HTMLElement>('[data-screen]')!;
    const ghost = root.querySelector<HTMLElement>('[data-ghost]')!;
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const seek = root.querySelector<HTMLInputElement>('[data-seek]')!;
    const title = root.querySelector<HTMLElement>('[data-title]')!;
    const soundBtn = root.querySelector<HTMLButtonElement>('[data-sound]')!;
    let player: YTPlayer | null = null;
    let playing = false;
    let sound = false; // muted until the visitor turns the sound on
    let seeking = false;
    let frame = 0;

    const setPlaying = (on: boolean) => {
      playing = on;
      root.classList.toggle('is-playing', on);
      playBtn.setAttribute('aria-label', on ? 'Pause' : 'Play');
      cancelAnimationFrame(frame);
      if (on) frame = requestAnimationFrame(tick);
    };
    // The progress line follows the video while it plays
    const tick = () => {
      if (player && !seeking) {
        const d = player.getDuration();
        seek.value = d ? String(Math.round((player.getCurrentTime() / d) * 1000)) : '0';
        showProgress();
      }
      if (playing) frame = requestAnimationFrame(tick);
    };
    // The played part of the line is solid white
    const showProgress = () => seek.style.setProperty('--p', String(Number(seek.value) / 1000));
    const announce = () => (title.textContent = `Now playing: ${list[index].title}`);

    // The YouTube frame covers the screen at 16:9 and is 15% bigger, so YouTube's title
    // (top) and logo (bottom right) fall outside the screen
    const OVERSCAN = 1.15;
    const fit = () => {
      const frameEl = player?.getIframe();
      if (!frameEl) return;
      const w = screen.offsetWidth;
      const h = screen.offsetHeight;
      const vw = Math.max(w, (h * 16) / 9) * OVERSCAN;
      const vh = (vw * 9) / 16;
      Object.assign(frameEl.style, { width: `${vw}px`, height: `${vh}px`, left: `${(w - vw) / 2}px`, top: `${(h - vh) / 2}px` });
    };
    addEventListener('resize', fit);
    const noCaptions = () => {
      player?.unloadModule?.('captions');
      player?.unloadModule?.('cc');
    };

    // Slide to the next screen in the row: the screen moves out one screen-width (plus the
    // gap between the TV's screens) and the next one comes in from the other side
    const SLIDE = 'translateX(calc(%s * (100% + 2.4%)))';
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let sliding: Promise<void> | null = null;
    const slide = (dir: number) =>
      new Promise<void>((done) => {
        if (reduced) return done();
        ghost.style.transition = screen.style.transition = 'none';
        ghost.style.transform = SLIDE.replace('%s', String(dir));
        screen.style.transform = '';
        ghost.classList.add('is-in');
        void ghost.offsetWidth;
        ghost.style.transition = screen.style.transition = '';
        ghost.style.transform = 'translateX(0)';
        screen.style.transform = SLIDE.replace('%s', String(-dir));
        let finished = false;
        const onEnd = (e: TransitionEvent) => e.propertyName === 'transform' && finish();
        const finish = () => {
          if (finished) return;
          finished = true;
          ghost.removeEventListener('transitionend', onEnd);
          // the screen is back in place (now showing the next episode); the ghost goes
          screen.style.transition = 'none';
          screen.style.transform = '';
          void screen.offsetWidth;
          screen.style.transition = '';
          ghost.classList.remove('is-in');
          done();
        };
        ghost.addEventListener('transitionend', onEnd);
        setTimeout(finish, 1200); // in case the transition never reports (background tab)
      });

    const start = async () => {
      if (player) return player;
      root.classList.add('is-on');
      const YT = await loadApi();
      return new Promise<YTPlayer>((resolve) => {
        const p = new YT.Player(mount, {
          host: 'https://www.youtube-nocookie.com',
          videoId: list[index].id,
          playerVars: { autoplay: 1, controls: 0, rel: 0, playsinline: 1, modestbranding: 1, iv_load_policy: 3, cc_load_policy: 0, disablekb: 1, fs: 0 },
          events: {
            onReady: () => {
              player = p;
              fit();
              if (sound) p.unMute();
              else p.mute();
              p.playVideo();
              announce();
              resolve(p);
            },
            onStateChange: (e: { data: number }) => {
              if (e.data === YT.PlayerState.PLAYING) {
                noCaptions();
                setPlaying(true);
              }
              else if (e.data === YT.PlayerState.PAUSED) setPlaying(false);
              else if (e.data === YT.PlayerState.ENDED) go(1);
            },
          },
        });
      });
    };
    const go = async (step: number) => {
      if (sliding) return; // one slide at a time
      index = (index + step + list.length) % list.length;
      seek.value = '0';
      showProgress();
      player?.pauseVideo();
      sliding = slide(step);
      await sliding;
      sliding = null;
      const p = await start();
      p.loadVideoById(list[index].id);
      announce();
    };

    playBtn.addEventListener('click', async () => {
      if (!player) return void start();
      if (playing) player.pauseVideo();
      else player.playVideo();
    });
    soundBtn.addEventListener('click', () => {
      sound = !sound;
      root.classList.toggle('is-sound', sound);
      soundBtn.setAttribute('aria-pressed', String(sound));
      soundBtn.setAttribute('aria-label', sound ? 'Mute' : 'Sound on');
      if (sound) player?.unMute();
      else player?.mute();
    });
    root.querySelector('[data-prev]')!.addEventListener('click', () => go(-1));
    root.querySelector('[data-next]')!.addEventListener('click', () => go(1));
    seek.addEventListener('input', () => {
      seeking = true;
      showProgress();
    });
    seek.addEventListener('change', () => {
      seeking = false;
      if (player) player.seekTo((Number(seek.value) / 1000) * player.getDuration(), true);
    });
  }
</script>

<style>
  .radio-tv {
    position: relative;
    background: var(--color-black);
    overflow: hidden;
  }
  .radio-tv :global(.radio-tv__scene) {
    position: absolute;
    inset: 0;
  }
  .radio-tv :global(.radio-tv__scene img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The CRT screen inside the poster: 6.25–93.5% across, 2–86.3% down. Black until the
     first play, so the poster shows through; the video and the CRT layer fade in then */
  .radio-tv__screen {
    position: absolute;
    left: 6.25%;
    top: 2%;
    width: 87.25%;
    height: 84.3%;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    background: var(--color-black);
    transition: opacity var(--duration-smooth) var(--ease-out);
  }
  .radio-tv.is-on .radio-tv__screen {
    opacity: 1;
  }
  .radio-tv__video,
  .radio-tv__screen :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  /* sized by the script (overscan) */
  .radio-tv__screen :global(iframe) {
    inset: auto;
  }
  /* Previous / next: the screen and the next one slide together */
  .radio-tv__screen,
  .radio-tv__ghost {
    transition:
      opacity var(--duration-smooth) var(--ease-out),
      transform 0.9s cubic-bezier(0.65, 0, 0.35, 1);
  }
  /* The next screen: Figma's empty screen (#121212) with scanlines */
  .radio-tv__ghost {
    position: absolute;
    left: 6.25%;
    top: 2%;
    width: 87.25%;
    height: 84.3%;
    visibility: hidden;
    pointer-events: none;
    background:
      repeating-linear-gradient(to bottom, rgb(0 0 0 / 0.45) 0 1px, transparent 1px 3px),
      #121212;
  }
  .radio-tv__ghost.is-in {
    visibility: visible;
  }

  /* ── Player bar: Figma "player nav" 504×80, black, radius 2 (sizes in --u) ── */
  .radio-tv__bar {
    --u: var(--px);
    position: absolute;
    z-index: 3;
    width: calc(504 * var(--u));
    height: calc(80 * var(--u));
    background: var(--color-black);
    border-radius: var(--radius-ui);
    color: var(--color-white);
  }
  .radio-tv__btn {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    padding: 0;
    color: inherit;
    background: none;
    border: 0;
    border-radius: var(--radius-ui);
    transform: translateY(-50%);
    cursor: pointer;
  }
  .radio-tv__btn svg {
    width: 100%;
    height: 100%;
  }
  /* prev 32 · 14.4 · play 60 · 14.4 · next 32, starting at 1.6 */
  .radio-tv__btn--prev,
  .radio-tv__btn--next {
    width: calc(32 * var(--u));
    height: calc(32 * var(--u));
  }
  .radio-tv__btn--prev {
    left: calc(1.6 * var(--u));
  }
  .radio-tv__btn--play {
    left: calc(48 * var(--u));
    width: calc(60 * var(--u));
    height: calc(60 * var(--u));
  }
  .radio-tv__btn--next {
    left: calc(122.4 * var(--u));
  }
  /* Sound at the end of the bar, as far from the line as next is from play */
  .radio-tv__btn--sound {
    right: calc(20 * var(--u));
    width: calc(32 * var(--u));
    height: calc(32 * var(--u));
  }
  .radio-tv__icon-sound,
  .radio-tv.is-sound .radio-tv__icon-muted {
    display: none;
  }
  .radio-tv.is-sound .radio-tv__icon-sound {
    display: inline;
  }
  .radio-tv__btn:hover,
  .radio-tv__btn:focus-visible {
    color: var(--color-orange);
  }
  .radio-tv__icon-pause,
  .radio-tv.is-playing .radio-tv__icon-play {
    display: none;
  }
  .radio-tv.is-playing .radio-tv__icon-pause {
    display: block;
  }
  /* Progress: Figma's line (166 at 172, white 20%) with the 1×9 playhead; seekable */
  .radio-tv__seek {
    position: absolute;
    left: calc(169 * var(--u));
    top: 50%;
    width: calc(169 * var(--u));
    height: calc(24 * var(--u));
    margin: 0;
    transform: translateY(-50%);
    --p: 0;
    appearance: none;
    /* played part solid white, the rest Figma's 20% line */
    background:
      linear-gradient(var(--color-white), var(--color-white)) no-repeat left center / calc(var(--p) * 100%) 1px,
      linear-gradient(rgb(255 255 255 / 0.2), rgb(255 255 255 / 0.2)) no-repeat center / 100% 1px;
    cursor: pointer;
  }
  .radio-tv__seek::-webkit-slider-thumb {
    appearance: none;
    width: 3px;
    height: calc(9 * var(--u));
    background: linear-gradient(var(--color-white), var(--color-white)) no-repeat center / 1px 100%;
    border: 0;
  }
  .radio-tv__seek::-moz-range-thumb {
    width: 3px;
    height: calc(9 * var(--u));
    background: linear-gradient(var(--color-white), var(--color-white)) no-repeat center / 1px 100%;
    border: 0;
    border-radius: 0;
  }
  .radio-tv__seek:focus-visible {
    outline: 1px solid var(--color-orange);
    outline-offset: 2px;
  }

  /* ── Mobile: a 4:5 crop of the poster; the player bar across the bottom ── */
  @media (max-width: 1023px) {
    .radio-tv {
      aspect-ratio: 4 / 5 !important;
    }
    .radio-tv__bar {
      --u: calc((100vw - 2 * var(--page-margin)) / 504);
      left: var(--page-margin) !important;
      top: auto !important;
      bottom: var(--space-24);
    }
    /* The small buttons get a 44px tap area */
    .radio-tv__btn::after {
      content: '';
      position: absolute;
      left: 50%;
      top: 50%;
      width: max(100%, 44px);
      height: max(100%, 44px);
      transform: translate(-50%, -50%);
    }
    /* The 4:5 crop shows the middle of the screen edge to edge */
    .radio-tv__ghost,
    .radio-tv__screen {
      left: 0;
      width: 100%;
    }
  }
</style>
