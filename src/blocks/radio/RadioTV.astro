---
/**
 * Robo Radio — TV player
 * Figma: Robo Radio "1 hero" (10105:275, 1730×983) and Episode player (10105:2825, 1730×872)
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10105-275
 * Marked "3d web gl": the CRT screen, shaders and robot are a static poster for now.
 * Player controls are drawn from Figma; they get wired to the video in the motion step.
 */
import { Image } from 'astro:assets';
import WebGLSlot from '../../components/ui/WebGLSlot.astro';
import hero from '../../assets/radio/tv-hero.png';
import episode from '../../assets/radio/tv-episode.png';

interface Props {
  variant?: 'hero' | 'episode';
}
const { variant = 'hero' } = Astro.props;
const poster = variant === 'hero' ? hero : episode;
const h = variant === 'hero' ? 983 : 872;
// Controls: hero (100, 843) · episode (105, 759)
const controls = variant === 'hero' ? { x: 100, y: 843 } : { x: 105, y: 759 };
---
<section class:list={['radio-tv', `radio-tv--${variant}`]} style={`aspect-ratio: 1730 / ${h}`} aria-label="Robo Radio player">
  <WebGLSlot name="radio-tv" class="radio-tv__scene">
    <Image src={poster} alt="" widths={[1730, 3460]} sizes="100vw" loading={variant === 'hero' ? 'eager' : 'lazy'} />
  </WebGLSlot>
  <div class="radio-tv__controls" style={`left:${(controls.x / 1730) * 100}%;top:${(controls.y / h) * 100}%`}>
    <img src="/images/radio/player-controls.svg" alt="" width="510" height="80" />
  </div>
</section>

<style>
  .radio-tv {
    position: relative;
    background: var(--color-black);
    overflow: hidden;
  }
  .radio-tv :global(.radio-tv__scene) {
    position: absolute;
    inset: 0;
  }
  .radio-tv :global(.radio-tv__scene img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .radio-tv__controls {
    position: absolute;
    width: calc(510 / 1730 * 100%);
  }
  .radio-tv__controls img {
    width: 100%;
    height: auto;
  }

  /* ── Mobile: a 4:5 crop of the poster; controls across the bottom ── */
  @media (max-width: 767px) {
    .radio-tv {
      aspect-ratio: 4 / 5 !important;
    }
    .radio-tv__controls {
      left: var(--page-margin) !important;
      top: auto !important;
      bottom: var(--space-24);
      width: calc(100% - 2 * var(--page-margin));
    }
  }
</style>
