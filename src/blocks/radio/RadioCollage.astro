---
/**
 * Robo Radio — Poster collage ("One talk. One future")
 * Figma: "collage" (10105:481), 1730×2826, black
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10105-481
 * 3×3 grid of posters (2× exports) and stamps. TODO (CMS): posters from episodes.
 */
import { Image } from 'astro:assets';
import snell from '../../assets/radio/poster-jason-snell.png';
import ringley from '../../assets/radio/poster-brian-ringley.png';
import kline from '../../assets/radio/poster-jason-kline.png';
import piccinno from '../../assets/radio/poster-andrea-piccinno.png';
import otalora from '../../assets/radio/poster-alejandro-otalora.png';
import schneider from '../../assets/radio/poster-michael-schneider.png';

const cells = [
  { poster: snell, alt: 'Poster — Jason J. Snell' },
  { poster: ringley, alt: 'Robo Radio 12 poster — Brian Ringley' },
  { stamp: '/images/home/stamp-radio-handmade.svg', w: 404, h: 222 },
  { stamp: '/images/home/stamp-radio-yes.svg', w: 290, h: 111 },
  { poster: kline, alt: 'Robo Radio 10 poster — Jason Kline' },
  { poster: piccinno, alt: 'Poster — Andrea Piccinno' },
  { poster: otalora, alt: 'Robo Radio 14 poster — Alejandro Otalora' },
  { stamp: '/images/radio/stamp-departure.png', w: 126, h: 82 },
  { poster: schneider, alt: 'Robo Radio 8 poster — Michael Schneider' },
];
---
<section class="radio-collage theme-dark">
  <header class="radio-collage__head container">
    <h2 class="t-h1">One talk. One future</h2>
    <p class="radio-collage__intro t-body">When the microphones switch off, the ideas keep moving. Each poster is our way of carrying a conversation forward and giving one possible future a form.</p>
  </header>
  <ul class="radio-collage__grid container">
    {cells.map((c) => (
      <li class="radio-collage__cell">
        {c.poster ? (
          <Image src={c.poster} alt={c.alt} widths={[541, 1080]} sizes="(min-width: 1728px) 541px, 31vw" loading="lazy" />
        ) : (
          <img class="radio-collage__stamp" src={c.stamp} alt="" width={c.w} height={c.h} style={`--w: ${c.w}; width: calc(${c.w} / 541 * 100%)`} loading="lazy" />
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .radio-collage {
    padding-top: calc(160 * var(--px));
    padding-bottom: var(--space-40);
  }
  .radio-collage__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-40);
    text-align: center;
  }
  .radio-collage__intro {
    width: calc(553 * var(--px));
    max-width: 100%;
  }
  .radio-collage__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: calc(12 * var(--px));
    margin-top: var(--space-80);
  }
  .radio-collage__cell {
    aspect-ratio: 541 / 765;
    display: grid;
    place-items: center;
  }
  .radio-collage__cell :global(img:not(.radio-collage__stamp)) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .radio-collage__stamp {
    height: auto;
  }

  /* ── Mobile: two columns ── */
  @media (max-width: 767px) {
    .radio-collage {
      padding-top: 164px;
    }
    .radio-collage__head {
      gap: var(--space-24);
    }
    .radio-collage__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 64px;
    }
    /* A row of two stamps collapses to the stamps' height */
    .radio-collage__cell:has(.radio-collage__stamp) {
      aspect-ratio: auto;
      padding-block: 40px;
    }
  }
</style>
