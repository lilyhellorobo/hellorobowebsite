---
/**
 * Robo Radio — Poster collage ("One talk. One future")
 * Figma: "collage" (10105:481), 1730×2826, black
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10105-481
 * 3×3 grid: the six featured episodes' covers (CMS "Featured", in list order), each linking
 * to its episode, with stamps in the remaining cells.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const featured = (await getCollection('episodes', (e) => e.data.featured && e.data.cover))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

// Poster slots are filled in order; stamps keep their place in the Figma layout
// x / y: where Figma puts the stamp inside its 541×765 cell (desktop); none = centred
const stamps: Record<number, { src: string; w: number; h: number; x?: number; y?: number }> = {
  2: { src: '/images/home/stamp-radio-handmade.svg', w: 404, h: 222, x: 78, y: 272 },
  3: { src: '/images/home/stamp-radio-yes-on-dark.svg', w: 290, h: 111, x: 117, y: 328 },
  7: { src: '/images/radio/stamp-departure.png', w: 126, h: 82 },
};
const posters = [...featured];
const cells: ({ stamp: (typeof stamps)[number] } | { episode: (typeof featured)[number] })[] = [];
for (let i = 0; posters.length; i++) {
  cells.push(stamps[i] ? { stamp: stamps[i] } : { episode: posters.shift()! });
}
---
<section class="radio-collage theme-dark">
  <header class="radio-collage__head container">
    <h2 class="t-h1">One talk. One future</h2>
    <p class="radio-collage__intro t-body">When the microphones switch off, the ideas keep moving. Each poster is our way of carrying a conversation forward and giving one possible future a form.</p>
  </header>
  <ul class="radio-collage__grid container">
    {cells.map((c) => (
      <li class="radio-collage__cell">
        {'episode' in c ? (
          <a class="radio-collage__poster" href={`/robo-radio/${c.episode.id}`}>
            <Image src={c.episode.data.cover!} alt={`${c.episode.data.title} poster`} widths={[541, 1080]} sizes="(min-width: 1728px) 541px, 31vw" loading="lazy" />
          </a>
        ) : (
          <img class:list={['radio-collage__stamp', { 'radio-collage__stamp--placed': c.stamp.x !== undefined }]} src={c.stamp.src} alt="" width={c.stamp.w} height={c.stamp.h} style={`--w: ${c.stamp.w}; --sx: ${c.stamp.x ?? 0}; --sy: ${c.stamp.y ?? 0}; width: calc(${c.stamp.w} / 541 * 100%)`} loading="lazy" />
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .radio-collage {
    padding-top: calc(160 * var(--px));
    padding-bottom: var(--space-40);
  }
  .radio-collage__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-40);
    text-align: center;
  }
  .radio-collage__intro {
    width: calc(553 * var(--px));
    max-width: 100%;
  }
  .radio-collage__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: calc(12 * var(--px));
    margin-top: var(--space-80);
  }
  .radio-collage__cell {
    aspect-ratio: 541 / 765;
    display: grid;
    place-items: center;
  }
  .radio-collage__poster {
    display: block;
    width: 100%;
    height: 100%;
  }
  .radio-collage__poster :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .radio-collage__stamp {
    height: auto;
  }
  /* Desktop: the stamp where Figma has it in its cell (margins in % of the cell width) */
  @media (min-width: 1024px) {
    .radio-collage__stamp--placed {
      place-self: start;
      margin: calc(var(--sy) / 541 * 100%) 0 0 calc(var(--sx) / 541 * 100%);
    }
  }

  /* ── Mobile: two columns ── */
  @media (max-width: 1023px) {
    .radio-collage {
      padding-top: 164px;
    }
    .radio-collage__head {
      gap: var(--space-24);
    }
    .radio-collage__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 64px;
    }
    /* A row of two stamps collapses to the stamps' height */
    .radio-collage__cell:has(.radio-collage__stamp) {
      aspect-ratio: auto;
      padding-block: 40px;
    }
  }
</style>
