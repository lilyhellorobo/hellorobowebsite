---
/**
 * Robo Radio — Guests
 * Figma: "guests" (10105:1064), 1730×1091, black
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10105-1064
 */
---
<section class="radio-guests theme-dark">
  <div class="container">
    <p class="t-body">Guests</p>
    <h2 class="radio-guests__title t-h1">Where good conversations begin</h2>
    <img class="radio-guests__logos only-desktop" src="/images/radio/logos-guests.svg" alt="Humanoid, robot.com, Boston Dynamics, VolvoxLabs" width="1644" style="--w: 1644" height="374" loading="lazy" />
    <!-- Phones: the six 264-wide tiles of the row as a 2-column grid -->
    <ul class="radio-guests__grid only-mobile" aria-label="Humanoid, robot.com, Boston Dynamics, VolvoxLabs">
      {[0, 1, 2, 3, 4, 5].map((i) => (
        <li class="radio-guests__cell" style={`--i: ${i}`} aria-hidden="true">
          <img src="/images/radio/logos-guests.svg" alt="" width="1644" height="374" loading="lazy" />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .radio-guests {
    padding-top: calc(99 * var(--px));
    padding-bottom: calc(42 * var(--px));
  }
  .radio-guests__title {
    width: calc(766 * var(--px));
    max-width: 100%;
    margin-top: calc(30 * var(--px));
  }
  .radio-guests__logos {
    width: calc(1644 / 1648 * 100%);
    height: auto;
    margin-top: calc(180 * var(--px));
  }

  /* ── Mobile: the logo tiles in two columns (as on Services) ── */
  @media (max-width: 1023px) {
    .radio-guests {
      padding-top: 164px;
      padding-bottom: 64px;
    }
    /* Mobile/H1, but never wider than the screen: "conversations" is one long word */
    .radio-guests__title {
      margin-top: var(--space-24);
      font-size: min(var(--type-h1-size-mobile), 15vw);
    }
    .radio-guests__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 64px;
    }
    .radio-guests__cell {
      position: relative;
      aspect-ratio: 264 / 374;
      overflow: hidden;
    }
    /* the whole row, scaled so one tile fills the cell, shifted to tile --i (276 apart) */
    .radio-guests__cell img {
      position: absolute;
      top: 0;
      left: calc(var(--i) * -276 / 264 * 100%);
      width: calc(1644 / 264 * 100%);
      max-width: none;
      height: 100%;
    }
  }
</style>
