---
/**
 * Robo Radio — All of the episodes
 * Figma: "all episodes" (10105:985), 1730×2694, black
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10105-985
 * Rows from the episodes collection (listed: true), newest first. As in Figma (e.g. the
 * Sanketh Yayathi / Alvin Groen rows, 10105:1633) the row title is the guest's name — one
 * line at H2 — and the line under it is what they do; the CMS title ("Robo Radio 14: …")
 * is used on the episode page. The first INITIAL rows
 * show; "Load more" reveals STEP more per click and disappears when all are shown.
 * Without JavaScript every row shows and the button stays hidden.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Button from '../../components/ui/Button.astro';

const episodes = (await getCollection('episodes', (e) => e.data.listed)).sort((a, b) => a.data.order - b.data.order);
const INITIAL = 6;
const STEP = 2;
---
<section class="radio-episodes theme-dark">
  <div class="container">
    <p class="t-body">All of the episodes</p>
    <ul class="radio-episodes__list" id="radio-episode-list" data-episodes data-initial={INITIAL} data-step={STEP}>
      {episodes.map((e) => (
        <li class="radio-episodes__row">
          <div class="radio-episodes__text">
            <h3 class="t-h2">{e.data.guest}</h3>
            <p class="radio-episodes__line t-body">{e.data.guestTitle}</p>
            <Button href={`/robo-radio/${e.id}`} variant="light" icon="arrow">Watch</Button>
          </div>
          <div class="radio-episodes__cover">
            {e.data.cover && <Image src={e.data.cover} alt="" widths={[680, 1360]} sizes="(min-width: 1728px) 680px, 40vw" loading="lazy" />}
          </div>
        </li>
      ))}
    </ul>
    {episodes.length > INITIAL && (
      <div class="radio-episodes__more" hidden data-load-more>
        <Button variant="light" icon="hex" aria-controls="radio-episode-list">Load more</Button>
      </div>
    )}
  </div>
</section>

<script>
  // Load more: hide rows past the first INITIAL, reveal STEP per click
  for (const list of document.querySelectorAll<HTMLElement>('[data-episodes]')) {
    const more = list.parentElement?.querySelector<HTMLElement>('[data-load-more]');
    const button = more?.querySelector('button');
    const rows = [...list.children] as HTMLElement[];
    const step = Number(list.dataset.step) || 2;
    let shown = Number(list.dataset.initial) || rows.length;
    if (!more || !button || rows.length <= shown) continue;
    const render = () => {
      rows.forEach((row, i) => (row.hidden = i >= shown));
      more.hidden = shown >= rows.length;
    };
    button.addEventListener('click', () => {
      const first = shown;
      shown = Math.min(rows.length, shown + step);
      render();
      // move focus to the first new episode so keyboard users land on it
      rows[first]?.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
      rows[first]?.classList.add('is-revealed');
    });
    render();
  }
</script>

<style>
  .radio-episodes {
    padding-top: calc(180 * var(--px));
  }
  .radio-episodes__list {
    margin-top: var(--space-40);
  }
  /* Rule above each row, calc(40 * var(--px)) around it; no rule after the last row */
  .radio-episodes__row {
    display: grid;
    grid-template-columns: calc(680 * var(--px)) 1fr calc(680 * var(--px));
    padding-top: var(--space-40);
    padding-bottom: var(--space-40);
    border-top: var(--line-width) solid var(--line-on-dark);
  }
  .radio-episodes__row:last-child {
    padding-bottom: 0;
  }
  .radio-episodes__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  /* Figma: title, 20, line (457 wide); the Watch button sits on the row's bottom edge
     (178 below the text in Figma) and never closer than 40 if the text runs long */
  .radio-episodes__line {
    width: calc(457 * var(--px));
    max-width: 100%;
    margin-top: var(--space-20);
    margin-bottom: var(--space-40);
  }
  .radio-episodes__text :global(.button) {
    margin-top: auto;
  }
  .radio-episodes__cover {
    grid-column: 3;
    aspect-ratio: 680 / 382;
    background: var(--color-ink);
    overflow: hidden;
  }
  .radio-episodes__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .radio-episodes__more {
    display: flex;
    justify-content: center;
    margin-top: calc(120 * var(--px));
  }

  /* ── Mobile: cover on top of each row, then title, line and button ── */
  @media (max-width: 767px) {
    .radio-episodes {
      padding-top: 164px;
    }
    .radio-episodes__row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-24);
    }
    .radio-episodes__cover {
      grid-column: auto;
      order: -1;
    }
    .radio-episodes__line {
      margin-top: var(--space-12);
    }
    .radio-episodes__text :global(.button) {
      align-self: stretch;
      margin-top: var(--space-24);
    }
    .radio-episodes__more {
      margin-top: 64px;
    }
    .radio-episodes__more :global(.button) {
      flex: 1;
    }
  }
  /* Rows / button hidden by Load more (their display rules would otherwise win over [hidden]) */
  .radio-episodes__row[hidden],
  .radio-episodes__more[hidden] {
    display: none;
  }
  /* Newly loaded rows fade up (placeholder for the motion step) */
  .radio-episodes__row.is-revealed,
  .radio-episodes__row.is-revealed ~ .radio-episodes__row {
    animation: radio-reveal 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes radio-reveal {
    from {
      opacity: 0;
      transform: translateY(calc(24 * var(--px)));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .radio-episodes__row.is-revealed,
    .radio-episodes__row.is-revealed ~ .radio-episodes__row {
      animation: none;
    }
  }
</style>
