---
/**
 * Episode — Hero
 * Figma: "Frame 2147232960" (10105:2720), 1728×1002, black
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10105-2720
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  episode: CollectionEntry<'episodes'>;
}
const { data } = Astro.props.episode;
const art = data.poster ?? data.cover;
---
<section class="episode-hero theme-dark container">
  <div class="episode-hero__text">
    <h1 class="episode-hero__title t-h1">{data.title}</h1>
    <p class="episode-hero__guest t-body">{data.guest}, {data.guestTitle}</p>
    <img class="episode-hero__badge" src="/images/radio/badge-episode.svg" alt="" width="210" style="--w: 210" height="212" />
  </div>
  <div class="episode-hero__poster">
    {art && <Image src={art} alt={`${data.title} poster`} widths={[680, 1360]} sizes="(min-width: 1728px) 680px, 40vw" loading="eager" />}
  </div>
</section>

<style>
  /* The hero fits the screen: the poster is as tall as the window allows (40 above and
     below), never wider than Figma's 680, so it never runs past the bottom */
  .episode-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--gutter);
    padding-top: var(--space-40);
    padding-bottom: var(--space-40);
  }
  .episode-hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .episode-hero__title {
    width: calc(956 * var(--px));
    max-width: 100%;
  }
  .episode-hero__guest {
    width: calc(553 * var(--px));
    max-width: 100%;
    margin-top: calc(30 * var(--px));
  }
  .episode-hero__badge {
    margin-top: auto;
  }
  .episode-hero__poster {
    height: min(calc(962 * var(--px)), calc(100svh - 2 * var(--space-40)));
    aspect-ratio: 680 / 962;
    background: var(--color-ink);
    overflow: hidden;
  }
  .episode-hero__poster :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Mobile: text, then the poster full width ── */
  @media (max-width: 1023px) {
    .episode-hero {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-40);
      padding-top: var(--space-20);
      padding-bottom: 0;
    }
    .episode-hero__poster {
      height: auto;
    }
    .episode-hero__guest {
      margin-top: var(--space-24);
    }
    .episode-hero__badge {
      width: 105px;
      height: auto;
      margin-top: 64px;
    }
  }
</style>
