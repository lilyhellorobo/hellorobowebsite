---
/**
 * Position — Hero
 * Figma: "Frame 2147232976" (10102:146), 1728×881
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10102-146
 * Each position gets its own pair from the micrographics pack (Figma "micrographics",
 * 10093:2523): a composition in the black panel and a sticker above the title. The picks
 * are shuffled once and handed out in Careers order, so neighbours never match.
 * - Composition: at its Figma size (1×) in the 818×803 panel, centred — like the globe
 *   in Figma's Content Creator page.
 * - Sticker: in Figma's 174×100 spot, at its own proportions, scaled to the same area so
 *   every sticker weighs about the same.
 */
interface Props {
  title: string;
  /** the position's place in the Careers list (0 = first) */
  index: number;
}
const { title, index } = Astro.props;

const M = '/images/careers/micro/';
// [file, width, height] at 1× (the PNGs are 2×)
const ARTS = [
  [`${M}art-globe.png`, 497, 293],
  [`${M}art-human-core.png`, 548, 236],
  [`${M}art-cross.png`, 561, 561],
  [`${M}art-yes.png`, 592, 261],
  [`${M}art-planet.png`, 221, 268],
  [`${M}art-hp.png`, 457, 457],
  [`${M}art-cyrillic.png`, 772, 442],
] as const;
const STICKERS = [
  ['/images/careers/stamp-position.svg', 174, 100],
  [`${M}sticker-28.png`, 287, 170],
  [`${M}sticker-departure.png`, 301, 211],
  [`${M}sticker-30.png`, 308, 178],
  [`${M}sticker-27.png`, 208, 200],
  [`${M}sticker-25.png`, 304, 176],
] as const;
const [artSrc, artW, artH] = ARTS[index % ARTS.length];
const [stickerSrc, sw, sh] = STICKERS[index % STICKERS.length];
const AREA = 174 * 100;
const stickerW = Math.round(Math.sqrt((AREA * sw) / sh));
const stickerH = Math.round((stickerW * sh) / sw);
---
<section class="position-hero container">
  <div class="position-hero__art">
    <img src={artSrc} alt="" width={artW} height={artH} style={`--aw: ${artW}`} />
  </div>
  <div class="position-hero__side">
    <img class="position-hero__sticker" src={stickerSrc} alt="" width={stickerW} height={stickerH} style={`--w: ${stickerW}`} />
    <h1 class="position-hero__title t-h1">{title}</h1>
  </div>
</section>

<style>
  .position-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter);
    padding-top: var(--space-40);
    padding-bottom: calc(38 * var(--px));
  }
  .position-hero__art {
    display: grid;
    place-items: center;
    aspect-ratio: 818 / 803;
    background: var(--color-black);
  }
  .position-hero__art img {
    width: calc(var(--aw) / 818 * 100%);
    height: auto;
  }
  .position-hero__side {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
  }
  .position-hero__title {
    width: calc(673 * var(--px));
    max-width: 100%;
  }

  /* ── Mobile: stamp + title first, illustration below ── */
  @media (max-width: 1023px) {
    .position-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 64px;
      padding-top: var(--space-20);
    }
    .position-hero__side {
      order: -1;
      gap: var(--space-24);
    }
    .position-hero__side img {
      width: calc(var(--w) * 116 / 174 * 1px);
      height: auto;
    }
  }
</style>
