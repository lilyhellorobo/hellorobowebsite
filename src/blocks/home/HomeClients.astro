---
/**
 * Home — Clients
 * Figma: "Frame 2147232804" (10093:577), 1728×1481
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10093-577
 * Logo tiles and stamps are scattered on the right; positions are taken
 * from the 1728 frame and expressed as % so they scale with the page.
 * Mobile: two rows of logo tiles at 1.5× Figma's 123×69, bleeding off both edges; while
 * the block crosses the screen the rows drift sideways in opposite directions.
 * The logos come from the CMS (Home page › Client logos) and fill the 8 places in order:
 * an SVG is a whole tile with its own background, a PNG / WebP logo sits on a light tile.
 */
import { getCollection } from 'astro:content';

// The 8 places for logo tiles: x, y in the 1728×1481 frame
const places = [
  { x: 1286, y: -10 },
  { x: 1563, y: 168 },
  { x: 1287, y: 357 },
  { x: 1011, y: 535 },
  { x: 732, y: 724 },
  { x: 1287, y: 724 },
  { x: 1011, y: 902 },
  { x: 732, y: 1091 },
];
// mobileScale: logos that fill more of their tile than the rest are drawn smaller in the
// cropped phone tiles, to match the others
const clients = (await getCollection('home'))[0]?.data.clients ?? [];
const tiles = clients.slice(0, places.length).map((c, i) => ({
  name: c.name,
  src: c.logo,
  ...places[i],
  mobileScale: c.mobileScale !== 1 ? c.mobileScale : undefined,
  raster: !/\.svg$/i.test(c.logo),
}));
const stamps = [
  { src: '/images/home/stamp-human-department.svg', x: 1003, y: 226, w: 292, h: 292 },
  { src: '/images/home/stamp-human-approved.svg', x: 1526, y: 525, w: 388, h: 651 },
];
const pct = (v: number, of: number) => `${(v / of) * 100}%`;
---
<section class="home-clients">
  <div class="home-clients__text container">
    <img class="home-clients__stamp-text" src="/images/home/stamp-clients.svg" alt="" width="306" style="--w: 306" height="76" loading="lazy" />
    <p class="home-clients__label t-body">Clients</p>
    <h2 class="home-clients__title t-h3">
      And we are doing it together with visionary founders who are ready for the world to adopt their robots. And they chose to do it with Hello Robo.
    </h2>
  </div>

  <ul class="home-clients__wall" aria-label="Clients" data-clients-wall>
    {tiles.map((t) => (
      <li
        class="home-clients__tile"
        style={`left:${pct(t.x, 1728)};top:${pct(t.y, 1481)}${t.mobileScale ? `;--logo-scale:${t.mobileScale}` : ''}`}
      >
        {t.raster ? (
          <img class="home-clients__logo-raster" src={t.src} alt={t.name} width="165" style="--w: 165" height="22" loading="lazy" />
        ) : (
          <img src={t.src} alt={t.name} width="264" style="--w: 264" height="355" loading="lazy" />
        )}
      </li>
    ))}
    {stamps.map((s) => (
      <li
        class="home-clients__stamp"
        aria-hidden="true"
        style={`left:${pct(s.x, 1728)};top:${pct(s.y, 1481)};width:${pct(s.w, 1728)}`}
      >
        <img src={s.src} alt="" width={s.w} style={`--w: ${s.w}`} height={s.h} loading="lazy" />
      </li>
    ))}
  </ul>
</section>

<script>
  // Scroll drift for the mobile logo rows: --shift goes from +1 to -1 as the wall
  // crosses the screen (the CSS turns it into px and only uses it on phones)
  const wall = document.querySelector<HTMLElement>('[data-clients-wall]');
  if (wall && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const r = wall.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight + r.height)));
      wall.style.setProperty('--shift', (1 - 2 * p).toFixed(4));
    };
    const request = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request);
    update();
  }
</script>

<style>
  .home-clients {
    position: relative;
    aspect-ratio: 1728 / 1481;
    /* hidden first: iOS before 16 has no `clip` and would widen the page */
    overflow-x: hidden;
    overflow-x: clip;
  }
  .home-clients__text {
    position: relative;
    z-index: var(--z-raised);
    padding-top: calc(191 * var(--px));
  }
  /* The SVG includes 13/calc(8 * var(--px)) of stroke overflow around the 280×60 stamp */
  .home-clients__stamp-text {
    margin: calc(-8 * var(--px)) calc(-13 * var(--px));
  }
  .home-clients__label {
    margin-top: calc(32 * var(--px));
  }
  .home-clients__title {
    width: calc(835 * var(--px));
    max-width: 50%;
    margin-top: calc(32 * var(--px));
  }
  .home-clients__wall {
    position: absolute;
    inset: 0;
  }
  .home-clients__tile,
  .home-clients__stamp {
    position: absolute;
  }
  .home-clients__tile {
    width: calc(264 / 1728 * 100%);
    aspect-ratio: 264 / 355;
    display: grid;
    place-items: center;
  }
  .home-clients__tile img {
    width: 100%;
    height: 100%;
  }
  /* The SVG tiles include their own light background; the PNG one doesn't */
  .home-clients__tile:has(.home-clients__logo-raster) {
    background: rgb(0 0 0 / 0.02);
  }
  .home-clients__tile .home-clients__logo-raster {
    width: calc(165 / 264 * 100%);
    height: auto;
  }
  .home-clients__stamp img {
    width: 100%;
    height: auto;
  }

  /* ── Mobile: Figma 10098:4018 — text, then two rows of 123×69 logo tiles bleeding off both edges ── */
  @media (max-width: 1023px) {
    .home-clients {
      aspect-ratio: auto;
      padding-bottom: 189px;
    }
    .home-clients__text {
      padding-top: 188px;
    }
    /* Stamp 205×44 → the SVG (with its stroke overflow) at 224 */
    .home-clients__stamp-text {
      width: 224px;
      height: auto;
      margin: -6px -10px;
    }
    .home-clients__label {
      margin-top: 44px;
    }
    .home-clients__title {
      width: auto;
      max-width: none;
      margin-top: var(--space-24);
    }
    /* Tiles 1.5× Figma's 123×69 → 185×104; row 2 sits half a tile to the left of row 1 */
    .home-clients__wall {
      --tile: 185px;
      --shift: 0;
      position: relative;
      inset: auto;
      display: grid;
      grid-template-columns: repeat(4, var(--tile));
      grid-auto-rows: 104px;
      gap: 8px;
      width: max-content;
      margin: 64px 0 0 calc(50% - 2 * var(--tile) - 12px);
    }
    .home-clients__tile {
      position: relative;
      left: auto !important;
      top: auto !important;
      width: var(--tile);
      aspect-ratio: auto;
      overflow: hidden;
      transform: translateX(calc(var(--tile) / 4 + var(--shift) * 40px));
    }
    .home-clients__tile img:not(.home-clients__logo-raster) {
      position: absolute;
      inset: 0;
      object-fit: cover;
      scale: var(--logo-scale, 1);
    }
    /* A shrunk logo leaves the tile's edges bare: a wide outline in the SVGs' own 2% grey
       fills them right up to the image edge without overlapping it (no visible inner box);
       the tile clips it */
    .home-clients__tile[style*='--logo-scale'] img {
      outline: 200px solid rgb(0 0 0 / 0.02);
    }
    .home-clients__tile:nth-child(n + 5) {
      transform: translateX(calc(var(--tile) / -4 - var(--shift) * 40px));
    }
    .home-clients__stamp {
      display: none;
    }
  }
</style>
