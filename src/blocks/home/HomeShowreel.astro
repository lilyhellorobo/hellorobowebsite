---
/**
 * Home — Showreel
 * Figma: "3 video" (10093:183), 1728×1005 — a 1648×925 video area
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10093-183
 * Plays public/videos/showreel.mp4 (muted, looping). Drop the file in and it appears.
 * Desktop: the block pins while you scroll and the video opens up from its Figma size
 * (page margins, 1648×925) to the full screen — the video fills the screen underneath and a
 * clip around it widens, so nothing is resized frame by frame. Phones: full-bleed as before.
 */
import fs from 'node:fs';
import VideoSlot from '../../components/ui/VideoSlot.astro';

const has = (f: string) => fs.existsSync(`public/videos/${f}`);
const src = has('showreel.mp4') ? '/videos/showreel.mp4' : undefined;
const webm = has('showreel.webm') ? '/videos/showreel.webm' : undefined;
const poster = has('showreel-poster.jpg') ? '/videos/showreel-poster.jpg' : undefined;
---
<section class="home-showreel" aria-label="Showreel" data-showreel>
  <div class="home-showreel__stage">
    <div class="home-showreel__frame container">
      <VideoSlot class="home-showreel__video" ratio="1648 / 925" mobileRatio="390 / 694" src={src} webm={webm} poster={poster} autoplay />
    </div>
  </div>
</section>

<script>
  // Scroll progress through the pinned part → --p (0 = Figma size, 1 = full screen)
  for (const block of document.querySelectorAll<HTMLElement>('[data-showreel]')) {
    const wide = matchMedia('(min-width: 1024px) and (prefers-reduced-motion: no-preference)');
    let frame = 0;
    const update = () => {
      frame = 0;
      if (!wide.matches) return block.style.removeProperty('--p');
      const r = block.getBoundingClientRect();
      // fully open after 80% of a screen of scrolling; the rest of the pin holds it
      const p = Math.min(1, Math.max(0, -r.top / (innerHeight * 0.8)));
      block.style.setProperty('--p', p.toFixed(4));
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    wide.addEventListener('change', schedule);
    update();
  }
</script>

<style>
  .home-showreel {
    padding-bottom: var(--space-80);
  }

  /* ── Desktop: pinned; the clip opens from the Figma frame to the full screen ── */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .home-showreel {
      --p: 0;
      /* eased progress */
      --e: calc(1 - (1 - var(--p)) * (1 - var(--p)) * (1 - var(--p)));
      /* the Figma frame: page margins at the sides, 1648×925 in shape, centred */
      --ix: var(--page-margin);
      --iy: max(0px, calc((100vh - (100vw - 2 * var(--page-margin)) * 925 / 1648) / 2));
      height: 220vh;
      padding-bottom: 0;
    }
    .home-showreel__stage {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }
    .home-showreel__frame {
      position: absolute;
      inset: 0;
      max-width: none;
      padding: 0;
      clip-path: inset(calc((1 - var(--e)) * var(--iy)) calc((1 - var(--e)) * var(--ix)));
    }
    .home-showreel__frame :global(.home-showreel__video) {
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
    }
  }

  /* Mobile: full-bleed 390×694, the video is cropped to the centre */
  @media (max-width: 1023px) {
    .home-showreel {
      padding: 0;
    }
    .home-showreel__frame {
      padding: 0;
    }
  }
</style>
