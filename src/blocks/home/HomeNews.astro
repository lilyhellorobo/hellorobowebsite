---
/**
 * Home — Latest news
 * Figma: "Frame 2147232796" (10093:1889), 1728×1531
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10093-1889
 * Cards come from the news collection (CMS "Updates"). The row runs off the right
 * edge and scrolls sideways: trackpad / shift + wheel, arrow keys when focused, and
 * click-and-drag with a mouse. Cards snap to the page margin. Every card is the same size
 * (the narrow one, 537 × 610 in Figma), whatever size the CMS gives it; no View links.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const news = (await getCollection('news')).sort((a, b) => a.data.order - b.data.order);
---
<section class="home-news">
  <header class="home-news__head container">
    <img src="/images/home/stamp-news.svg" alt="" width="230" style="--w: 230" height="132" loading="lazy" />
    <h2 class="t-h1">Latest news</h2>
  </header>

  <ul class="home-news__row" tabindex="0" aria-label="Latest news — scroll sideways" data-drag-scroll>
    {news.map((item) => (
      <li class="home-news__card">
        <div class="home-news__media">
          <Image src={item.data.image} alt="" widths={[537, 1074]} sizes="537px" loading="lazy" />
        </div>
        <p class="home-news__text t-body t-body2-mobile">{item.data.text}</p>
      </li>
    ))}
  </ul>
</section>

<script>
  // Click-and-drag scrolling for mouse users (touch and trackpads scroll natively)
  for (const row of document.querySelectorAll<HTMLElement>('[data-drag-scroll]')) {
    let startX = 0;
    let startScroll = 0;
    let dragged = false;
    row.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      startX = e.clientX;
      startScroll = row.scrollLeft;
      dragged = false;
      row.classList.add('is-dragging');
      row.setPointerCapture(e.pointerId);
    });
    row.addEventListener('pointermove', (e) => {
      if (!row.hasPointerCapture(e.pointerId)) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 4) dragged = true;
      row.scrollLeft = startScroll - dx;
    });
    const end = (e: PointerEvent) => {
      if (row.hasPointerCapture(e.pointerId)) row.releasePointerCapture(e.pointerId);
      row.classList.remove('is-dragging');
    };
    row.addEventListener('pointerup', end);
    row.addEventListener('pointercancel', end);
    // A drag shouldn't open the card it ended on
    row.addEventListener('click', (e) => {
      if (dragged) {
        e.preventDefault();
        e.stopPropagation();
        dragged = false;
      }
    }, true);
    row.addEventListener('dragstart', (e) => e.preventDefault());
  }
</script>

<style>
  .home-news {
    padding-top: calc(120 * var(--px));
    padding-bottom: calc(166 * var(--px));
    /* hidden first: iOS before 16 has no `clip` and would widen the page */
    overflow-x: hidden;
    overflow-x: clip;
  }
  /* Stamp at x 40, title at x 312 (stamp 230 + 42) */
  .home-news__head {
    display: flex;
    align-items: flex-start;
    gap: calc(42 * var(--px));
  }
  /* Sideways scroller: starts at the page margin, snaps cards to it, no visible scrollbar */
  .home-news__row {
    display: flex;
    align-items: flex-start;
    gap: var(--gutter);
    margin-top: calc(104 * var(--px));
    padding-inline: var(--page-margin);
    overflow-x: auto;
    /* sideways only, never up and down */
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--page-margin);
    scrollbar-width: none;
    cursor: grab;
  }
  .home-news__row::-webkit-scrollbar {
    display: none;
  }
  .home-news__row.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }
  .home-news__row:focus-visible {
    outline-offset: calc(-4 * var(--px));
  }
  .home-news__card {
    flex: none;
    display: grid;
    justify-items: start;
    width: calc(537 * var(--px));
    scroll-snap-align: start;
  }
  .home-news__media {
    width: 100%;
    aspect-ratio: 537 / 610;
    background: var(--color-ink);
    overflow: hidden;
  }
  .home-news__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .home-news__text {
    margin-top: var(--space-20);
    max-width: calc(465 * var(--px));
  }

  /* ── Mobile: Figma 10098:1661 — stamp above the title; cards 276 / 184 wide in a sideways row ── */
  @media (max-width: 1023px) {
    .home-news {
      padding-top: 188px;
      padding-bottom: 175px;
    }
    .home-news__head {
      flex-direction: column;
      gap: 12px;
    }
    .home-news__head img {
      width: 120px;
      height: auto;
    }
    .home-news__row {
      margin-top: 64px;
    }
    /* 15% over Figma's 184, which read too small on a phone */
    .home-news__card {
      width: 212px;
    }
    .home-news__media {
      aspect-ratio: 184 / 208;
    }
    .home-news__text {
      margin-top: var(--space-12);
    }
  }
</style>
