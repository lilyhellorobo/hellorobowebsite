---
/**
 * Home — Robo Radio teaser
 * Figma: "block" (10093:1424), 1728×2122
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10093-1424
 * Posters: covers of the episodes marked "Displayed on homepage" in the CMS (up to 4, in list
 * order), each linking to its episode.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Button from '../../components/ui/Button.astro';

const episodes = (await getCollection('episodes', (e) => e.data.homepage && e.data.cover))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

// 3×2 grid in reading order; stamps sit in the two empty cells
const stamps: Record<number, { src: string; w: number; h: number }> = {
  2: { src: '/images/home/stamp-radio-handmade.svg', w: 404, h: 222 },
  3: { src: '/images/home/stamp-radio-yes.svg', w: 290, h: 111 },
};
const posters = [...episodes];
const cells: ({ stamp: (typeof stamps)[number] } | { episode: (typeof episodes)[number] })[] = [];
for (let i = 0; posters.length; i++) {
  cells.push(stamps[i] ? { stamp: stamps[i] } : { episode: posters.shift()! });
}
---
<section class="home-radio container">
  <div class="home-radio__head">
    <h2 class="home-radio__title t-h1">Robo Radio</h2>
    <div class="home-radio__intro">
      <p class="t-body">Community webinar</p>
      <p class="home-radio__text t-body">
        We design the human side of robotics. Robo Radio is where that belief becomes a conversation — through intimate discussions with the people shaping the field.
      </p>
      <Button href="/robo-radio" icon="hex">Learn more</Button>
    </div>
  </div>

  <ul class="home-radio__grid">
    {cells.map((c) => (
      <li class:list={['home-radio__cell', { 'home-radio__cell--stamp': 'stamp' in c }]}>
        {'episode' in c ? (
          <a class="home-radio__link" href={`/robo-radio/${c.episode.id}`}>
            <Image
              class="home-radio__poster"
              src={c.episode.data.cover!}
              alt={`${c.episode.data.title} poster`}
              widths={[541, 1082]}
              sizes="(min-width: 1728px) 541px, 31vw"
              loading="lazy"
            />
          </a>
        ) : (
          <img
            class="home-radio__stamp"
            src={c.stamp.src}
            alt=""
            width={c.stamp.w}
            height={c.stamp.h}
            style={`--w: ${c.stamp.w}; width: calc(${c.stamp.w} / 541 * 100%)`}
            loading="lazy"
          />
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .home-radio {
    padding-top: calc(100 * var(--px));
    padding-bottom: calc(124 * var(--px));
  }
  .home-radio__head {
    display: grid;
    grid-template-columns: calc(968 / 1648 * 100%) calc(553 * var(--px));
    align-items: start;
  }
  .home-radio__title {
    margin-top: calc(60 * var(--px));
  }
  .home-radio__intro {
    display: grid;
    justify-items: start;
    gap: calc(60 * var(--px));
  }
  .home-radio__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: calc(12 * var(--px));
    margin-top: calc(80 * var(--px));
  }
  .home-radio__cell {
    aspect-ratio: 541 / 765;
    display: grid;
    place-items: center;
  }
  .home-radio__link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .home-radio :global(.home-radio__poster) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .home-radio__stamp {
    height: auto;
  }

  /* ── Mobile: Figma 10098:911 — stacked head, full-width button,
     posters 253×358 in a row that scrolls sideways (stamps between them) ── */
  @media (max-width: 1023px) {
    .home-radio {
      padding-top: 188px;
      padding-bottom: 24px;
    }
    .home-radio__head {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-radio__title {
      margin-top: 0;
    }
    .home-radio__intro {
      margin-top: 64px;
      gap: var(--space-24);
      justify-items: stretch;
    }
    .home-radio__intro :global(.button) {
      margin-top: var(--space-20);
    }
    .home-radio__grid {
      display: flex;
      gap: 8px;
      margin: 64px calc(-1 * var(--page-margin)) 0;
      padding: 0 var(--page-margin);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .home-radio__cell {
      flex: none;
      width: 253px;
      aspect-ratio: 253 / 358;
    }
    .home-radio__cell--stamp {
      place-items: start;
      aspect-ratio: auto;
      width: auto;
    }
    /* Second stamp goes to the end of the row, as in Figma */
    .home-radio__cell--stamp:nth-child(4) {
      order: 1;
    }
    .home-radio__stamp {
      width: 235px !important;
    }
    .home-radio__cell--stamp:nth-child(4) .home-radio__stamp {
      width: 160px !important;
    }
  }
</style>
