---
/**
 * Project — Next project
 * Figma: "Frame 2147232972" (10100:13197), 1728×992, white
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10100-13197
 */
import Media from '../../components/ui/Media.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Button from '../../components/ui/Button.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
// Only projects with a page: the one chosen in the CMS, unless it's under NDA (or none is
// set) — then the next viewable project in the Work order. It shows that project's cover.
const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const at = all.findIndex((p) => p.id === project.id);
const nextEntry =
  all.find((p) => p.id === project.data.next && p.id !== project.id && !p.data.nda) ??
  [...all.slice(at + 1), ...all.slice(0, at)].find((p) => !p.data.nda);
const next = nextEntry && { name: nextEntry.data.name, href: `/work/${nextEntry.id}`, image: nextEntry.data.reveal };
---
{next && (
  <section class="project-next container">
    <div class="project-next__text">
      <p class="project-next__label t-h3" lang="ja">次のプロジェクト</p>
      <h2 class="project-next__title t-h1">{next.name}</h2>
      <Button href={next.href} icon="hex">View project</Button>
    </div>
    <div class="project-next__media">
      <Media class="project-next__fill" media={next.image} alt="" widths={[818, 1636]} sizes="(min-width: 1728px) 818px, 48vw" loading="lazy" />
    </div>
  </section>
)}

<style>
  .project-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter);
    padding-block: calc(60 * var(--px));
    background: var(--color-white);
    color: var(--color-black);
    max-width: none;
  }
  .project-next__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-bottom: calc(43 * var(--px));
  }
  .project-next__label {
    color: var(--color-orange);
  }
  .project-next__title {
    width: calc(818 * var(--px));
    max-width: 100%;
    margin-top: var(--space-20);
  }
  .project-next__text :global(.button) {
    margin-top: auto;
  }
  .project-next__media {
    aspect-ratio: 818 / 872;
    background: var(--color-black);
    border-radius: calc(4 * var(--px));
    overflow: hidden;
  }
  /* Whatever the cover is (image, GIF, video, YouTube), it fills the box, cropped */
  .project-next__media :global(.project-next__fill) {
    display: block;
    width: 100%;
    max-width: none;
    height: 100%;
    aspect-ratio: auto;
    object-fit: cover;
  }

  /* ── Mobile: text, then the image ── */
  @media (max-width: 1023px) {
    .project-next {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 40px;
      padding-block: 64px 100px;
    }
    .project-next__text {
      padding-bottom: 0;
    }
    /* the button across the full column */
    .project-next__text :global(.button) {
      display: flex;
      width: 100%;
      margin-top: 40px;
    }
    /* a vertical cover */
    .project-next__media {
      aspect-ratio: 4 / 5;
    }
  }
</style>
