---
/**
 * Project — Next project
 * Figma: "Frame 2147232972" (10100:13197), 1728×992, white
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10100-13197
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Button from '../../components/ui/Button.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { next } = Astro.props.project.data;
---
{next && (
  <section class="project-next container">
    <div class="project-next__text">
      <p class="project-next__label t-h3" lang="ja">次のプロジェクト</p>
      <h2 class="project-next__title t-h1">{next.name}</h2>
      <Button href={next.href} icon="hex">View project</Button>
    </div>
    <div class="project-next__media">
      <Image src={next.image} alt="" widths={[818, 1636]} sizes="(min-width: 1728px) 818px, 48vw" loading="lazy" />
    </div>
  </section>
)}

<style>
  .project-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter);
    padding-block: calc(60 * var(--px));
    background: var(--color-white);
    color: var(--color-black);
    max-width: none;
  }
  .project-next__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-bottom: calc(43 * var(--px));
  }
  .project-next__label {
    color: var(--color-orange);
  }
  .project-next__title {
    width: calc(818 * var(--px));
    max-width: 100%;
    margin-top: var(--space-20);
  }
  .project-next__text :global(.button) {
    margin-top: auto;
  }
  .project-next__media {
    aspect-ratio: 818 / 872;
    background: var(--color-black);
    border-radius: calc(4 * var(--px));
    overflow: hidden;
  }
  .project-next__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Mobile: text, then the image ── */
  @media (max-width: 767px) {
    .project-next {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 40px;
      padding-block: 64px 100px;
    }
    .project-next__text {
      padding-bottom: 0;
    }
    .project-next__text :global(.button) {
      margin-top: 40px;
    }
  }
</style>
