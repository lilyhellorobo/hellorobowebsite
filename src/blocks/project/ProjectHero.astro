---
/**
 * Project — Hero
 * Figma: "Frame 2147232848" (10100:12388, 1728×814) and "Frame 2147232797" (10100:12374, 1728×944)
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10100-12388
 * The two micrographics (round badge, stamp) are picked per project in the CMS.
 * The project's cover (`reveal`) isn't shown here: it's only the Work wheel background.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { data } = Astro.props.project;
const { micrographics } = data;
---
<section class="project-hero theme-dark">
  <h1 class="project-hero__title t-h1 container">{data.name}</h1>
  <span class="project-hero__plus t-h1" aria-hidden="true">+</span>
  {micrographics.left && <img class="project-hero__badge" src={micrographics.left} alt="" width="200" />}
  {micrographics.right && <img class="project-hero__stamp" src={micrographics.right} alt="" width="238" />}
  <p class="project-hero__intro t-body">{data.intro}</p>
</section>

<style>
  .project-hero {
    position: relative;
    aspect-ratio: 1728 / 814;
  }
  .project-hero__title {
    padding-top: var(--space-40);
  }
  .project-hero__plus {
    position: absolute;
    left: 50%;
    top: calc(350 / 814 * 100%);
    transform: translateX(-50%);
  }
  .project-hero__badge,
  .project-hero__stamp {
    position: absolute;
    height: auto;
  }
  /* Anchored by their bottom edge (770 / 774 in Figma) so taller graphics grow upwards */
  .project-hero__badge {
    left: var(--page-margin);
    bottom: calc((814 - 770) / 814 * 100%);
    width: calc(200 / 1728 * 100%);
  }
  .project-hero__stamp {
    left: calc(286 / 1728 * 100%);
    bottom: calc((814 - 774) / 814 * 100%);
    width: calc(238 / 1728 * 100%);
  }
  .project-hero__intro {
    position: absolute;
    left: calc(1147 / 1728 * 100%);
    /* Anchored by its bottom (773 in Figma) so longer wraps grow upwards */
    bottom: calc((814 - 773) / 814 * 100%);
    width: calc(541 * var(--px));
  }

  /* ── Mobile: title, badge + stamp, intro in flow ── */
  @media (max-width: 1023px) {
    .project-hero {
      aspect-ratio: auto;
      display: flex;
      flex-direction: column;
      padding-bottom: 64px;
    }
    .project-hero__title {
      padding-top: var(--space-20);
    }
    .project-hero__plus {
      position: static;
      transform: none;
      align-self: center;
      margin-top: 64px;
    }
    .project-hero__badge,
    .project-hero__stamp,
    .project-hero__intro {
      position: static;
      margin-left: var(--page-margin);
    }
    .project-hero__badge {
      width: 100px;
      margin-top: 64px;
    }
    .project-hero__stamp {
      width: 160px;
      margin-top: var(--space-24);
    }
    .project-hero__intro {
      width: auto;
      margin: 64px var(--page-margin) 0;
    }
  }
</style>
