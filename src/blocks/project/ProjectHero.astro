---
/**
 * Project — Hero
 * Figma: "Frame 2147232848" (10100:12388, 1728×814) and "Frame 2147232797" (10100:12374, 1728×944)
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10100-12388
 * Micrographics: a round badge + a wide stamp, one of five sets from the Figma covers
 * (10100:12388, 13836, 14089, 14115, 14141), each placed as in its cover. A random set is
 * picked on every visit (before the first paint, so nothing swaps in view); without
 * JavaScript each project shows a fixed set. If a project's micrographics are changed in
 * the CMS (anything but the default pair), that project always shows its own pair.
 * The project's cover (`reveal`) isn't shown here: it's only the Work wheel background.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { id, data } = Astro.props.project;
const { micrographics } = data;

// Badge (200×200 at x 40) + stamp: src, width, left and bottom edge in the 1728×814 cover
const SETS = [
  { badge: '/images/project/badge-25.svg', stamp: { src: '/images/project/stamp-project-hero.svg', w: 238, x: 286, bottom: 774 } },
  { badge: '/images/project/hero/badge-wild.svg', stamp: { src: '/images/project/hero/label-upgrade.svg', w: 407, x: 278, bottom: 767 } },
  { badge: '/images/project/hero/badge-humanoids.svg', stamp: { src: '/images/project/hero/label-signal.svg', w: 503, x: 264, bottom: 765 } },
  { badge: '/images/project/hero/badge-autonomous.svg', stamp: { src: '/images/project/hero/label-human-factor.svg', w: 264, x: 300, bottom: 759 } },
  { badge: '/images/project/hero/badge-strike.svg', stamp: { src: '/images/project/hero/label-made-together.svg', w: 271, x: 289, bottom: 773 } },
];
// a pair chosen in the CMS (other than the default one) replaces the random sets
const custom =
  (micrographics.left && micrographics.left !== SETS[0].badge) || (micrographics.right && micrographics.right !== SETS[0].stamp.src);
if (custom) SETS.splice(0, SETS.length, { badge: micrographics.left ?? SETS[0].badge, stamp: { ...SETS[0].stamp, src: micrographics.right ?? SETS[0].stamp.src } });
// fixed set per project for the first paint without JavaScript
const fallback = [...id].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7) % SETS.length;
---
<section class="project-hero theme-dark" data-hero-set={fallback} style={`--sets: ${SETS.length}`}>
  <h1 class="project-hero__title t-h1 container">{data.name}</h1>
  <span class="project-hero__plus t-h1" aria-hidden="true">+</span>
  {SETS.map((set, i) => (
    <div class="project-hero__set" data-set={i} aria-hidden="true">
      <img class="project-hero__badge" src={set.badge} alt="" width="200" height="200" loading={i === fallback ? 'eager' : 'lazy'} />
      <img
        class="project-hero__stamp"
        src={set.stamp.src}
        alt=""
        width={set.stamp.w}
        style={`--x: ${set.stamp.x}; --w: ${set.stamp.w}; --bottom: ${set.stamp.bottom}`}
        loading={i === fallback ? 'eager' : 'lazy'}
      />
    </div>
  ))}
  <script is:inline>
    // pick a random sticker set before the hero paints (runs right where it sits)
    (function (s) {
      var n = s.querySelectorAll('[data-set]').length;
      s.setAttribute('data-hero-set', String(Math.floor(Math.random() * n)));
    })(document.currentScript.parentElement);
  </script>
  <p class="project-hero__intro t-body">{data.intro}</p>
</section>

<style>
  .project-hero {
    position: relative;
    aspect-ratio: 1728 / 814;
  }
  .project-hero__title {
    padding-top: var(--space-40);
  }
  .project-hero__plus {
    position: absolute;
    left: 50%;
    top: calc(350 / 814 * 100%);
    transform: translateX(-50%);
  }
  .project-hero__badge,
  .project-hero__stamp {
    position: absolute;
    height: auto;
  }
  /* only the picked set shows */
  .project-hero__set {
    display: none;
  }
  .project-hero[data-hero-set='0'] .project-hero__set[data-set='0'],
  .project-hero[data-hero-set='1'] .project-hero__set[data-set='1'],
  .project-hero[data-hero-set='2'] .project-hero__set[data-set='2'],
  .project-hero[data-hero-set='3'] .project-hero__set[data-set='3'],
  .project-hero[data-hero-set='4'] .project-hero__set[data-set='4'] {
    display: contents;
  }
  /* Anchored by their bottom edge (770 / 774 in Figma) so taller graphics grow upwards */
  .project-hero__badge {
    left: var(--page-margin);
    bottom: calc((814 - 770) / 814 * 100%);
    width: calc(200 / 1728 * 100%);
  }
  .project-hero__stamp {
    left: calc(var(--x) / 1728 * 100%);
    bottom: calc((814 - var(--bottom)) / 814 * 100%);
    width: calc(var(--w) / 1728 * 100%);
  }
  .project-hero__intro {
    position: absolute;
    left: calc(1147 / 1728 * 100%);
    /* Anchored by its bottom (773 in Figma) so longer wraps grow upwards */
    bottom: calc((814 - 773) / 814 * 100%);
    width: calc(541 * var(--px));
  }

  /* ── Mobile: title, badge + stamp, intro in flow ── */
  @media (max-width: 1023px) {
    .project-hero {
      aspect-ratio: auto;
      display: flex;
      flex-direction: column;
      padding-bottom: 64px;
    }
    .project-hero__title {
      padding-top: var(--space-20);
    }
    .project-hero__plus {
      position: static;
      transform: none;
      align-self: center;
      margin-top: 64px;
    }
    .project-hero__badge,
    .project-hero__stamp,
    .project-hero__intro {
      position: static;
      margin-left: var(--page-margin);
    }
    .project-hero__badge {
      width: 100px;
      margin-top: 64px;
    }
    .project-hero__stamp {
      width: calc(var(--w) * 0.6px);
      max-width: calc(100% - 2 * var(--page-margin));
      margin-top: var(--space-24);
    }
    .project-hero__intro {
      width: auto;
      margin: 64px var(--page-margin) 0;
    }
  }
</style>
