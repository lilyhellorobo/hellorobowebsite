---
/**
 * Project — Text row (label left, text right)
 * Figma: "Frame 2147232893" (10100:12633), 1728×312
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10100-12633
 */
interface Props {
  label: string;
  text: string;
}
const { label, text } = Astro.props;
---
<div class="project-text-row container">
  <p class="project-text-row__label t-body">{label}</p>
  <p class="t-body">{text}</p>
</div>

<style>
  .project-text-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter);
    padding-block: calc(120 * var(--px));
  }
  /* Label wraps onto two lines in Figma (≈calc(170 * var(--px)) box) */
  .project-text-row__label {
    max-width: max(calc(170 * var(--px)), 140px);
  }

  /* Mobile: label above text */
  @media (max-width: 1023px) {
    .project-text-row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-24);
      padding-block: 64px;
    }
    .project-text-row__label {
      max-width: none;
    }
  }
</style>
