---
/**
 * Services — Through branding / interface / video production, as one pinned block
 * Figma: 10103:212, 10103:267, 10103:304 — each 1728×1109
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10103-212
 *
 * Desktop + tablet: the block pins to the screen; one screen of scrolling per service.
 * - Progress line on top: the bright segment grows as you move through the services.
 * - Left (label, title, stamp, services): words and lines slide up out of a mask and
 *   the next service's slide up in (style reference: telhaclarke.com.au/studio).
 * - Right: the next image slides in from the bottom over the previous one.
 * Motion uses the tokens in tokens.css (--ease-out, --duration-*, --stagger).
 * Mobile: the three services stacked, as before (no pin).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Divider from '../../components/ui/Divider.astro';

interface Service {
  title: string;
  services: string[];
  image: ImageMetadata;
  imageAlt: string;
  /** Stamp next to the title: src, size and offset inside the left column (Figma px) */
  stamp: { src: string; w: number; h: number; x: number; y: number };
}
interface Props {
  items: Service[];
}
const { items } = Astro.props;
---
<section class="services-scroller" style={`--count: ${items.length}`} data-services>
  <div class="services-scroller__stage container" data-active="0">
    <Divider accent class="services-scroller__rule" />
    <div class="services-scroller__grid">
      {items.map((item, i) => {
        const words = item.title.split(' ');
        return (
          <div class="services-scroller__slide" data-index={i} data-state={i === 0 ? 'current' : 'next'} aria-hidden={i > 0 ? 'true' : undefined}>
            <div class="services-scroller__text">
              <p class="services-scroller__label t-h3"><span class="mask"><span style="--d: 0">初め</span></span></p>
              <h2 class="services-scroller__title t-h1">
                {words.map((w, wi) => (
                  <><span class="mask"><span style={`--d: ${wi + 1}`}>{w}</span></span>{wi < words.length - 1 && ' '}</>
                ))}
              </h2>
              <img
                class="services-scroller__stamp"
                src={item.stamp.src}
                alt=""
                width={item.stamp.w}
                height={item.stamp.h}
                style={`--w: ${item.stamp.w}; left:calc(${item.stamp.x} * var(--px));top:calc(${item.stamp.y} * var(--px))`}
                loading="lazy"
              />
              <ul class="services-scroller__list t-body">
                {item.services.map((s, si) => (
                  <li><span class="mask"><span style={`--d: ${si + 2}`}>{s}</span></span></li>
                ))}
              </ul>
            </div>
            <div class="services-scroller__media" style={`z-index: ${i + 1}`}>
              <Image src={item.image} alt={item.imageAlt} widths={[818, 1636]} sizes="(min-width: 1728px) 818px, 48vw" loading="lazy" />
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  // Pinned services: progress 0→1 across the block picks the service and fills the line.
  // Each slide gets data-state: "past" (scrolled by), "current", or "next".
  for (const root of document.querySelectorAll<HTMLElement>('[data-services]')) {
    const stage = root.querySelector<HTMLElement>('.services-scroller__stage');
    const slides = [...root.querySelectorAll<HTMLElement>('.services-scroller__slide')];
    if (!stage || !slides.length) continue;
    let frame = 0;
    const update = () => {
      frame = 0;
      if (getComputedStyle(stage).position !== 'sticky') return; // mobile: stacked, no pin
      const rect = root.getBoundingClientRect();
      const travel = rect.height - stage.offsetHeight;
      const progress = travel > 0 ? Math.min(1, Math.max(0, -rect.top / travel)) : 0;
      const active = Math.min(slides.length - 1, Math.floor(progress * slides.length));
      stage.style.setProperty('--progress', String(progress));
      if (stage.dataset.active === String(active)) return;
      stage.dataset.active = String(active);
      slides.forEach((slide, i) => {
        slide.dataset.state = i < active ? 'past' : i === active ? 'current' : 'next';
        slide.setAttribute('aria-hidden', String(i !== active));
      });
    };
    const request = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    update();
  }
</script>

<style>
  /* One screen of scroll per service; the stage stays pinned while they pass */
  .services-scroller {
    position: relative;
    height: calc(var(--count) * 100vh);
  }
  .services-scroller__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    padding-top: var(--space-40);
    --progress: 0;
  }

  /* Progress on top: a third per service, growing smoothly with the scroll */
  .services-scroller :global(.services-scroller__rule.divider--accent)::before {
    width: calc((1 + var(--progress) * (var(--count) - 1)) / var(--count) * 100%);
    transition: width var(--duration-normal) var(--ease-out);
  }

  /* All slides share the same text cell and media cell */
  .services-scroller__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: 'text media';
    column-gap: var(--gutter);
    margin-top: calc(36 * var(--px)); /* image at 77 in Figma (rule at 40) */
  }
  .services-scroller__slide {
    display: contents;
  }
  .services-scroller__text {
    grid-area: text;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 0;
  }
  .services-scroller__slide[data-state='current'] .services-scroller__text {
    z-index: 1;
  }
  .services-scroller__label {
    color: var(--color-orange);
  }
  .services-scroller__title {
    margin-top: var(--space-20);
    width: calc(818 * var(--px));
    max-width: 100%;
  }
  .services-scroller__stamp {
    position: absolute;
    height: auto;
  }
  .services-scroller__list {
    display: grid;
    gap: var(--space-32);
    margin-top: auto;
  }

  /* ── Text reveal: each word / line sits in a mask and slides up through it ── */
  .mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    /* room for descenders under the tight H1 line height */
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  .mask > span {
    display: inline-block;
    transform: translateY(var(--y, 0));
    transition: transform var(--duration-smooth) var(--ease-out);
    transition-delay: calc(var(--d, 0) * var(--stagger));
  }
  .services-scroller__slide[data-state='next'] .mask > span {
    --y: 110%;
  }
  .services-scroller__slide[data-state='past'] .mask > span {
    --y: -110%;
    transition-delay: 0s;
  }
  /* Incoming words wait a beat so the outgoing ones clear first */
  .services-scroller__slide[data-state='current'] .mask > span {
    transition-delay: calc(0.12s + var(--d, 0) * var(--stagger));
  }
  .services-scroller__stamp {
    opacity: 0;
    transform: translateY(calc(16 * var(--px)));
    transition:
      opacity var(--duration-normal) var(--ease-out),
      transform var(--duration-smooth) var(--ease-out);
  }
  .services-scroller__slide[data-state='current'] .services-scroller__stamp {
    opacity: 1;
    transform: none;
    transition-delay: 0.3s;
  }

  /* ── Images: the next one slides in from the bottom over the previous ── */
  /* Figma 818×872 at (870, 77), corner 4: always the full right column (to the page
     margin). On short windows it keeps that width and crops top/bottom, leaving room
     for the nav pill (Figma: 157 under the image). The row takes the image's height,
     so the services list sits on the image's bottom edge. */
  .services-scroller__media {
    grid-area: media;
    position: relative;
    align-self: start;
    width: 100%;
    aspect-ratio: 818 / 872;
    max-height: calc(100vh - var(--space-40) - var(--line-width) - calc(36 * var(--px)) - calc(157 * var(--px)));
    border-radius: calc(4 * var(--px));
    overflow: hidden;
    background: var(--color-black);
    clip-path: inset(100% 0 0 0);
    transition: clip-path var(--duration-slow) var(--ease-out);
  }
  .services-scroller__slide:is([data-state='current'], [data-state='past']) .services-scroller__media {
    clip-path: inset(0 0 0 0);
  }
  .services-scroller__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translateY(12%) scale(1.08);
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .services-scroller__slide:is([data-state='current'], [data-state='past']) .services-scroller__media :global(img) {
    transform: none;
  }
  /* The first image is simply there */
  .services-scroller__slide[data-index='0'] .services-scroller__media {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .mask > span,
    .services-scroller__stamp,
    .services-scroller__media,
    .services-scroller__media :global(img) {
      transition-duration: 0.01s !important;
      transition-delay: 0s !important;
    }
  }

  /* ── Mobile: the three services stacked, no pin (as the single blocks were) ── */
  @media (max-width: 767px) {
    .services-scroller {
      height: auto;
    }
    .services-scroller__stage {
      position: static;
      height: auto;
      overflow: visible;
      padding-top: 164px;
    }
    .services-scroller :global(.services-scroller__rule) {
      display: none;
    }
    .services-scroller__grid {
      display: block;
      height: auto;
      margin-top: 0;
    }
    .services-scroller__slide {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 64px;
    }
    .services-scroller__slide + .services-scroller__slide {
      margin-top: 164px;
    }
    /* Undo the desktop's shared cells */
    .services-scroller__text,
    .services-scroller__media {
      grid-area: auto;
    }
    .services-scroller__title {
      width: auto;
    }
    .services-scroller__stamp {
      position: static;
      width: auto;
      max-height: 72px;
      margin-top: var(--space-24);
    }
    .services-scroller__list {
      gap: var(--space-16);
      margin-top: 64px;
    }
    .services-scroller__media {
      width: calc(100% + 2 * var(--page-margin));
      height: auto;
      max-height: none;
      max-width: none;
      margin-inline: calc(-1 * var(--page-margin));
    }
    /* Everything visible, no reveal states */
    .services-scroller__slide .mask > span,
    .services-scroller__slide .services-scroller__stamp,
    .services-scroller__slide .services-scroller__media,
    .services-scroller__slide .services-scroller__media :global(img) {
      --y: 0;
      opacity: 1;
      transform: none;
      clip-path: none;
    }
  }
</style>
