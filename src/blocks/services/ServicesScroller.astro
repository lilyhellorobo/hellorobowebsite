---
/**
 * Services — Through branding / interface / video production, as one pinned block
 * Figma: 10103:212, 10103:267, 10103:304 — each 1728×1109
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10103-212
 *
 * Desktop + tablet: the block pins to the screen; one screen of scrolling per service.
 * - Progress line on top: the bright segment grows as you move through the services.
 * - Left (label, title, stamp, services): words, lines and the stamp slide out of their
 *   masks and the next service's slide in, in the direction you scroll (style reference:
 *   telhaclarke.com.au/studio).
 * - Right: the next image slides in from the bottom over the previous one.
 * Motion uses the tokens in tokens.css (--ease-out, --duration-*, --stagger).
 * Mobile: the three services stacked, as before (no pin).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Divider from '../../components/ui/Divider.astro';

interface Service {
  title: string;
  services: string[];
  image: ImageMetadata;
  imageAlt: string;
  /** Stamp next to the title: src, size and offset inside the left column (Figma px) */
  stamp: { src: string; w: number; h: number; x: number; y: number };
}
interface Props {
  items: Service[];
}
const { items } = Astro.props;
---
<section class="services-scroller" style={`--count: ${items.length}`} data-services>
  <div class="services-scroller__stage container" data-active="0">
    <Divider accent class="services-scroller__rule" />
    <div class="services-scroller__grid">
      {items.map((item, i) => {
        // a one- or two-letter word rides with the next one, so no line ends on it
        const words = item.title.split(' ').reduce<string[]>((out, w) => {
          const prev = out[out.length - 1];
          if (prev !== undefined && prev.split('\u00a0').pop()!.length <= 2) out[out.length - 1] = `${prev}\u00a0${w}`;
          else out.push(w);
          return out;
        }, []);
        return (
          <div class="services-scroller__slide" data-index={i} data-state={i === 0 ? 'current' : 'next'} aria-hidden={i > 0 ? 'true' : undefined}>
            <div class="services-scroller__text">
              <p class="services-scroller__label t-h3"><span class="mask"><span style="--d: 0">初め</span></span></p>
              <h2 class="services-scroller__title t-h1">
                {words.map((w, wi) => (
                  <><span class="mask"><span style={`--d: ${wi + 1}`}>{w}</span></span>{wi < words.length - 1 && ' '}</>
                ))}
              </h2>
              <span class="services-scroller__stamp" style={`left:calc(${item.stamp.x} * var(--px));top:calc(${item.stamp.y} * var(--px))`}>
                <img src={item.stamp.src} alt="" width={item.stamp.w} height={item.stamp.h} style={`--w: ${item.stamp.w}`} loading="lazy" />
              </span>
              <ul class="services-scroller__list t-body">
                {item.services.map((s, si) => (
                  <li><span class="mask"><span style={`--d: ${si + 2}`}>{s}</span></span></li>
                ))}
              </ul>
            </div>
            <div class="services-scroller__media" style={`z-index: ${i + 1}`}>
              <Image src={item.image} alt={item.imageAlt} widths={[818, 1200, 1636]} sizes="(min-width: 1728px) 818px, (min-width: 1024px) 48vw, calc(100vw - 32px)" loading="lazy" />
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  import { slideScrub } from '../../scripts/slide-scrub';

  // Pinned services: progress 0→1 across the block picks the service and fills the line.
  // Each slide gets data-state: "past" (scrolled by), "current", or "next"; the pictures
  // uncover one another with the scroll (slide-scrub.ts).
  for (const root of document.querySelectorAll<HTMLElement>('[data-services]')) {
    const stage = root.querySelector<HTMLElement>('.services-scroller__stage');
    const slides = [...root.querySelectorAll<HTMLElement>('.services-scroller__slide')];
    if (!stage || !slides.length) continue;
    const pictures = slideScrub([...root.querySelectorAll<HTMLElement>('.services-scroller__media')]);
    let frame = 0;
    const update = () => {
      frame = 0;
      if (getComputedStyle(stage).position !== 'sticky') return; // mobile: stacked, no pin
      const rect = root.getBoundingClientRect();
      const travel = rect.height - stage.offsetHeight;
      const progress = travel > 0 ? Math.min(1, Math.max(0, -rect.top / travel)) : 0;
      const active = Math.min(slides.length - 1, Math.floor(progress * slides.length));
      stage.style.setProperty('--progress', String(progress));
      pictures.set(Math.min(slides.length - 1, Math.max(0, progress * slides.length - 0.5)));
      if (stage.dataset.active === String(active)) return;
      stage.dataset.active = String(active);
      slides.forEach((slide, i) => {
        slide.dataset.state = i < active ? 'past' : i === active ? 'current' : 'next';
        slide.setAttribute('aria-hidden', String(i !== active));
      });
    };
    const request = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    update();
  }
</script>

<style>
  /* One screen of scroll per service; the stage stays pinned while they pass */
  .services-scroller {
    position: relative;
    height: calc(var(--count) * 100vh);
  }
  .services-scroller__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    padding-top: var(--space-40);
    --progress: 0;
  }

  /* Progress on top: a third per service, growing smoothly with the scroll */
  .services-scroller :global(.services-scroller__rule.divider--accent)::before {
    width: calc((1 + var(--progress) * (var(--count) - 1)) / var(--count) * 100%);
    transition: width var(--duration-normal) var(--ease-out);
  }

  /* All slides share the same text cell and media cell */
  .services-scroller__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: 'text media';
    column-gap: var(--gutter);
    margin-top: calc(36 * var(--px)); /* image at 77 in Figma (rule at 40) */
  }
  .services-scroller__slide {
    display: contents;
  }
  .services-scroller__text {
    grid-area: text;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 0;
  }
  .services-scroller__slide[data-state='current'] .services-scroller__text {
    z-index: 1;
  }
  .services-scroller__label {
    color: var(--color-orange);
  }
  .services-scroller__title {
    margin-top: var(--space-20);
    width: calc(818 * var(--px));
    max-width: 100%;
  }
  /* the stamp's mask: the stamp slides through it, like the words */
  .services-scroller__stamp {
    position: absolute;
    overflow: hidden;
  }
  .services-scroller__stamp img {
    display: block;
    height: auto;
  }
  .services-scroller__list {
    display: grid;
    gap: var(--space-32);
    margin-top: auto;
  }

  /* ── Text reveal: each word / line sits in a mask and slides up through it ── */
  .mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    /* room on every side so no letter is clipped: the tight H1 line height (0.95) puts
       the tops of b / d / h / T and the descenders outside the line box */
    padding: 0.1em 0.06em 0.14em;
    margin: -0.1em -0.06em -0.14em;
  }
  .mask > span {
    display: inline-block;
    transform: translateY(var(--y, 0));
    transition: transform var(--duration-smooth) var(--ease-out);
    transition-delay: calc(var(--d, 0) * var(--stagger));
  }
  /* far enough that no part of a waiting word shows in the mask's extra room */
  .services-scroller__slide[data-state='next'] .mask > span {
    --y: 135%;
  }
  .services-scroller__slide[data-state='past'] .mask > span {
    --y: -135%;
    transition-delay: 0s;
  }
  /* Incoming words wait a beat so the outgoing ones clear first */
  .services-scroller__slide[data-state='current'] .mask > span {
    transition-delay: calc(0.12s + var(--d, 0) * var(--stagger));
  }
  .services-scroller__stamp img {
    transform: translateY(var(--y, 0));
    transition: transform var(--duration-smooth) var(--ease-out);
  }
  .services-scroller__slide[data-state='next'] .services-scroller__stamp img {
    --y: 110%;
  }
  .services-scroller__slide[data-state='past'] .services-scroller__stamp img {
    --y: -110%;
  }
  /* incoming: a beat after the words */
  .services-scroller__slide[data-state='current'] .services-scroller__stamp img {
    transition-delay: 0.3s;
  }

  /* ── Images: the next one slides in from the bottom over the previous ── */
  /* The full right column (to the page margin, Figma x 870 → 1688), from 77 down to the
     page margin at the bottom of the screen — the same 40 as at the sides. It may pass
     under the nav pill; the image crops (cover) to fill it. The row takes the image's
     height, so the services list sits on the image's bottom edge. */
  .services-scroller__media {
    grid-area: media;
    position: relative;
    align-self: start;
    width: 100%;
    height: calc(100vh - var(--space-40) - var(--line-width) - calc(36 * var(--px)) - var(--page-margin));
    border-radius: calc(4 * var(--px));
    overflow: hidden;
    background: var(--color-black);
  }
  /* The boxes are stacked in one place; the next one is uncovered from the bottom over the
     current one as you scroll, its picture drifting slowly inside (slide-scrub.ts). Boxes
     after the first are see-through, so only their picture shows. Without JS: the first. */
  .services-scroller__slide:not([data-index='0']) .services-scroller__media {
    background: none;
    visibility: hidden;
  }
  .services-scroller__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: reduce) {
    .mask > span,
    .services-scroller__stamp img,
    .services-scroller__media :global(img) {
      transition-duration: 0.01s !important;
      transition-delay: 0s !important;
    }
  }

  /* ── Mobile: pinned like desktop, one screen per service. The label, the title with the
     stamp on its right, the services under it, and the image filling the rest of the
     screen above the menu bar; the same reveal (words through masks, stamp fade, the next
     image uncovered over the previous) ── */
  @media (max-width: 1023px) {
    .services-scroller {
      height: calc(var(--count) * 100vh);
      height: calc(var(--count) * 100svh);
    }
    .services-scroller__stage {
      display: flex;
      flex-direction: column;
      height: 100vh;
      height: 100svh;
      padding-top: var(--page-margin);
      /* 16 above the menu bar (16 from the bottom, 64 tall) */
      padding-bottom: calc(var(--page-margin) + var(--nav-height) + 16px);
    }
    .services-scroller__grid {
      flex: 1;
      min-height: 0;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
      grid-template-areas: 'text' 'media';
      row-gap: var(--space-24);
      margin-top: var(--space-20);
    }
    .services-scroller__title {
      width: auto;
      margin-top: var(--space-12);
    }
    /* Stamp on the right of the title's first line (the label is 37 tall, + 12) */
    .services-scroller__stamp {
      left: auto !important;
      right: 0;
      top: 49px !important;
      height: 64px;
    }
    .services-scroller__stamp img {
      width: auto;
      height: 100%;
    }
    /* services in two columns at Body2 (12), so the image gets the height to be vertical */
    .services-scroller__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-12) var(--gutter);
      margin-top: var(--space-24);
      font-size: var(--type-body2-size-mobile);
    }
    .services-scroller__media {
      height: 100%;
    }
  }
</style>
