---
/**
 * Services — Service block (branding / interface / video production)
 * Figma: 10103:212, 10103:267, 10103:304 — each 1728×1109
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10103-212
 * Rule with accent · 初め label · H1 title + stamp · list of services · media on the right.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Divider from '../../components/ui/Divider.astro';

interface Props {
  title: string;
  services: string[];
  image: ImageMetadata;
  imageAlt: string;
  /** Stamp next to the title: src, size and offset inside the left column (Figma px) */
  stamp: { src: string; w: number; h: number; x: number; y: number };
}
const { title, services, image, imageAlt, stamp } = Astro.props;
---
<section class="service-block container">
  <Divider accent class="service-block__rule" />
  <div class="service-block__grid">
    <div class="service-block__text">
      <p class="service-block__label t-h3">初め</p>
      <h2 class="service-block__title t-h1">{title}</h2>
      <img
        class="service-block__stamp"
        src={stamp.src}
        alt=""
        width={stamp.w}
        height={stamp.h}
        style={`--w: ${stamp.w}; left:calc(${stamp.x} * var(--px));top:calc(${stamp.y} * var(--px))`}
        loading="lazy"
      />
      <ul class="service-block__list t-body">
        {services.map((s) => <li>{s}</li>)}
      </ul>
    </div>
    <div class="service-block__media">
      <Image src={image} alt={imageAlt} widths={[818, 1636]} sizes="(min-width: 1728px) 818px, 48vw" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .service-block {
    padding-top: var(--space-40);
    padding-bottom: calc(157 * var(--px));
  }
  /* Accent segment is 338 of 1648 */
  .service-block :global(.service-block__rule.divider--accent)::before {
    width: calc(338 / 1648 * 100%);
  }
  .service-block__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter);
    margin-top: var(--space-40);
  }
  .service-block__text {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .service-block__label {
    color: var(--color-orange);
  }
  .service-block__title {
    margin-top: var(--space-20);
    width: calc(818 * var(--px));
    max-width: 100%;
  }
  .service-block__stamp {
    position: absolute;
    height: auto;
  }
  .service-block__list {
    display: grid;
    gap: var(--space-32);
    margin-top: auto;
  }
  .service-block__media {
    aspect-ratio: 818 / 872;
    background: var(--color-black);
    overflow: hidden;
  }
  .service-block__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Mobile: one column — label, title, stamp, list, then the image full width ── */
  @media (max-width: 767px) {
    .service-block {
      padding-top: 164px;
      padding-bottom: 0;
    }
    .service-block__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 64px;
      margin-top: var(--space-24);
    }
    .service-block__title {
      width: auto;
    }
    .service-block__stamp {
      position: static;
      width: auto;
      max-height: 72px;
      margin-top: var(--space-24);
    }
    .service-block__list {
      gap: var(--space-16);
      margin-top: 64px;
    }
    .service-block__media {
      margin-inline: calc(-1 * var(--page-margin));
    }
  }
</style>
