---
/**
 * Work — Project scroller (also used on Home as "Featured work")
 * Figma: Home "Portfolio page d" (10093:1049) / Work "Portfolio page" (10100:11973), 1728×1117
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10093-1049
 *
 * Static state of the wheel: the active project in the H2 style, the others
 * smaller and fainter above/below it. Sizes, opacities and offsets are from
 * Figma. Scrolling the wheel + the lens/CRT shaders come in the motion/WebGL steps.
 * TODO (CMS): read the list from the projects collection.
 */
import { Image } from 'astro:assets';
import Button from '../../components/ui/Button.astro';
import bg from '../../assets/work/featured-bg.png';

interface Props {
  as?: 'section' | 'div';
}
const { as: Tag = 'section' } = Astro.props;

// name, x, y, size (px in Figma), opacity — in the 1728×1117 frame
const wheel = [
  { name: 'Geolava', x: 335, y: -39, size: 56, opacity: 0.15 },
  { name: 'Turing Robotics Industries', x: 376, y: 65, size: 52, opacity: 0.1 },
  { name: 'Open Robotics', x: 354, y: 125, size: 58, opacity: 0.15 },
  { name: 'Transitive Robotics', x: 344, y: 204, size: 62, opacity: 0.25 },
  { name: 'Public.ai', x: 336, y: 298, size: 68, opacity: 0.35 },
  { name: 'Bedrock Robotics', x: 319, y: 404, size: 75, opacity: 0.5 },
  { name: 'Surf Air Flight Ops', x: 319, y: 511, size: 80, opacity: 1, active: true },
  { name: 'Cosmic Robotics', x: 322, y: 628, size: 75, opacity: 0.5 },
  { name: 'Geolava', x: 330, y: 738, size: 68, opacity: 0.35 },
  { name: 'Weekly Robotics', x: 346, y: 838, size: 62, opacity: 0.25 },
  { name: 'Turing Robotics Industries', x: 356, y: 935, size: 58, opacity: 0.15 },
  { name: 'Open Robotics', x: 378, y: 1019, size: 52, opacity: 0.1 },
  { name: 'Transitive Robotics', x: 372, y: 1089, size: 48, opacity: 0.1 },
];
const activeServices = ['Fleet Management Design', 'Brand Identity', 'Video Production'];
const pctX = (v: number) => `${(v / 1728) * 100}%`;
const pctY = (v: number) => `${(v / 1117) * 100}%`;
---
<Tag class="project-scroller theme-dark" aria-label="Selected work">
  <Image
    class="project-scroller__bg"
    src={bg}
    alt=""
    widths={[1400, 2406]}
    sizes="140vw"
    loading="lazy"
  />
  <div class="project-scroller__scanlines" aria-hidden="true"></div>

  <hr class="project-scroller__rule" />
  <img class="project-scroller__mark" src="/images/home/work-globe.svg" alt="" width="72" height="79" loading="lazy" />

  <ol class="project-scroller__names">
    {wheel.map((p) => (
      <li
        class:list={['project-scroller__name', 't-h2', { 'is-active': p.active }]}
        style={`left:${pctX(p.x)};top:${pctY(p.y)};--k:${p.size / 80};opacity:${p.opacity}`}
        aria-current={p.active ? 'true' : undefined}
      >
        {p.name}
      </li>
    ))}
  </ol>

  <Button href="/work" variant="light" size="small" class="project-scroller__view">View</Button>

  <ul class="project-scroller__services t-body">
    {activeServices.map((s) => <li>{s}</li>)}
  </ul>
</Tag>

<style>
  .project-scroller {
    position: relative;
    aspect-ratio: 1728 / 1117;
    overflow: hidden;
    background: var(--color-black);
  }
  /* Background still: 2406×1555 at (-339, -235) */
  .project-scroller :global(.project-scroller__bg) {
    position: absolute;
    left: calc(-339 / 1728 * 100%);
    top: calc(-235 / 1117 * 100%);
    width: calc(2406 / 1728 * 100%);
    height: auto;
    max-width: none;
  }
  /* Stand-in for the CRT shader until the WebGL step */
  .project-scroller__scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to bottom, rgb(0 0 0 / 0.18) 0 1px, transparent 1px 3px);
    pointer-events: none;
  }
  .project-scroller__rule {
    position: absolute;
    left: var(--page-margin);
    right: var(--page-margin);
    top: calc(622 / 1117 * 100%);
    margin: 0;
    border: 0;
    border-top: var(--line-width) solid var(--line-on-dark);
  }
  .project-scroller__mark {
    position: absolute;
    left: calc(104 / 1728 * 100%);
    top: calc(519 / 1117 * 100%);
    width: calc(72 / 1728 * 100%);
    height: auto;
  }
  .project-scroller__names {
    position: absolute;
    inset: 0;
  }
  /* H2 style, scaled per row to match the wheel (80 → 48px) */
  .project-scroller__name {
    position: absolute;
    font-size: calc(var(--type-h2-size) * var(--k));
    white-space: nowrap;
    color: var(--color-white);
  }
  .project-scroller :global(.project-scroller__view) {
    position: absolute;
    left: calc(1051 / 1728 * 100%);
    top: calc(573 / 1117 * 100%);
  }
  .project-scroller__services {
    position: absolute;
    left: calc(1362 / 1728 * 100%);
    top: calc(515 / 1117 * 100%);
    display: grid;
    gap: 8px;
  }
</style>
