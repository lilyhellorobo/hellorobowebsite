---
/**
 * Contact — Inquiry receipt
 * Figma: "receipt" (10099:11845), 546×1651
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10099-11845
 * Static artwork of the Figma sample (#102, Michael, Robotics Co). The receipt fonts
 * (Fake Receipt, Merchant Copy) aren't site fonts, so the text is outlined in the SVG.
 * TODO (logic step): fill name, company, services, number and date from the form.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<figure class:list={['receipt', className]} aria-label="Inquiry receipt">
  <img src="/images/contact/receipt.svg" alt="" width="546" height="1651" />
  <img class="receipt__photo" src="/images/contact/receipt-photo.png" alt="" width="495" height="322" />
</figure>

<style>
  .receipt {
    position: relative;
    aspect-ratio: 546 / 1651;
  }
  .receipt img {
    width: 100%;
    height: auto;
  }
  /* Halftone photo at (25, 1048), 495×322 inside the receipt */
  .receipt__photo {
    position: absolute;
    left: calc(25 / 546 * 100%);
    top: calc(1048 / 1651 * 100%);
    width: calc(495 / 546 * 100%) !important;
  }
</style>
