---
/**
 * Contact block — every screen of "Start a project" / "Drop a quick word" in one black block
 * Figma: 10412:2240 (cover) · 10412:2249 (start) · 10412:2436 / 2548 / 10419:222 (steps
 * 01–03) · 10419:276 (mission) · 10419:3537 (done) · 10412:2490 / 2602 (error states) ·
 * 10419:6147 (email copied) · 10419:6404 / 6622 (quick word, sent) ·
 * mobile 10419:5894 (cover) / 10419:5961 (start).
 * Screens switch in place (data-step on the block); the printers move and the faint mono
 * "system log" behind them retypes itself with new words on every screen — partly built
 * from the site's projects / episodes, partly from what the visitor has typed so far.
 * `embedded` = the pre-footer block on every page: opens on the cover, never touches the URL.
 * On /contact it starts at "start" and keeps the step in the URL hash (so Back works).
 * Send posts the answers to /api/contact (saved for the CMS "Contact form responses").
 */
import { getCollection } from 'astro:content';
import Icon from '../../components/icons/Icon.astro';
import { studio } from '../../data/site';

interface Props {
  /** The pre-footer block: opens on the cover; steps don't change the URL */
  embedded?: boolean;
}
const { embedded = false } = Astro.props;
const Title = embedded ? 'h2' : 'h1';

// ── System log content: one set of groups per screen ─────────────────────────────────
const projects = (await getCollection('projects')).slice(0, 6);
const episodes = (await getCollection('episodes', (e) => e.data.listed !== false))
  .sort((a, b) => b.data.number - a.data.number)
  .slice(0, 3);
const positions = (await getCollection('positions')).sort((a, b) => a.data.order - b.data.order).slice(0, 1);

const up = (s: string) => s.toUpperCase();
const now = new Date();
const stamp = `${String(now.getMonth() + 1).padStart(2, '0')}${String(now.getDate()).padStart(2, '0')}${String(now.getFullYear()).slice(2)}`;
const project = (i: number) => {
  const p = projects[i % projects.length];
  return [`> ${up(p.data.name)}_`, ...p.data.services.slice(0, 2).map(up)];
};
const episode = (i: number) => {
  const e = episodes[i % episodes.length];
  return [`ROBO RADIO ${e.data.number}_`, up(e.data.guest)];
};
const role = positions[0];
const email = up(studio.email);

// Slots placed as in the Figma reference image (x, y in % of the log's box); `n` is the
// label, `m` the place on phones (groups without it are desktop only)
type Group = { x: number; y: number; n?: string; lines: string[]; m?: [number, number] };
type Slots = Partial<Record<'h1' | 'h2' | 'h3' | 'h4' | 'intro' | 'st' | 'a' | 'b' | 'c' | 'd' | 'e' | 'f' | 'g' | 'r1' | 'r2' | 'r3' | 'r4', string[]>>;
const SLOT: Record<keyof Slots, Omit<Group, 'lines'>> = {
  h1: { x: 2, y: 2 },
  h2: { x: 15, y: 2 },
  h3: { x: 40, y: 2 },
  h4: { x: 66, y: 2 },
  intro: { x: 22.5, y: 15, n: '002', m: [0, 0] },
  st: { x: 50, y: 15 },
  a: { x: 11, y: 25, n: '(A)', m: [0, 22] },
  b: { x: 11, y: 39, n: '(B)', m: [0, 50] },
  c: { x: 2, y: 49, n: '(C)', m: [0, 76] },
  d: { x: 2, y: 56, n: '(D)' },
  e: { x: 22.5, y: 64, n: '(E)' },
  f: { x: 41.5, y: 64, n: '(F)' },
  g: { x: 22.5, y: 83, n: '(G)' },
  // right part: the open strip right of the printer (no labels, it's narrow)
  r1: { x: 88, y: 12 },
  r2: { x: 88, y: 29 },
  r3: { x: 88, y: 46 },
  r4: { x: 88, y: 60 },
};
const groups = (s: Slots): Group[] =>
  (Object.keys(s) as (keyof Slots)[]).map((k) => ({ ...SLOT[k], lines: s[k]! }));

// {name} {email} {company} {services} are filled in from the form as the visitor goes
const logs: Record<string, { a: Group[]; b?: Group[] }> = {
  cover: {
    a: groups({
      h1: ['[ HR'], h2: ['HELLO ROBO®'], h3: ['02 ]'], h4: [`HELLO ROBO, INC. © ${now.getFullYear()}`],
      intro: ['HELLO ROBO®', 'SYSTEM LOG INTERVIEW', stamp],
      st: ['A studio for the human side of robotics —', 'shaping brands, interfaces and films for machines.'],
      a: ['WORK_', ...project(0)], b: project(1), c: episode(0), d: episode(1), e: project(2), f: project(3),
      g: role ? [`> ${up(role.data.title)}_`, up(role.data.location), up(role.data.type)] : ['> WE ARE HIRING_'],
      r1: project(4), r2: project(5), r3: episode(2), r4: ['> SERVICES_', 'BRANDING', 'INTERFACE', 'VIDEO PRODUCTION'],
    }),
  },
  start: {
    a: groups({
      h1: ['[ HR'], h2: ['INCOMING SIGNAL'], h3: ['03 ]'], h4: ['CHANNELS: OPEN'],
      intro: ['HELLO ROBO®', 'CONTACT TERMINAL', stamp],
      st: ['Three ways in. Pick one —', 'we read everything, humans first.'],
      a: ['> START A PROJECT_', 'BRIEF IN 4 STEPS', '~2 MIN'], b: ['> QUICK WORD_', 'ONE FIELD', 'NO PRESSURE'],
      c: ['> COPY EMAIL_', email], d: ['RESPONSE TIME_', '< 24 H'], e: ['STATUS_', 'HUMANS: ONLINE', 'ROBOTS: STANDBY'],
      f: ['QUEUE_', 'EMPTY. YOUR TURN.'], g: ['> WAITING FOR INPUT_'],
      r1: ['CURIOSITY 98%', 'EGO 02%'], r2: ['TRUST_SYNCED', 'YES_PENDING'], r3: [up(`${studio.city} ${studio.region}`), 'EST'], r4: ['> SAY HELLO_'],
    }),
  },
  name: {
    a: groups({
      h1: ['[ 01'], h2: ['IDENTITY SCAN'], h3: ['04 ]'], h4: ['STEP 1 / 4'],
      intro: ['HUMAN DETECTED', 'NAME FIELD OPEN', stamp],
      st: ['Before we connect the dots —', 'identify the human.'],
      a: ['SCAN_', 'FACE: FRIENDLY', 'HANDS: 2'], b: ['ROLE_', 'FOUNDER?', 'ENGINEER?', 'DREAMER?'], c: ['NAME: {name}_'],
      d: ['ALIAS ACCEPTED', 'NICKNAMES OK'], e: ['CONFIDENCE_', 'HUMAN 99.8%', 'ROBOT 0.2%'], f: ['> NEXT: EMAIL_'], g: ['WAITING FOR INPUT_'],
    }),
  },
  email: {
    a: groups({
      h1: ['[ 02'], h2: ['ROUTING TABLE'], h3: ['04 ]'], h4: ['STEP 2 / 4'],
      intro: ['HELLO, {name}', 'DESTINATION UNKNOWN', stamp],
      st: ['Every good connection needs', 'a destination.'],
      a: ['PROTOCOL_', 'SMTP / HELLO', 'PORT 587'], b: ['ROUTE_', '{name} → HELLO ROBO'], c: ['ADDRESS: {email}_'],
      d: ['SPAM: NEVER', 'NEWSLETTER: NO'], e: ['PING_', '64 BYTES FROM HUMAN', 'TIME=1MS'], f: ['> NEXT: COMPANY_'], g: ['WAITING FOR @_'],
    }),
  },
  company: {
    a: groups({
      h1: ['[ 03'], h2: ['TEAM-UP REGISTRY'], h3: ['04 ]'], h4: ['STEP 3 / 4'],
      intro: ['{name}', '{email}', stamp],
      st: ['Startup, spaceship or', 'secret laboratory.'],
      a: ['CLASSIFY_', 'STARTUP', 'SPACESHIP', 'SECRET LAB'], b: ['JUDGEMENT_', 'DISABLED'], c: ['COMPANY: {company}_'],
      d: ['NDA: AVAILABLE', 'STEALTH: RESPECTED'], e: ['FLEET SIZE_', '1 → 10,000 ROBOTS'], f: ['> NEXT: MISSION_'], g: ['WAITING FOR INPUT_'],
    }),
  },
  mission: {
    a: groups({
      h1: ['[ 04'], h2: ['MISSION BRIEF'], h3: ['04 ]'], h4: ['STEP 4 / 4'],
      intro: ['{company}', 'PRIORITY: HIGH', stamp],
      st: ['Pick as many as you like —', 'all three live under one roof.'],
      a: ['> BRANDING_', 'NAMING', 'IDENTITY', 'TONE OF VOICE'], b: ['> INTERFACE_', 'HRI', 'FLEET UI', 'DASHBOARDS'],
      c: ['> VIDEO PRODUCTION_', 'LAUNCH FILMS', 'DEMOS'], d: ['SELECTED: {services}'], e: ['BUDGET_', "LET'S TALK"],
      f: ['TIMELINE_', 'YESTERDAY?'], g: ['> READY TO SUBMIT_'],
    }),
  },
  message: {
    a: groups({
      h1: ['[ HR'], h2: ['OPEN CHANNEL'], h3: ['01 ]'], h4: ['QUICK WORD'],
      intro: ['ONE FIELD', 'NO FORMS', stamp],
      st: ["Don't overthink it.", 'Just type away.'],
      a: ['> MESSAGE_', 'LENGTH: ANY'], b: ['TONE_', 'CASUAL OK', 'WEIRD OK'], c: ['READ BY_', 'A REAL HUMAN'],
      d: ['REPLY_', '< 24 H'], e: ['ENCRYPTION_', 'HANDWRITTEN-GRADE'], f: ['> SEND_'], g: ['WAITING FOR WORDS_'],
    }),
  },
  done: {
    a: groups({
      h1: ['[ OK'], h2: ['TRANSMISSION COMPLETE'], h3: ['✓ ]'], h4: ['RECEIPT #321'],
      intro: ['THANKS, {name}', '{company}', stamp],
      st: ['Your message has landed safely.', 'Our humans are on it.'],
      a: ['HUMANS_', 'NOTIFIED'], b: ['ROBOTS_', 'PRETENDING TO HELP'], c: ['STATUS_', 'YES_PENDING → YES'],
      d: ['ARCHIVED BY', 'HUMAN INPUT CONFIRMED'], e: ['> WE BUILD FOR', 'WHO MOVES NEXT_'], f: ['REPLY_', '< 24 H'], g: ['KEEP THIS RECEIPT_', "OR DON'T. WE HAVE A COPY."],
    }),
    b: groups({
      h2: ['SIGNAL RECEIVED'], h3: ['OK ]'], h4: ['CONNECTION ESTABLISHED'],
      intro: ['{name}', '{email}', '{company}'],
      st: ['Your message is in good hands.', 'Human hands, actually.'],
      a: ['SELECTED_', '{services}'], b: ['QUEUE_', 'POSITION #1'], c: ['NEXT_', 'A REAL HUMAN REPLIES'],
      d: ['YOUR ROBOT', 'REMAINS CALM'], e: ['> SEE YOU SOON_'],
    }),
  },
};

logs.sent = {
  a: groups({
    h1: ['[ OK'], h2: ['MESSAGE DELIVERED'], h3: ['✓ ]'], h4: ['QUICK WORD'],
    intro: ['HI RECEIVED', 'MOOD: DELIGHTED', stamp],
    st: ['Your message is on its way', 'to a real human.'],
    a: ['HUMANS_', 'READING'], b: ['ROBOTS_', 'WAVING BACK'], c: ['STATUS_', 'HELLO → HELLO'],
    d: ['REPLY_', '< 24 H'], e: ['> WE LIKE THOSE', 'AROUND HERE_'], f: ['CHANNEL_', 'STILL OPEN'], g: ['SAY HI AGAIN_', 'ANYTIME'],
  }),
  b: logs.done.b,
};

const steps = [
  { id: 'name', n: '01', title: 'Who’s on the other side?', lead: 'Before we connect the dots, let’s identify the human.', field: 'Your name', type: 'text', auto: 'name', cap: 'words', back: 'start' },
  { id: 'email', n: '02', title: 'Where should we say hello?', lead: 'Every good connection needs a destination. Drop your coordinates.', field: 'Your email', type: 'email', auto: 'email', cap: 'off', back: 'name' },
  { id: 'company', n: '03', title: 'Who are we teaming up with?', lead: 'Startup, spaceship, or secret laboratory. We don’t judge.', field: 'Company name', type: 'text', auto: 'organization', cap: 'words', back: 'email' },
];
const services = [
  { label: 'Branding', sticker: 'mission-branding', w: 74, h: 75, x: 309, y: 50 },
  { label: 'Interface', sticker: 'mission-interface', w: 76, h: 68, x: 307, y: 53 },
  { label: 'Video production', sticker: 'mission-video', w: 87, h: 52, x: 295, y: 68 },
];
const first = embedded ? 'cover' : 'start';
---
<section
  class:list={['contact', embedded && 'contact--embedded']}
  aria-label="Contact"
  data-contact={embedded ? 'embedded' : 'page'}
  data-step={first}
>
  <!-- Background: printers and the system log; each screen moves / swaps them in CSS -->
  <div class="contact__bg" aria-hidden="true">
    <div class="contact__log contact__log--a" data-log="a"></div>
    <div class="contact__log contact__log--b" data-log="b"></div>
    <img class="contact__printer contact__printer--back" src="/images/shell/prefooter-printer-dark.png" alt="" width="1024" height="1535" loading="lazy" decoding="async" />
    <img class="contact__printer contact__printer--front" src="/images/shell/prefooter-printer-dark.png" alt="" width="1024" height="1535" loading="lazy" decoding="async" />
    <img class="contact__kiosk" src="/images/contact/printer-kiosk.png" alt="" width="1024" height="1535" loading="lazy" decoding="async" />
  </div>

  <!-- Cover (pre-footer only): the whole block opens the start screen -->
  {embedded && (
    <a class="contact__screen contact__screen--cover" data-step="cover" href="/contact" data-go="start" data-active>
      <h2 class="contact__title t-h2">The future is calling. We think it’s you.</h2>
      <p class="contact__lead t-body">Got something brilliant, weird, or impossible in mind? We're listening. Click anywhere to break the ice.</p>
    </a>
  )}

  <!-- Start: three ways in -->
  <div class="contact__screen contact__screen--start" data-step="start" data-active={!embedded || undefined}>
    <Title class="contact__title t-h2">Welcome! Okay, we're listening. So, what's on your mind?</Title>
    <p class="contact__lead t-body">Big ideas, tiny questions, weird requests. Our circuits are open.</p>
    <div class="contact__cards">
      <a class="contact__card contact__card--light" href="#name" data-go="name">
        <span class="t-body">Start a project</span>
        <img class="contact__card-sticker" src="/images/contact/start-project.svg" alt="" width="165" height="54" style="--x: 219; --y: 65; --w: 165; --mx: 179; --my: 51" loading="lazy" />
      </a>
      <a class="contact__card" href="#message" data-go="message">
        <span class="t-body">Drop a quick word</span>
        <img class="contact__card-sticker" src="/images/contact/start-word.svg" alt="" width="148" height="140" style="--x: 254; --y: -4; --w: 148; --mx: 226; --my: -5; --mw: 131" loading="lazy" />
      </a>
      <button class="contact__card contact__card--copy" type="button" data-copy={studio.email}>
        <span class="t-body"><span data-copy-label>Just wanna copy email</span><img class="contact__smiley" src="/images/contact/start-email-smiley.svg" alt="" width="36" height="27" loading="lazy" /></span>
        <img class="contact__card-sticker" src="/images/contact/start-email.svg" alt="" width="152" height="66" style="--x: 244; --y: 65; --w: 152; --mx: 223; --my: 49; --mw: 132" loading="lazy" />
        <!-- "Email copied" (10419:6147): a pixel dinosaur runs along the card -->
        <span class="contact__dino" aria-hidden="true"><img src="/images/contact/dino.svg" alt="" width="22" height="28" /></span>
      </button>
    </div>
  </div>

  <!-- 01 Name · 02 Email · 03 Company -->
  {steps.map((s) => (
    <form class="contact__screen contact__screen--step" data-step={s.id} action="#" novalidate>
      <p class="contact__count t-body">[{s.n}]</p>
      <h2 class="contact__title t-h2">{s.title}</h2>
      <p class="contact__lead t-body">{s.lead}</p>
      <div class="contact__field">
        <label class="visually-hidden" for={`contact-${s.id}`}>{s.field}</label>
        <input class="contact__input t-body" id={`contact-${s.id}`} type={s.type} name={s.id} placeholder={s.field} autocomplete={s.auto} autocapitalize={s.cap} autocorrect="off" spellcheck="false" enterkeyhint="next" />
        <p class="contact__error" role="alert" data-error></p>
        <button class="contact__next" type="submit" aria-label="Next"><Icon name="next" /></button>
      </div>
      <a class="contact__back t-button" href={`#${s.back}`} data-go={s.back}>Go back <Icon name="undo" /></a>
      <img class="contact__sticker" src="/images/contact/step-globe.svg" alt="" width="277" height="277" loading="lazy" />
    </form>
  ))}

  <!-- 04 Mission -->
  <form class="contact__screen contact__screen--step contact__screen--mission" data-step="mission" action="#" novalidate>
    <p class="contact__count t-body">[04]</p>
    <h2 class="contact__title t-h2">What’s the mission?</h2>
    <p class="contact__lead t-body">Select what you need. Pick as many as you like.</p>
    <fieldset class="contact__cards">
      <legend class="visually-hidden">Services</legend>
      {services.map((s) => (
        <label class="contact__card contact__card--check">
          <input type="checkbox" name="services" value={s.label} />
          <span class="t-body">{s.label}</span>
          <img class="contact__card-sticker" src={`/images/contact/${s.sticker}.svg`} alt="" width={s.w} height={s.h} style={`--x: ${s.x}; --y: ${s.y}; --w: ${s.w}`} loading="lazy" />
        </label>
      ))}
    </fieldset>
    <p class="contact__error contact__error--send" role="alert" data-error></p>
    <input class="contact__trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <a class="contact__back t-button" href="#company" data-go="company">Go back <Icon name="undo" /></a>
    <button class="contact__submit t-button" type="submit" data-send="project">Submit <Icon name="hex" /></button>
  </form>

  <!-- Quick word -->
  <!-- Quick word (10419:6404): title, lead, the field with Submit under its right end -->
  <form class="contact__screen contact__screen--message" data-step="message" action="#" novalidate>
    <h2 class="contact__title t-h2">We’re all ears. Well, sort of. Drop your message below</h2>
    <p class="contact__lead t-body">Big idea, random thought, or just a hello? We’re programmed to care.</p>
    <div class="contact__field">
      <label class="visually-hidden" for="contact-message">Your message</label>
      <textarea class="contact__input contact__textarea t-body" id="contact-message" name="message" rows="1" autocapitalize="sentences" placeholder="Don’t overthink it. Just type away..."></textarea>
      <p class="contact__error" role="alert" data-error></p>
      <button class="contact__next contact__next--submit t-button" type="submit" data-send="message">Submit <Icon name="hex" /></button>
    </div>
    <input class="contact__trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <a class="contact__back t-button" href="#start" data-go="start">Go back <Icon name="undo" /></a>
  </form>

  <!-- Done -->
  <div class="contact__screen contact__screen--done" data-step="done">
    <h2 class="contact__title t-h2">Beep boop. We got you.</h2>
    <p class="contact__lead t-body">Your message has landed safely. Our humans are on it. Our robots are pretending to help.</p>
  </div>

  <!-- Quick word sent (10419:6622) -->
  <div class="contact__screen contact__screen--done" data-step="sent">
    <h2 class="contact__title t-h2">Hey, thanks for saying hi.</h2>
    <p class="contact__lead t-body">Your message is on its way to a real human. We like those around here.</p>
  </div>

  <script type="application/json" data-logs set:html={JSON.stringify(logs)} />
</section>

<script>
  type Group = { x: number; y: number; n?: string; lines: string[]; m?: [number, number] };
  type Logs = Record<string, { a: Group[]; b?: Group[] }>;

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const phone = matchMedia('(max-width: 1023px)');

  /** The faint mono log in one box: shows a screen's groups and types them out line by
   *  line while the block is on screen; once done it rests, then rewrites a few lines. */
  function typewriter(box: HTMLElement) {
    let lines: HTMLElement[] = [];
    let queue: HTMLElement[] = [];
    let line: HTMLElement | undefined;
    let pos = 0;
    let rest = 0;
    let timer = 0;
    let visible = false;

    const tick = () => {
      if (rest > 0) return void rest--;
      if (!line) {
        line = queue.shift();
        pos = 0;
        if (!line) {
          // all written: rest ~4s, then clear and rewrite three random lines
          rest = 100;
          queue = [...lines].sort(() => Math.random() - 0.5).slice(0, 3);
          queue.forEach((l) => (l.textContent = ''));
          return;
        }
      }
      const full = line.dataset.text ?? '';
      pos = Math.min(full.length, pos + 2 + Math.floor(Math.random() * 3));
      line.textContent = full.slice(0, pos);
      line.classList.add('is-typing');
      if (pos >= full.length) {
        line.classList.remove('is-typing');
        line = undefined;
        rest = 1 + Math.floor(Math.random() * 4);
      }
    };
    const run = () => {
      clearInterval(timer);
      if (visible && !reduced) timer = window.setInterval(tick, 40);
    };
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      run();
    }).observe(box);

    return (groups: Group[] = []) => {
      box.replaceChildren(
        ...groups.map((g) => {
          const el = document.createElement('div');
          el.className = 'contact__group' + (g.m ? '' : ' contact__group--desktop');
          el.style.cssText = `--x:${g.x}%;--y:${g.y}%` + (g.m ? `;--mx:${g.m[0]}%;--my:${g.m[1]}%` : '');
          if (g.n) {
            const n = document.createElement('span');
            n.textContent = g.n;
            el.append(n);
          }
          const col = document.createElement('span');
          col.className = 'contact__lines';
          for (const text of g.lines) {
            const l = document.createElement('span');
            l.className = 'contact__line';
            l.dataset.text = text;
            l.textContent = reduced ? text : '';
            col.append(l);
          }
          el.append(col);
          return el;
        }),
      );
      // groups hidden on this screen size are skipped
      lines = [...box.querySelectorAll<HTMLElement>('.contact__line')].filter((l) => !phone.matches || l.closest('.contact__group:not(.contact__group--desktop)'));
      queue = [...lines];
      line = undefined;
      rest = 0;
      run();
    };
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-contact]')) {
    const embedded = root.dataset.contact === 'embedded';
    const screens = [...root.querySelectorAll<HTMLElement>('.contact__screen')];
    const logs: Logs = JSON.parse(root.querySelector('[data-logs]')?.textContent ?? '{}');
    const write = { a: typewriter(root.querySelector('[data-log=a]')!), b: typewriter(root.querySelector('[data-log=b]')!) };
    const field = (id: string) => root.querySelector<HTMLInputElement | HTMLTextAreaElement>(`#contact-${id}`)!;
    const value = (id: string) => field(id)?.value.trim() ?? '';
    const chosen = () => [...root.querySelectorAll<HTMLInputElement>('input[name=services]:checked')].map((i) => i.value);

    /** The log groups of `step`, with what the visitor has typed filled in */
    const fill = (groups: Group[] = []) => {
      const data: Record<string, string> = {
        name: value('name'),
        email: value('email'),
        company: value('company'),
        services: chosen().join(' / '),
      };
      return groups.map((g) => ({
        ...g,
        lines: g.lines.map((l) => l.replace(/\{(\w+)\}/g, (_, k) => (data[k] || '—').toUpperCase())),
      }));
    };

    /** Shows screen `step` (the first one for an empty / unknown step) */
    function show(step: string, focus = true) {
      const target = screens.find((s) => s.dataset.step === step) ?? screens[0];
      const id = target.dataset.step!;
      if (root.dataset.step !== id || !root.dataset.shown) {
        root.dataset.step = id;
        root.dataset.shown = 'true';
        for (const s of screens) {
          s.toggleAttribute('data-active', s === target);
          s.inert = s !== target;
        }
        write.a(fill(logs[id]?.a));
        write.b(fill(logs[id]?.b));
        tuckNav();
      }
      if (focus) target.querySelector<HTMLElement>('.contact__input')?.focus({ preventScroll: true });
    }

    // On desktop the fixed menu pill would sit over Submit: while a form screen of the
    // block fills most of the window, the pill (and Get in touch) tuck away
    let inView = false;
    let tucked = false;
    const tuckNav = () => {
      const want = inView && !phone.matches && !['cover', 'start'].includes(root.dataset.step!);
      if (want === tucked) return;
      tucked = want;
      if (want) document.documentElement.dataset.nav = 'hidden';
      else delete document.documentElement.dataset.nav;
    };
    new IntersectionObserver(
      ([entry]) => {
        inView = entry.intersectionRatio >= 0.6;
        tuckNav();
      },
      { threshold: [0, 0.6, 1] },
    ).observe(root);

    /** Goes to `step`: on /contact through the URL hash (so Back works), in the block in place */
    function go(step: string) {
      if (embedded) return show(step);
      const hash = step === 'start' ? '' : `#${step}`;
      if (location.hash === hash || (!hash && !location.hash)) show(step);
      else location.hash = hash;
    }

    if (embedded) {
      show('cover', false);
      // other places on the page can open a step: dispatch "contact:show" with its name
      root.addEventListener('contact:show', (e) => show((e as CustomEvent<string>).detail));
    } else {
      show(location.hash.slice(1), false);
      addEventListener('hashchange', () => show(location.hash.slice(1)));
    }

    // Cover, cards, Go back: data-go switches screens
    root.addEventListener('click', (e) => {
      const link = (e.target as Element).closest<HTMLElement>('[data-go]');
      if (!link) return;
      e.preventDefault();
      go(link.dataset.go!);
    });
    // Esc steps back
    root.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const back = root.querySelector<HTMLElement>('.contact__screen[data-active] .contact__back');
      if (back) go(back.dataset.go!);
      else if (embedded && root.dataset.step === 'start') go('cover');
    });

    // Errors: orange line and message under the field, cleared as soon as they type
    const setError = (form: HTMLElement, text: string) => {
      const out = form.querySelector<HTMLElement>('[data-error]');
      if (out) out.textContent = text;
      form.classList.toggle('has-error', !!text);
    };
    const check: Record<string, () => string> = {
      name: () => {
        const v = value('name');
        if (!v) return 'Please tell us your name';
        if (/\d/.test(v)) return 'Name can’t contain numbers';
        return '';
      },
      email: () => {
        const v = value('email');
        if (!v) return 'Where should we write back?';
        if (!v.includes('@')) return 'Email is missing an @';
        if (!EMAIL_RE.test(v)) return 'That email doesn’t look right';
        return '';
      },
      company: () => '',
      message: () => (value('message') ? '' : 'Write a few words first'),
    };
    const nextOf: Record<string, string> = { name: 'email', email: 'company', company: 'mission' };

    for (const form of root.querySelectorAll<HTMLFormElement>('form')) {
      const step = form.dataset.step!;
      const input = form.querySelector<HTMLInputElement | HTMLTextAreaElement>('.contact__input');
      // the arrow is dimmed until there is something to send on
      const sync = () => form.classList.toggle('is-filled', !!input?.value.trim());
      // autofill may fill the field without an input event: check on change and on load too
      input?.addEventListener('change', sync);
      setTimeout(sync, 600);
      input?.addEventListener('input', () => {
        sync();
        if (form.classList.contains('has-error')) setError(form, '');
        if (input instanceof HTMLTextAreaElement) {
          input.style.height = 'auto';
          input.style.height = `${input.scrollHeight}px`;
        }
      });
      // Enter in the message adds a line; Cmd/Ctrl+Enter sends
      if (input instanceof HTMLTextAreaElement) {
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) form.requestSubmit();
        });
      }
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (nextOf[step]) {
          const err = check[step]();
          setError(form, err);
          if (err) return input?.focus({ preventScroll: true });
          go(nextOf[step]);
        } else {
          send(form);
        }
      });
    }

    // Mission cards: the log picks up the choice
    root.querySelectorAll<HTMLInputElement>('input[name=services]').forEach((box) =>
      box.addEventListener('change', () => {
        root.querySelectorAll<HTMLElement>('[data-log=a] .contact__line[data-text^="SELECTED:"]').forEach(
          (d) => (d.dataset.text = d.textContent = `SELECTED: ${(chosen().join(' / ') || '—').toUpperCase()}`),
        );
      }),
    );

    // "Just wanna copy email": puts the address on the clipboard, the card says "Email
    // copied" while the pixel dinosaur runs across it once (1.4s), then the card is back
    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      const label = btn.querySelector<HTMLElement>('[data-copy-label]');
      const text = label?.textContent;
      let timer = 0;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy!);
        } catch {
          // no clipboard access (old browser / not https): open the mail app instead
          location.href = `mailto:${btn.dataset.copy}`;
          return;
        }
        if (label) label.textContent = 'Email copied';
        // a second click restarts the run
        btn.classList.remove('is-copied');
        void btn.offsetWidth;
        btn.classList.add('is-copied');
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          if (label) label.textContent = text!;
          btn.classList.remove('is-copied');
        }, 1500);
      });
    });

    /** Sends the project brief or the quick word; a missing answer opens its step */
    async function send(form: HTMLFormElement) {
      const button = form.querySelector<HTMLButtonElement>('[data-send]')!;
      if (button.ariaBusy === 'true') return;
      const type = button.dataset.send as 'project' | 'message';
      let body: Record<string, unknown>;
      if (type === 'project') {
        for (const step of ['name', 'email']) {
          const err = check[step]();
          if (err) {
            const target = root.querySelector<HTMLElement>(`form[data-step=${step}]`)!;
            setError(target, err);
            return go(step);
          }
        }
        body = { type, name: value('name'), email: value('email'), company: value('company'), services: chosen() };
      } else {
        const err = check.message();
        setError(form, err);
        if (err) return;
        body = { type, message: value('message') };
      }
      body.page = location.pathname;
      body.website = form.querySelector<HTMLInputElement>('.contact__trap')?.value;

      button.ariaBusy = 'true';
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (!res.ok) throw new Error((await res.json().catch(() => null))?.error ?? 'Something went wrong');
        setError(form, '');
        go(type === 'message' ? 'sent' : 'done');
        // the done screen's log has used the answers; now the forms can be cleared
        root.querySelectorAll<HTMLFormElement>('form').forEach((f) => {
          f.reset();
          f.classList.remove('is-filled');
        });
      } catch (err) {
        setError(form, `Couldn’t send: ${(err as Error).message}. Please try again or email info@hellorobo.co`);
      } finally {
        button.ariaBusy = 'false';
      }
    }
  }
</script>

<style>
  /* Figma 1728×949, black. All positions are Figma px (var(--px) = 1/1728 of the width) */
  .contact {
    --ease-move: cubic-bezier(0.65, 0, 0.35, 1);
    position: relative;
    width: 100%;
    aspect-ratio: 1728 / 949;
    background: var(--color-black);
    color: var(--color-white);
    overflow: hidden;
  }
  /* On /contact it's the whole page */
  .contact:not(.contact--embedded) {
    min-height: 100vh;
    min-height: 100svh;
  }
  .contact__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* ── System log: the mono text behind the printers ── */
  .contact__log {
    position: absolute;
    left: calc(var(--lx) * var(--px));
    top: calc(var(--ly) * var(--px));
    width: calc(1319 * var(--px));
    height: calc(771 * var(--px));
    font-family: var(--font-mono);
    font-size: calc(15 * var(--px));
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.02em;
    color: var(--color-white);
    opacity: 0.4;
    white-space: nowrap;
    /* a little out of focus, like the far printer */
    filter: blur(max(1px, calc(1.6 * var(--px))));
    transition:
      left 0.9s var(--ease-move),
      top 0.9s var(--ease-move),
      opacity 0.5s ease;
  }
  /* cover and start: Figma 338, 376; the form screens: 800, 321 */
  .contact__log--a {
    --lx: 338;
    --ly: 376;
  }
  .contact:is([data-step='name'], [data-step='email'], [data-step='company'], [data-step='mission'], [data-step='done'], [data-step='sent']) .contact__log--a {
    --lx: 800;
    --ly: 321;
  }
  /* a second log, bottom left, only once it's sent */
  .contact__log--b {
    --lx: -82;
    --ly: 475;
    opacity: 0;
  }
  .contact:is([data-step='done'], [data-step='sent']) .contact__log--b {
    opacity: 0.4;
  }
  .contact__log :global(.contact__group) {
    position: absolute;
    left: var(--x);
    top: var(--y);
