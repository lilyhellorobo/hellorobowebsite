    gap: 2.2em;
  }
  .contact__log :global(.contact__lines) {
    display: flex;
    flex-direction: column;
  }
  /* each line keeps its height while empty, so groups don't jump as they type */
  .contact__log :global(.contact__line) {
    min-height: 1.3em;
  }
  .contact__log :global(.contact__line.is-typing)::after {
    content: '_';
    animation: contact-blink 0.8s steps(1) infinite;
  }
  @keyframes contact-blink {
    50% {
      opacity: 0;
    }
  }

  /* ── Printers: the sharp one, a blurred mirrored one far left, and the kiosk with the
     receipt on the form screens ── */
  .contact__printer,
  .contact__kiosk {
    position: absolute;
    max-width: none;
    height: auto;
    transition:
      left 0.9s var(--ease-move),
      top 0.9s var(--ease-move),
      width 0.9s var(--ease-move),
      opacity 0.6s ease,
      translate 0.9s var(--ease-move);
  }
  .contact__printer--front {
    left: calc(642 * var(--px));
    top: calc(-352 * var(--px));
    width: calc(1009 * var(--px));
  }
  .contact__printer--back {
    left: calc(-430 * var(--px));
    top: calc(91 * var(--px));
    width: calc(796 * var(--px));
    transform: scaleX(-1);
    filter: blur(calc(14 * var(--px)));
  }
  .contact:is([data-step='start'], [data-step='message']) .contact__printer--front {
    left: calc(900 * var(--px));
    top: calc(-280 * var(--px));
    width: calc(796 * var(--px));
  }
  .contact:is([data-step='start'], [data-step='message']) .contact__printer--back {
    left: calc(-659 * var(--px));
    top: calc(67 * var(--px));
  }
  .contact__kiosk {
    left: calc(762 * var(--px));
    top: calc(-342 * var(--px));
    width: calc(890 * var(--px));
    opacity: 0;
    translate: 0 calc(-80 * var(--px));
  }
  /* the form screens swap the printers for the kiosk printing the receipt */
  .contact:not([data-step='cover'], [data-step='start'], [data-step='message']) .contact__printer {
    opacity: 0;
  }
  .contact:not([data-step='cover'], [data-step='start'], [data-step='message']) .contact__printer--front {
    translate: 0 calc(-80 * var(--px));
  }
  .contact:not([data-step='cover'], [data-step='start'], [data-step='message']) .contact__kiosk {
    opacity: 1;
    translate: none;
  }

  /* ── Screens: one at a time, fading over each other ── */
  .contact__screen {
    position: absolute;
    inset: 0;
    z-index: var(--z-raised);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(30 * var(--px));
    padding: var(--space-40);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.45s ease,
      visibility 0s linear 0.45s;
  }
  .contact__screen[data-active] {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s ease 0.15s;
  }
  /* the words rise in a little after the screen appears */
  .contact__screen > * {
    transition: translate 0.7s var(--ease-move);
  }
  .contact__screen:not([data-active]) > :is(.contact__count, .contact__title, .contact__lead, .contact__cards, .contact__field) {
    translate: 0 calc(24 * var(--px));
  }

  .contact__title {
    width: calc(844 * var(--px));
    max-width: 100%;
  }
  .contact__lead {
    width: calc(442 * var(--px));
    max-width: 100%;
  }
  .contact__screen--start .contact__title {
    width: calc(1020 * var(--px));
  }
  .contact__screen--start .contact__lead {
    width: calc(402 * var(--px));
  }

  /* Form screens: [01] at 40, title at 94, lead 30 under it (Figma) */
  .contact__screen--step,
  .contact__screen--done {
    gap: 0;
  }
  .contact__screen--step .contact__title,
  .contact__screen--done .contact__title {
    width: calc(680 * var(--px));
    margin-top: calc(30 * var(--px));
  }
  .contact__screen--step .contact__lead {
    width: calc(402 * var(--px));
    margin-top: calc(30 * var(--px));
  }
  .contact__screen--done .contact__title {
    margin-top: calc(54 * var(--px));
  }
  .contact__screen--done .contact__lead {
    width: calc(378 * var(--px));
    margin-top: calc(30 * var(--px));
  }

  /* ── Cards (start screen and mission): 402×140, 10 apart, from y 350 / 288 ── */
  .contact__cards {
    position: absolute;
    left: var(--space-40);
    top: calc(350 * var(--px));
    display: grid;
    gap: calc(10 * var(--px));
    margin: 0;
    padding: 0;
    border: 0;
  }
  .contact__screen--mission .contact__cards {
    top: calc(288 * var(--px));
  }
  /* flex, top-left: a <button> (the copy card) would otherwise centre its label vertically */
  .contact__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    width: calc(402 * var(--px));
    height: calc(140 * var(--px));
    padding: calc(20 * var(--px));
    overflow: hidden;
    background: rgb(255 255 255 / 0.1);
    -webkit-backdrop-filter: blur(calc(20 * var(--px)));
    backdrop-filter: blur(calc(20 * var(--px)));
    color: var(--color-white);
    text-align: left;
    font: inherit;
    border: 0;
    border-radius: 0;
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }
  .contact__card--light,
  .contact__card--check:has(input:checked) {
    background: var(--color-white);
    color: var(--color-black);
  }
  /* hover only with a mouse — on a phone it would stay "stuck" after the tap (a deselected
     mission card would keep looking half-selected); a tap gets a press state instead */
  @media (hover: hover) {
    .contact__card:hover {
      background: rgb(255 255 255 / 0.18);
    }
    .contact__card--light:hover,
    .contact__card--check:has(input:checked):hover {
      background: var(--color-grey-100);
    }
    .contact__card:hover .contact__card-sticker {
      rotate: -4deg;
    }
    .contact__back:hover {
      background: var(--color-grey-600);
    }
    .contact__submit:hover,
    .is-filled .contact__next:hover {
      background: var(--color-grey-100);
    }
  }
  .contact__card:active {
    background: rgb(255 255 255 / 0.18);
  }
  .contact__card--light:active,
  .contact__card--check:has(input:checked):active {
    background: var(--color-grey-100);
  }

  /* Phone browser defaults off: the blue / grey tap flash, double-tap zoom delay, iOS
     input and button styling, long-press text selection / image menu on the controls */
  .contact :is(a, button, label, input, textarea) {
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .contact :is(.contact__input, button) {
    -webkit-appearance: none;
    appearance: none;
