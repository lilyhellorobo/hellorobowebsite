  }
  .contact__screen--message .contact__title {
    width: calc(1009 * var(--px));
  }
  .contact__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  /* ── Buttons along the bottom: Go back (left), Submit right beside it (196 wide, x 247) ── */
  .contact__back,
  .contact__submit {
    position: absolute;
    bottom: calc(60 * var(--px));
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: calc(196 * var(--px));
    min-width: 150px;
    height: var(--button-height);
    padding: 0 var(--space-16);
    border: 0;
    border-radius: var(--radius-ui);
    font: inherit;
