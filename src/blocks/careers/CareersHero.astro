---
/**
 * Careers — Hero
 * Figma: "Frame 2147232979" (10100:14718), 1728×1026, black
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10100-14718
 */
import { Image } from 'astro:assets';
import strip from '../../assets/careers/team-strip.png';
import CrtScreen from '../../components/ui/CrtScreen.astro';
---
<section class="careers-hero theme-dark">
  <h1 class="careers-hero__title t-h1 container">Careers</h1>
  <img class="careers-hero__stamp careers-hero__stamp--hello" src="/images/careers/stamp-hello.svg" alt="" width="332" style="--w: 332" height="172" />
  <img class="careers-hero__stamp careers-hero__stamp--nature" src="/images/careers/stamp-human-nature.svg" alt="" width="412" style="--w: 412" height="80" />
  <p class="careers-hero__text t-body">
    We design for robots, yet we show up as humans first — for each other and the community. Because in the end it was always the humans who made the world say yes to your robot.
  </p>
  <div class="careers-hero__strip" data-careers-strip>
    <Image src={strip} alt="Hello Robo team at work and at events" widths={[2204, 4408]} sizes="128vw" loading="eager" />
    <CrtScreen />
  </div>
</section>

<script>
  // Photo strip: slides horizontally with the page scroll, eased so it trails the
  // scroll softly. 0 at the top of the page → 1 once the hero has scrolled away.
  const strip = document.querySelector<HTMLElement>('[data-careers-strip]');
  const hero = strip?.closest<HTMLElement>('section');
  if (strip && hero && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let shown = 0;
    let frame = 0;
    const target = () => Math.min(1, Math.max(0, -hero.getBoundingClientRect().top / hero.offsetHeight));
    const tick = () => {
      const t = target();
      shown += (t - shown) * 0.12;
      if (Math.abs(t - shown) < 0.0005) shown = t;
      strip.style.setProperty('--shift', shown.toFixed(4));
      frame = shown === t ? 0 : requestAnimationFrame(tick);
    };
    const kick = () => {
      if (!frame) frame = requestAnimationFrame(tick);
    };
    window.addEventListener('scroll', kick, { passive: true });
    window.addEventListener('resize', kick);
    kick();
  }
</script>

<style>
  /* Positions are % of the 1728×1026 frame */
  .careers-hero {
    position: relative;
    aspect-ratio: 1728 / 1026;
    overflow: hidden;
  }
  .careers-hero__title {
    padding-top: var(--space-40);
  }
  .careers-hero__stamp {
    position: absolute;
    height: auto;
  }
  .careers-hero__stamp--hello {
    left: calc(29 / 1728 * 100%);
    top: calc(588 / 1026 * 100%);
    width: calc(332 / 1728 * 100%);
  }
  .careers-hero__stamp--nature {
    left: calc(406 / 1728 * 100%);
    top: calc(654 / 1026 * 100%);
    width: calc(412 / 1728 * 100%);
  }
  .careers-hero__text {
    position: absolute;
    left: calc(1006 / 1728 * 100%);
    /* Anchored by its bottom (746 in Figma) so longer wraps grow upwards, never into the strip */
    bottom: calc((1026 - 746) / 1026 * 100%);
    width: calc(680 * var(--px));
  }
  /* 8 photos, 2204 wide, starting calc(236 * var(--px)) off the left edge. As the page
     scrolls from the hero to the next block, the strip glides left (--shift 0 → 1) until
     the photos hidden past the right edge come in: --travel = 240 / 2204 of its width */
  .careers-hero__strip {
    position: absolute;
    left: calc(-236 / 1728 * 100%);
    top: calc(786 / 1026 * 100%);
    width: calc(2204 / 1728 * 100%);
    --shift: 0;
    --travel: 10.9%;
    transform: translate3d(calc(var(--shift) * var(--travel) * -1), 0, 0);
    will-change: transform;
    overflow: hidden; /* the CRT shader (CrtScreen) covers the strip */
  }
  .careers-hero__strip :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-width: none;
  }

  /* ── Mobile: everything in flow — title, stamps, text, then the photo strip ── */
  @media (max-width: 1023px) {
    /* One screen tall: the title at the top, the rest stacked at the bottom — the free
       space (at least 96) between the title and the stickers */
    .careers-hero {
      aspect-ratio: auto;
      min-height: 100vh;
      min-height: 100svh;
      /* the strip ends 24 above the fixed menu pill */
      padding-bottom: calc(var(--page-margin) + var(--nav-height) + 24px);
      display: grid;
      grid-template-columns: auto auto minmax(0, 1fr);
      grid-template-rows: auto minmax(96px, 1fr) auto auto auto;
      align-items: center;
    }
    .careers-hero__title,
    .careers-hero__text,
    .careers-hero__strip {
      grid-column: 1 / -1;
    }
    .careers-hero__title {
      grid-row: 1;
    }
    .careers-hero__stamp {
      grid-row: 3;
    }
    .careers-hero__text {
      grid-row: 4;
    }
    .careers-hero__strip {
      grid-row: 5;
      justify-self: start;
    }
    .careers-hero__title {
      padding-top: var(--space-20);
    }
    .careers-hero__stamp,
    .careers-hero__text,
    .careers-hero__strip {
      position: static;
    }
    /* The two stickers side by side, centred on each other, just above the text */
    .careers-hero__stamp--hello {
      width: 136px;
      margin-left: var(--page-margin);
    }
    .careers-hero__stamp--nature {
      width: 190px;
      margin-left: var(--space-16);
    }
    .careers-hero__text {
      bottom: auto;
      width: auto;
      margin: var(--space-24) var(--page-margin) 0;
    }
    /* the strip at 2/3 size (116 tall); most of it is off screen, so it travels further as
       the page scrolls */
    .careers-hero__strip {
      position: relative;
      top: auto;
      left: auto;
      width: 1470px;
      margin: 64px 0 0 -120px;
      --travel: 40%;
    }
  }
</style>
