---
/**
 * Careers — Hero
 * Figma: "Frame 2147232979" (10100:14718), 1728×1026, black
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10100-14718
 */
import { Image } from 'astro:assets';
import strip from '../../assets/careers/team-strip.png';
---
<section class="careers-hero theme-dark">
  <h1 class="careers-hero__title t-h1 container">Careers</h1>
  <img class="careers-hero__stamp careers-hero__stamp--hello" src="/images/careers/stamp-hello.svg" alt="" width="332" style="--w: 332" height="172" />
  <img class="careers-hero__stamp careers-hero__stamp--nature" src="/images/careers/stamp-human-nature.svg" alt="" width="412" style="--w: 412" height="80" />
  <p class="careers-hero__text t-body">
    We design for robots, yet we show up as humans first — for each other and the community. Because in the end it was always the humans who made the world say yes to your robot.
  </p>
  <div class="careers-hero__strip">
    <Image src={strip} alt="Hello Robo team at work and at events" widths={[2204, 4408]} sizes="128vw" loading="eager" />
  </div>
</section>

<style>
  /* Positions are % of the 1728×1026 frame */
  .careers-hero {
    position: relative;
    aspect-ratio: 1728 / 1026;
    overflow: hidden;
  }
  .careers-hero__title {
    padding-top: var(--space-40);
  }
  .careers-hero__stamp {
    position: absolute;
    height: auto;
  }
  .careers-hero__stamp--hello {
    left: calc(29 / 1728 * 100%);
    top: calc(588 / 1026 * 100%);
    width: calc(332 / 1728 * 100%);
  }
  .careers-hero__stamp--nature {
    left: calc(406 / 1728 * 100%);
    top: calc(654 / 1026 * 100%);
    width: calc(412 / 1728 * 100%);
  }
  .careers-hero__text {
    position: absolute;
    left: calc(1006 / 1728 * 100%);
    /* Anchored by its bottom (746 in Figma) so longer wraps grow upwards, never into the strip */
    bottom: calc((1026 - 746) / 1026 * 100%);
    width: calc(680 * var(--px));
  }
  /* 8 photos, 2204 wide, starting calc(236 * var(--px)) off the left edge */
  .careers-hero__strip {
    position: absolute;
    left: calc(-236 / 1728 * 100%);
    top: calc(786 / 1026 * 100%);
    width: calc(2204 / 1728 * 100%);
  }
  .careers-hero__strip :global(img) {
    width: 100%;
    height: auto;
    max-width: none;
  }

  /* ── Mobile: everything in flow — title, stamps, text, then the photo strip at half size ── */
  @media (max-width: 767px) {
    .careers-hero {
      aspect-ratio: auto;
      padding-bottom: 64px;
    }
    .careers-hero__title {
      padding-top: var(--space-20);
    }
    .careers-hero__stamp,
    .careers-hero__text,
    .careers-hero__strip {
      position: static;
    }
    .careers-hero__stamp--hello {
      width: 166px;
      margin: 164px var(--page-margin) 0;
    }
    .careers-hero__stamp--nature {
      width: 206px;
      margin: var(--space-24) var(--page-margin) 0;
    }
    .careers-hero__text {
      bottom: auto;
      width: auto;
      margin: 64px var(--page-margin) 0;
    }
    .careers-hero__strip {
      width: 1102px;
      margin: 64px 0 0 -118px;
    }
  }
</style>
