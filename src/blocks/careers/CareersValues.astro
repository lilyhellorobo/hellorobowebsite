---
/**
 * Careers — Values
 * Figma: "Frame 2147232837" (10100:14871) intro + value 01; values 02 / 03 in Sandbox 3.0
 * (9457:5217 Care, 9457:5246 Craft), each 1728×1107.
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10100-14871
 *
 * The value part pins to the screen; one screen of scrolling per value. Laid out, typed and
 * moving exactly like the Services block: the progress line on top (its bright segment
 * grows through the values), the kanji as the orange label (H3), the value's name as the
 * title (H1) 20 below it, and the description anchored to the bottom of the column, on
 * the robot's bottom edge. The label and title slide out of their masks and the next
 * value's slide in, in the direction you scroll; the description has the site's body-copy
 * fade instead (its words light up from dim, one after another, as text-reveal.ts). The robot is the same for every value (marked
 * "3d web gl"), so it stays; it fills the right column like the Services pictures.
 * Motion: tokens in tokens.css (--ease-out, --duration-*, --stagger).
 */
import { Image } from 'astro:assets';
import WebGLSlot from '../../components/ui/WebGLSlot.astro';
import Divider from '../../components/ui/Divider.astro';
import robot from '../../assets/careers/values-robot.png';

const values = [
  {
    kanji: '好奇心',
    name: 'Curiosity',
    text: 'We ask the extra question, look past the obvious answer and stay interested in how people and machines understand each other.',
  },
  {
    kanji: '思いやり',
    name: 'Care',
    text: 'We design with consideration—for the people using the product, the team building it and the world meeting it.',
  },
  {
    kanji: '技',
    name: 'Craft',
    text: 'We believe the details do the talking. Every word, screen and movement should feel intentional.',
  },
];
const pad = (i: number) => String(i + 1).padStart(2, '0');
// Words of a sentence, each in its own mask; later words wait a little longer (capped)
/** The description's words, each with when it lights up (s): the site's body-copy fade
 *  (text-reveal.ts) — word i starts at i / n of 70% of 1.4s and takes 0.42s */
const lit = (text: string) => {
  const all = text.split(' ');
  return all.map((w, i) => ({ w, t: ((i / all.length) * 0.7 * 1.4).toFixed(3) }));
};
---
<section class="careers-values">
  <header class="careers-values__intro container">
    <img src="/images/careers/stamp-values.svg" alt="" width="149" style="--w: 149" height="152" />
    <p class="t-body">Our values</p>
    <h2 class="careers-values__statement t-h3">
      Robots are complex. Working together shouldn’t be. We stay curious, share openly and give great ideas room to grow.
    </h2>
  </header>

  <div class="careers-values__scroller" style={`--count: ${values.length}`} data-values>
    <div class="careers-values__stage container" data-active="0">
      <Divider accent class="careers-values__rule" />
      <div class="careers-values__grid">
      <div class="careers-values__text">
        <div class="careers-values__stack careers-values__copies">
          {values.map((v, i) => (
            <div class="careers-values__copy" data-index={i} data-state={i === 0 ? 'current' : 'next'} aria-hidden={i > 0 ? 'true' : undefined}>
              <p class="careers-values__kanji t-h3" lang="ja"><span class="mask"><span style="--d: 0">{v.kanji}</span></span></p>
              <h3 class="careers-values__name t-h1"><span class="mask"><span style="--d: 1">{v.name}</span></span></h3>
              <p class="careers-values__desc t-body">
                {lit(v.text).map((w, wi, all) => (
                  <><span class="careers-values__word" style={`--t: ${w.t}s`}>{w.w}</span>{wi < all.length - 1 && ' '}</>
                ))}
              </p>
            </div>
          ))}
        </div>
      </div>
      <WebGLSlot name="careers-robot" class="careers-values__media">
        <Image src={robot} alt="Hello Robo robot in front of floating receipts" widths={[816, 1632]} sizes="(min-width: 1728px) 816px, 48vw" loading="lazy" />
      </WebGLSlot>
      </div>
    </div>
  </div>
</section>

<script>
  // Pinned values, as the Services block: progress 0→1 across the block picks the value
  // and fills the line on top (--progress); each value gets data-state "past" (scrolled
  // by), "current" or "next".
  for (const root of document.querySelectorAll<HTMLElement>('[data-values]')) {
    const stage = root.querySelector<HTMLElement>('.careers-values__stage');
    const parts = [...root.querySelectorAll<HTMLElement>('.careers-values__copy')];
    const count = parts.length;
    if (!stage || !count) continue;
    let frame = 0;
    const update = () => {
      frame = 0;
      const rect = root.getBoundingClientRect();
      const travel = rect.height - stage.offsetHeight;
      const progress = travel > 0 ? Math.min(1, Math.max(0, -rect.top / travel)) : 0;
      const active = Math.min(count - 1, Math.floor(progress * count));
      stage.style.setProperty('--progress', String(progress));
      if (stage.dataset.active === String(active)) return;
      stage.dataset.active = String(active);
      parts.forEach((el) => {
        const i = Number(el.dataset.index);
        el.dataset.state = i < active ? 'past' : i === active ? 'current' : 'next';
        el.setAttribute('aria-hidden', String(i !== active));
      });
    };
    const request = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    update();
  }
</script>

<style>
  .careers-values {
    padding-top: calc(119 * var(--px));
  }
  .careers-values__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(30 * var(--px));
    text-align: center;
  }
  .careers-values__statement {
    width: calc(957 * var(--px));
    max-width: 100%;
  }

  /* One screen of scroll per value; the stage stays pinned while they pass */
  .careers-values__scroller {
    position: relative;
    height: calc(var(--count) * 100vh);
    margin-top: calc(268 * var(--px)); /* 308 in Figma, minus the stage's 40 top padding */
  }
  /* As the Services stage: the progress line 40 from the top, the text and the robot 36
     below it */
  .careers-values__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    padding-top: var(--space-40);
    --progress: 0;
  }
  /* Progress on top: a share per value, growing smoothly with the scroll (as on Services) */
  .careers-values :global(.careers-values__rule.divider--accent)::before {
    width: calc((1 + var(--progress) * (var(--count) - 1)) / var(--count) * 100%);
    transition: width var(--duration-normal) var(--ease-out);
  }
  .careers-values__grid {
    display: grid;
    grid-template-columns: 1fr calc(816 * var(--px));
    column-gap: var(--gutter);
    margin-top: calc(36 * var(--px));
  }
  .careers-values__text {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  /* All values share one cell; only the current one shows */
  .careers-values__stack {
    display: grid;
  }
  .careers-values__stack > * {
    grid-area: 1 / 1;
  }
  /* Type and places as on Services: the kanji as the orange label (H3), the name as the
     title (H1) 20 below, the description anchored to the bottom of the column */
  .careers-values__copies {
    flex: 1;
  }
  .careers-values__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 0;
  }
  .careers-values__kanji {
    color: var(--color-orange);
  }
  .careers-values__name {
    margin-top: var(--space-20);
    width: calc(818 * var(--px));
    max-width: 100%;
  }
  /* a short measure, well clear of the menu bar centred at the bottom of the screen */
  .careers-values__desc {
    margin-top: auto;
    width: calc(440 * var(--px));
    max-width: 100%;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  /* ── The description: the site's body-copy fade (text-reveal.ts) — its words light up
     from dim to full one after another, after the title; the outgoing one just fades ── */
  .careers-values__copy[data-state='current'] .careers-values__desc {
    opacity: 1;
    transition-delay: 0.12s;
  }
  .careers-values__word {
    opacity: 0.15;
  }
  .careers-values__copy[data-state='current'] .careers-values__word {
    animation: light-up 0.42s linear both;
    animation-delay: calc(0.3s + var(--t));
  }
  /* the first value waits, dim, until the block scrolls into view (headline-reveal.ts) */
  .careers-values__copy:global(.slide-wait) .careers-values__word {
    animation: none;
  }
  @keyframes light-up {
    from {
      opacity: 0.15;
    }
    to {
      opacity: 1;
    }
  }

  /* ── Text reveal: words slide up through a mask (same as Services) ── */
  .mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    /* room on every side so no letter is clipped (as on Services): the big titles' last
       letters ("y", "e") reach past their box on the right */
    padding: 0.1em 0.06em 0.14em;
    margin: -0.1em -0.06em -0.14em;
  }
  .mask > span {
    display: inline-block;
    transform: translateY(var(--y, 0));
    transition: transform var(--duration-smooth) var(--ease-out);
    transition-delay: calc(0.12s + var(--d, 0) * var(--stagger));
  }
  /* far enough that no part of a waiting word shows in the mask's extra room */
  [data-state='next'] .mask > span {
    --y: 135%;
  }
  [data-state='past'] .mask > span {
    --y: -135%;
    transition-delay: 0s;
  }

  /* ── Robot: the full right column, down to the page margin at the bottom of the screen,
     like the Services pictures; cropped (cover) to fill it ── */
  .careers-values :global(.careers-values__media) {
    width: 100%;
    height: calc(100vh - var(--space-40) - var(--line-width) - calc(36 * var(--px)) - var(--page-margin));
    background: var(--color-grey-100);
  }
  .careers-values :global(.careers-values__media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: reduce) {
    .careers-values__copy[data-state='current'] .careers-values__word {
      animation: none;
      opacity: 1;
    }
    .mask > span {
      transition-duration: 0.01s !important;
      transition-delay: 0s !important;
    }
  }

  /* ── Mobile: pinned too — text on top, the robot fills the space below,
     all above the nav pill ── */
  @media (max-width: 1023px) {
    .careers-values {
      padding-top: 164px;
    }
    .careers-values__intro {
      gap: var(--space-24);
    }
    .careers-values__intro img {
      width: 100px;
      height: auto;
    }
    .careers-values__scroller {
      height: calc(var(--count) * 100svh);
      margin-top: 164px;
    }
    /* As the Services stage on phones: the line, the label, title and description, then
       the robot filling the rest of the screen above the menu bar */
    .careers-values__stage {
      display: flex;
      flex-direction: column;
      height: 100svh;
      padding-top: var(--page-margin);
      padding-bottom: calc(var(--page-margin) + var(--nav-height) + 16px);
    }
    .careers-values__grid {
      flex: 1;
      min-height: 0;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
      row-gap: var(--space-24);
      margin-top: var(--space-20);
    }
    .careers-values__name {
      width: auto;
      margin-top: var(--space-12);
    }
    .careers-values__desc {
      width: auto;
      margin-top: var(--space-24);
    }
    .careers-values :global(.careers-values__media) {
      height: 100%;
    }
  }
</style>
