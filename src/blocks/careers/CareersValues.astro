---
/**
 * Careers — Values
 * Figma: "Frame 2147232837" (10100:14871) intro + value 01; values 02 / 03 in Sandbox 3.0
 * (9457:5217 Care, 9457:5246 Craft), each 1728×1107.
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10100-14871
 *
 * The value part pins to the screen; one screen of scrolling per value (like the
 * Services block): the kanji, label and description slide up out of a mask and the
 * next value's slide in, word by word. The tabs show the progress — the active tab is
 * black and its underline fills as you scroll through it — and jump to a value on click.
 * The robot is the same for every value (marked "3d web gl"), so it stays.
 * Motion: tokens in tokens.css (--ease-out, --duration-*, --stagger).
 */
import { Image } from 'astro:assets';
import WebGLSlot from '../../components/ui/WebGLSlot.astro';
import robot from '../../assets/careers/values-robot.png';

const values = [
  {
    kanji: '好奇心',
    name: 'Curiosity',
    text: 'We ask the extra question, look past the obvious answer and stay interested in how people and machines understand each other.',
  },
  {
    kanji: '思いやり',
    name: 'Care',
    text: 'We design with consideration—for the people using the product, the team building it and the world meeting it.',
  },
  {
    kanji: '技',
    name: 'Craft',
    text: 'We believe the details do the talking. Every word, screen and movement should feel intentional.',
  },
];
const pad = (i: number) => String(i + 1).padStart(2, '0');
// Words of a sentence, each in its own mask; later words wait a little longer (capped)
const words = (text: string, from = 0) => text.split(' ').map((w, i) => ({ w, d: Math.min(from + i, from + 10) }));
---
<section class="careers-values">
  <header class="careers-values__intro container">
    <img src="/images/careers/stamp-values.svg" alt="" width="149" style="--w: 149" height="152" />
    <p class="t-body">Our values</p>
    <h2 class="careers-values__statement t-h3">
      Robots are complex. Working together shouldn’t be. We stay curious, share openly and give great ideas room to grow.
    </h2>
  </header>

  <div class="careers-values__scroller" style={`--count: ${values.length}`} data-values>
    <div class="careers-values__stage container" data-active="0">
      <div class="careers-values__text">
        <div class="careers-values__stack">
          {values.map((v, i) => (
            <p class="careers-values__kanji t-h1" lang="ja" data-index={i} data-state={i === 0 ? 'current' : 'next'} aria-hidden={i > 0 ? 'true' : undefined}>
              <span class="mask"><span style="--d: 0">{v.kanji}</span></span>
            </p>
          ))}
        </div>
        <div class="careers-values__stack careers-values__copies">
          {values.map((v, i) => (
            <div class="careers-values__copy" data-index={i} data-state={i === 0 ? 'current' : 'next'} aria-hidden={i > 0 ? 'true' : undefined}>
              <p class="t-body"><span class="mask"><span style="--d: 1">{v.name}</span></span></p>
              <p class="t-body">
                {words(v.text, 2).map((w, wi, all) => (
                  <><span class="mask"><span style={`--d: ${w.d}`}>{w.w}</span></span>{wi < all.length - 1 && ' '}</>
                ))}
              </p>
            </div>
          ))}
        </div>
        <ol class="careers-values__tabs t-body" aria-label="Values">
          {values.map((v, i) => (
            <li class:list={['careers-values__tab', { 'is-active': i === 0 }]} data-index={i} aria-current={i === 0 ? 'true' : undefined}>
              <button type="button" aria-label={`${pad(i)} ${v.name}`}>{pad(i)}</button>
            </li>
          ))}
        </ol>
      </div>
      <WebGLSlot name="careers-robot" class="careers-values__media">
        <Image src={robot} alt="Hello Robo robot in front of floating receipts" widths={[816, 1632]} sizes="(min-width: 1728px) 816px, 48vw" loading="lazy" />
      </WebGLSlot>
    </div>
  </div>
</section>

<script>
  // Pinned values: progress 0→1 across the block picks the value; the active tab's
  // underline shows the progress through that value (--local). Tabs jump to a value.
  for (const root of document.querySelectorAll<HTMLElement>('[data-values]')) {
    const stage = root.querySelector<HTMLElement>('.careers-values__stage');
    const parts = [...root.querySelectorAll<HTMLElement>('.careers-values__kanji, .careers-values__copy')];
    const tabs = [...root.querySelectorAll<HTMLElement>('.careers-values__tab')];
    const count = tabs.length;
    if (!stage || !count) continue;
    let frame = 0;
    const update = () => {
      frame = 0;
      const rect = root.getBoundingClientRect();
      const travel = rect.height - stage.offsetHeight;
      const progress = travel > 0 ? Math.min(1, Math.max(0, -rect.top / travel)) : 0;
      const active = Math.min(count - 1, Math.floor(progress * count));
      stage.style.setProperty('--local', String(Math.min(1, progress * count - active)));
      if (stage.dataset.active === String(active)) return;
      stage.dataset.active = String(active);
      parts.forEach((el) => {
        const i = Number(el.dataset.index);
        el.dataset.state = i < active ? 'past' : i === active ? 'current' : 'next';
        el.setAttribute('aria-hidden', String(i !== active));
      });
      tabs.forEach((tab, i) => {
        tab.classList.toggle('is-active', i === active);
        if (i === active) tab.setAttribute('aria-current', 'true');
        else tab.removeAttribute('aria-current');
      });
    };
    const request = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    update();
    // Tab click: scroll to the start of that value (just inside it)
    tabs.forEach((tab, i) => {
      tab.querySelector('button')?.addEventListener('click', () => {
        const top = root.getBoundingClientRect().top + window.scrollY;
        const travel = root.offsetHeight - stage.offsetHeight;
        window.scrollTo({ top: top + travel * ((i + 0.02) / count), behavior: 'smooth' });
      });
    });
  }
</script>

<style>
  .careers-values {
    padding-top: calc(119 * var(--px));
  }
  .careers-values__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(30 * var(--px));
    text-align: center;
  }
  .careers-values__statement {
    width: calc(957 * var(--px));
    max-width: 100%;
  }

  /* One screen of scroll per value; the stage stays pinned while they pass */
  .careers-values__scroller {
    position: relative;
    height: calc(var(--count) * 100vh);
    margin-top: calc(241 * var(--px)); /* 308 in Figma, minus the stage's 67 top padding */
  }
  /* Figma value frame 1728×1107: kanji / robot at 67, tabs line on the robot's bottom edge */
  .careers-values__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr calc(816 * var(--px));
    align-items: start;
    align-content: start; /* the row is as tall as the robot, so the tabs sit on its bottom edge */
    column-gap: var(--gutter);
    padding-top: calc(67 * var(--px));
    --local: 0;
  }
  .careers-values__text {
    display: flex;
    flex-direction: column;
    align-self: stretch;
    min-height: 0;
  }
  /* All values share one cell; only the current one shows */
  .careers-values__stack {
    display: grid;
  }
  .careers-values__stack > * {
    grid-area: 1 / 1;
  }
  .careers-values__kanji {
    color: var(--color-orange);
  }
  .careers-values__copies {
    margin-top: auto;
  }
  .careers-values__copy {
    display: grid;
    gap: calc(30 * var(--px));
    width: calc(680 * var(--px));
    max-width: 100%;
  }

  /* ── Text reveal: words slide up through a mask (same as Services) ── */
  .mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  .mask > span {
    display: inline-block;
    transform: translateY(var(--y, 0));
    transition: transform var(--duration-smooth) var(--ease-out);
    transition-delay: calc(0.12s + var(--d, 0) * var(--stagger));
  }
  /* 130%: full-height kanji need to clear the mask's descender room completely */
  [data-state='next'] .mask > span {
    --y: 130%;
  }
  [data-state='past'] .mask > span {
    --y: -130%;
    transition-delay: 0s;
  }

  /* ── Tabs: the progress line ── */
  .careers-values__tabs {
    display: grid;
    grid-template-columns: repeat(3, calc(265 * var(--px)));
    gap: var(--gutter);
    margin-top: calc(120 * var(--px));
  }
  .careers-values__tab {
    position: relative;
    border-bottom: var(--line-width) solid var(--line-on-light);
  }
  .careers-values__tab button {
    width: 100%;
    padding-bottom: calc(10 * var(--px));
    text-align: center;
    color: var(--color-grey-350);
    transition: color var(--duration-normal) var(--ease-out);
  }
  .careers-values__tab.is-active button,
  .careers-values__tab button:hover {
    color: var(--color-black);
  }
  /* Active tab: the black segment fills with the scroll through that value
     (starts at Figma's 103 / 265) */
  .careers-values__tab::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: calc(var(--line-width) * -1);
    width: 0;
    border-bottom: var(--line-width) solid var(--line-strong-on-light);
    transition: width var(--duration-normal) var(--ease-out);
  }
  .careers-values__tab.is-active::after {
    width: calc(max(103 / 265, var(--local)) * 100%);
  }

  /* ── Robot: full right column, cropped (not shrunk) on short windows ── */
  .careers-values :global(.careers-values__media) {
    width: 100%;
    aspect-ratio: 816 / 973;
    max-height: calc(100vh - 2 * calc(67 * var(--px)));
    background: var(--color-grey-100);
  }
  .careers-values :global(.careers-values__media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: reduce) {
    .mask > span,
    .careers-values__tab::after {
      transition-duration: 0.01s !important;
      transition-delay: 0s !important;
    }
  }

  /* ── Mobile: pinned too — text on top, the robot fills the space below,
     all above the nav pill ── */
  @media (max-width: 767px) {
    .careers-values {
      padding-top: 164px;
    }
    .careers-values__intro {
      gap: var(--space-24);
    }
    .careers-values__intro img {
      width: 100px;
      height: auto;
    }
    .careers-values__scroller {
      height: calc(var(--count) * 100svh);
      margin-top: 164px;
    }
    .careers-values__stage {
      height: 100svh;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
      row-gap: var(--space-24);
      padding-top: var(--space-20);
      padding-bottom: calc(20px + var(--nav-height) + 20px);
    }
    .careers-values__text {
      align-self: start;
    }
    .careers-values__copies {
      margin-top: var(--space-24);
    }
    .careers-values__copy {
      gap: var(--space-12);
      width: auto;
    }
    .careers-values__tabs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: var(--space-24);
    }
    .careers-values :global(.careers-values__media) {
      height: 100%;
      aspect-ratio: auto;
      max-height: none;
    }
  }
</style>
