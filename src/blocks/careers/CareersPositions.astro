---
/**
 * Careers — Positions
 * Figma: "Frame 2147232978" (10100:14936), 1728×2687, black
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10100-14936
 * Rows come from the positions collection and link to /careers/[slug].
 */
import { getCollection } from 'astro:content';

const positions = (await getCollection('positions')).sort((a, b) => a.data.order - b.data.order);
---
<section class="careers-positions theme-dark">
  <header class="careers-positions__head container">
    <img src="/images/careers/stamp-positions.svg" alt="" width="222" style="--w: 222" height="66" />
    <h2 class="t-h1">Positions</h2>
    <p class="careers-positions__intro t-body">
      We’re hiring — and always interested in people who care about the human side of robotics. Don’t see the right role? Say hello anyway.
    </p>
  </header>

  <ul class="careers-positions__list">
    {positions.map((p) => (
      <li class="careers-positions__row">
        <a class="careers-positions__link container" href={`/careers/${p.id}`}>
          <span class="careers-positions__title">
            <span class="t-h2">{p.data.title}</span>
            {p.data.stamp && (
              <img src={p.data.stamp.src} alt="" width={p.data.stamp.w} style={`--w: ${p.data.stamp.w}`} height={p.data.stamp.h} loading="lazy" />
            )}
          </span>
          <span class="careers-positions__meta t-body">
            <span>{p.data.location}</span>
            <span>{p.data.hours}</span>
            <span>{p.data.type}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .careers-positions {
    padding-top: calc(165 * var(--px));
    padding-bottom: calc(160 * var(--px));
  }
  .careers-positions__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .careers-positions__head h2 {
    margin-top: calc(28 * var(--px));
  }
  .careers-positions__intro {
    width: calc(553 * var(--px));
    max-width: 100%;
    margin-top: var(--space-40);
  }
  .careers-positions__list {
    display: grid;
    gap: calc(100 * var(--px));
    margin-top: calc(130 * var(--px));
  }
  /* Full-bleed rule above each row, then calc(100 * var(--px)) to the title */
  .careers-positions__row {
    border-top: var(--line-width) solid var(--line-on-dark);
    padding-top: calc(100 * var(--px));
  }
  .careers-positions__link {
    display: grid;
    grid-template-columns: 1fr calc(542 / 1648 * 100%);
    align-items: start;
  }
  .careers-positions__title {
    display: flex;
    align-items: flex-start;
    gap: var(--space-20);
  }
  .careers-positions__title .t-h2 {
    max-width: calc(900 * var(--px));
  }
  .careers-positions__title img {
    flex: none;
    height: auto;
  }
  .careers-positions__meta {
    display: grid;
    grid-template-columns: calc(138 * var(--px)) calc(277 * var(--px)) 1fr;
    margin-top: calc(-5 * var(--px));
  }
  .careers-positions__link:hover .t-h2 {
    color: var(--color-orange);
  }

  /* Tablet: columns size to their words so short labels never wrap */
  @media (min-width: 768px) and (max-width: 1199px) {
    .careers-positions__meta {
      grid-template-columns: repeat(3, auto);
      justify-content: start;
      column-gap: var(--space-40);
    }
  }

  /* ── Mobile: each row stacks title over the meta line ── */
  @media (max-width: 767px) {
    .careers-positions {
      padding-top: 164px;
      padding-bottom: 164px;
    }
    .careers-positions__head img {
      width: 148px;
      height: auto;
    }
    .careers-positions__head h2 {
      margin-top: var(--space-24);
    }
    .careers-positions__intro {
      margin-top: var(--space-24);
    }
    .careers-positions__list {
      gap: 40px;
      margin-top: 64px;
    }
    .careers-positions__row {
      padding-top: 40px;
    }
    .careers-positions__link {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-24);
    }
    .careers-positions__title img {
      width: auto;
      max-width: 33%;
      max-height: 56px;
    }
    .careers-positions__meta {
      grid-template-columns: auto auto 1fr;
      gap: var(--space-16);
      margin-top: 0;
    }
  }
</style>
