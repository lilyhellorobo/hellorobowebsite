---
/**
 * Footer + contacts — Figma "footer + contacts" (10093:2045, 1728×1995).
 *   contacts (554): Menu / Studio / Mail labels (Body), rule, links + address + email (H3)
 *   footer (1441): ハローロボ wordmark graphic, Terms / logo / Privacy (Body)
 */
import RoboLogo from '../icons/RoboLogo.astro';
import FooterWordmark from './FooterWordmark.astro';
import { mainNav, studio } from '../../data/site';
---
<footer class="footer theme-dark">
  <div class="footer__contacts">
    <div class="footer__row container">
      <p class="t-body">Menu</p>
      <p class="t-body">Studio</p>
      <p class="footer__mail-label t-body">Mail</p>
    </div>
    <hr class="footer__rule" />
    <div class="footer__row container">
      <ul class="footer__nav t-h3">
        {mainNav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
      <p class="footer__city t-h3">{studio.city}<br class="only-desktop" /> {studio.region}</p>
      <a class="footer__email t-h3" href={`mailto:${studio.email}`}>{studio.email}</a>
    </div>
  </div>

  <div class="footer__bottom container">
    <FooterWordmark />
    <div class="footer__legal t-body t-body2-mobile">
      <a href="/terms">Terms of use</a>
      <RoboLogo width={121} class="footer__logo" />
      <a href="/privacy">Privacy policy</a>
    </div>
  </div>
</footer>

<style>
  .footer__contacts {
    padding-top: var(--space-40);
    padding-bottom: var(--space-60);
  }
  /* Column starts in Figma: 40 / 593 / 1009 on a 1728 frame */
  .footer__row {
    display: grid;
    grid-template-columns: 553fr 416fr 679fr;
  }
  .footer__rule {
    margin: var(--space-40) 0 var(--space-40);
    border: 0;
    border-top: var(--line-width) solid var(--line-on-dark);
  }
  .footer__row a:hover {
    color: var(--color-orange);
  }
  /* Figma "footer" frame (1441 high): wordmark at 89, legal row at 1276, 115 below */
  .footer__bottom {
    padding-top: calc(89 * var(--px));
    padding-bottom: calc(115 * var(--px));
  }
  .footer__legal {
    margin-top: calc(167 * var(--px));
    height: calc(50 * var(--px));
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .footer__legal a:last-child {
    justify-self: end;
  }
  /* Footer mark: 95×50 drawn shape = the nav logo at calc(121 * var(--px)) */
  .footer__legal :global(.footer__logo) {
    width: calc(121 * var(--px));
    height: auto;
  }

  /* ── Mobile: Figma "Frame 2147233084" (10098:2534), 390×1181 ── */
  @media (max-width: 1023px) {
    .footer {
      overflow-x: clip;
    }
    .footer__contacts {
      padding-top: 64px;
      padding-bottom: 0;
    }
    /* Two columns at 16 / 199: Menu | Studio (the email moves under the city) */
    .footer__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 8px;
    }
    .footer__row:last-child {
      grid-template-rows: auto 1fr;
    }
    .footer__mail-label {
      display: none;
    }
    .footer__rule {
      margin: var(--space-32) 0;
    }
    /* Figma uses Body at its desktop size (20) for these links on mobile */
    .footer__nav,
    .footer__city,
    .footer__email {
      font-size: 20px;
      line-height: var(--type-body-line);
      letter-spacing: var(--type-body-track);
    }
    .footer__nav {
      grid-row: span 2;
      display: grid;
      gap: var(--space-16);
    }
    .footer__city {
      grid-column: 2;
    }
    .footer__email {
      grid-column: 2;
      align-self: start;
      margin-top: var(--space-16);
    }
    /* Wordmark: the desktop graphic at half size (824 wide), centred and cropped */
    /* the legal row ends above the menu bar (64 + 20 from the bottom), not behind it */
    .footer__bottom {
      padding-top: 140px;
      padding-bottom: calc(var(--nav-height) + 20px + 40px);
    }
    .footer__bottom :global(.footer-wordmark) {
      width: calc(824 / 358 * 100%);
      max-width: none;
      margin-left: calc((358 - 824) / 2 / 358 * 100%);
    }
    .footer__legal {
      margin-top: 64px;
      height: 32px;
    }
    .footer__legal :global(.footer__logo) {
      width: 61px;
    }
  }
</style>
