---
/**
 * Footer + contacts — Figma "footer + contacts" (10093:2045, 1728×1995).
 *   contacts (554): Menu / Studio / Mail labels (Body), rule, links + address + email (H3)
 *   footer (1441): ハローロボ wordmark graphic, Terms / logo / Privacy (Body)
 */
import RoboLogo from '../icons/RoboLogo.astro';
import { mainNav, studio } from '../../data/site';
---
<footer class="footer theme-dark">
  <div class="footer__contacts">
    <div class="footer__row container">
      <p class="t-body">Menu</p>
      <p class="t-body">Studio</p>
      <p class="t-body">Mail</p>
    </div>
    <hr class="footer__rule" />
    <div class="footer__row container">
      <ul class="t-h3">
        {mainNav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
      <p class="t-h3">{studio.city}<br />{studio.region}</p>
      <a class="t-h3" href={`mailto:${studio.email}`}>{studio.email}</a>
    </div>
  </div>

  <div class="footer__bottom container">
    <img
      class="footer__wordmark"
      src="/images/shell/footer-wordmark.png"
      alt="ハローロボ — Hello Robo"
      width="1648"
      height="1020"
      loading="lazy"
      decoding="async"
    />
    <div class="footer__legal t-body">
      <a href="/terms">Terms of use</a>
      <RoboLogo width={121} class="footer__logo" />
      <a href="/privacy">Privacy policy</a>
    </div>
  </div>
</footer>

<style>
  .footer__contacts {
    padding-top: var(--space-40);
    padding-bottom: var(--space-60);
  }
  /* Column starts in Figma: 40 / 593 / 1009 on a 1728 frame */
  .footer__row {
    display: grid;
    grid-template-columns: 553fr 416fr 679fr;
  }
  .footer__rule {
    margin: var(--space-40) 0 var(--space-40);
    border: 0;
    border-top: var(--line-width) solid var(--line-on-dark);
  }
  .footer__row a:hover {
    color: var(--color-orange);
  }
  /* Figma "footer" frame (1441 high): wordmark at 89, legal row at 1276, 115 below */
  .footer__bottom {
    padding-top: 89px;
    padding-bottom: 115px;
  }
  .footer__wordmark {
    width: 100%;
    height: auto;
  }
  .footer__legal {
    margin-top: 167px;
    height: 50px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .footer__legal a:last-child {
    justify-self: end;
  }
  /* Footer mark: 95×50 drawn shape = the nav logo at 121px */
  .footer__legal :global(.footer__logo) {
    width: 121px;
    height: auto;
  }
</style>
