---
/**
 * "Get in touch" — fixed top-right (Figma hero "nav", 265×64, 40px from the top
 * and right edges, background blur). Black on light pages, white on dark pages,
 * light grey on the Position page.
 */
import Icon from '../icons/Icon.astro';

interface Props {
  variant?: 'dark' | 'light' | 'grey';
  href?: string;
}
const { variant = 'dark', href = '/contact' } = Astro.props;
---
<a class:list={['get-in-touch', `get-in-touch--${variant}`]} href={href}>
  <span class="t-button">Get in touch</span>
  <Icon name="corners" />
</a>

<style>
  .get-in-touch {
    position: fixed;
    top: var(--space-40);
    right: var(--page-margin);
    z-index: var(--z-header);
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: max(176px, calc(265 * var(--px)));
    height: max(44px, calc(64 * var(--px)));
    padding: 0 var(--space-20) 0 var(--space-24);
    border-radius: var(--radius-ui);
    backdrop-filter: blur(calc(10 * var(--px)));
    -webkit-backdrop-filter: blur(calc(10 * var(--px)));
    transition:
      opacity var(--duration-smooth) var(--ease-out),
      translate var(--duration-slow) var(--ease-out),
      visibility 0s;
  }
  /* Tucked away with the menu pill (html[data-nav='hidden'], e.g. Team while an object
     is selected): fades and slides up, comes back the same way */
  :global(html[data-nav='hidden']) .get-in-touch {
    opacity: 0;
    translate: 0 calc(-24 * var(--px));
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--duration-smooth) var(--ease-out),
      translate var(--duration-slow) var(--ease-out),
      visibility 0s linear var(--duration-slow);
  }
  .get-in-touch--dark {
    background: var(--color-black);
    color: var(--color-white);
  }
  .get-in-touch--grey {
    background: var(--color-grey-50);
    color: var(--color-black);
  }
  .get-in-touch--light {
    background: var(--color-white);
    color: var(--color-black);
  }
  /* Mobile: no header button — "Let's talk" lives in the menu overlay (Figma "menu", 10112:25477) */
  @media (max-width: 767px) {
    .get-in-touch {
      display: none;
    }
  }
</style>
