---
/**
 * Site menu overlay — Figma "1.1 menu d" (10194:165), 1728×1000
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10194-165
 *
 * Blurred backdrop (black 20% + 100px blur) and a 1094-wide block centred above
 * the nav pill: links panel (541×837) | Let's talk bar, photo card, Say hello card.
 * Opened/closed by NavPill (html[data-menu="open"]). Motion, kept minimal: the blocks rise
 * into place a beat apart (a wipe up from their bottom edge and a fade), then their contents
 * fade in together; closing, everything fades out quickly.
 * Photo card: one of the 8 studio photos (Figma "Photos", 10240:141), a different one
 * picked at random each time the menu opens (desktop; phones don't show the photo), shown
 * through Figma's CRT screen shader (CrtScreen, a WebGL port of it).
 */
import { Image } from 'astro:assets';
import Icon from '../icons/Icon.astro';
import RoboLogo from '../icons/RoboLogo.astro';
import CrtScreen from '../ui/CrtScreen.astro';
import { mainNav, socials } from '../../data/site';
import type { ImageMetadata } from 'astro';
import robot from '../../assets/menu/menu-robot.png';

// Studio photos, exported from Figma at the card's 2× size (1082×674)
const photos = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../../assets/menu/photos/*.jpg', { eager: true }),
).map((m) => m.default);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---
<div id="site-menu" class="site-menu" aria-hidden="true" inert>
  <div class="site-menu__backdrop" data-menu-backdrop></div>

  <div class="site-menu__grid" role="dialog" aria-modal="true" aria-label="Menu">
    <section class="site-menu__panel site-menu__links">
      <div class="site-menu__head">
        <RoboLogo width={82} class="site-menu__logo" />
        <p class="site-menu__ja t-body" lang="ja">私たちはHello Roboです。</p>
      </div>
      <ul class="site-menu__list">
        {mainNav.map((item) => (
          <li>
            <a class:list={['site-menu__link', 't-h3', { 'is-active': isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span>{item.label}</span>
              <svg class="site-menu__arrow" viewBox="0 0 40 40" fill="none" aria-hidden="true">
                <path d="M6 20h27M23 10l10 10-10 10" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <div class="site-menu__side">
      <a class="site-menu__talk" href="/contact">
        <span class="t-button">Let’s talk</span>
        <Icon name="corners" />
      </a>
      <div class="site-menu__panel site-menu__photo" data-menu-photos>
        {photos.map((p, i) => (
          <Image class:list={{ 'is-current': i === 0 }} src={p} alt={i === 0 ? 'The Hello Robo team' : ''} widths={[541, 1082]} sizes="(min-width: 1728px) 541px, 32vw" loading="lazy" />
        ))}
        <CrtScreen />
      </div>
      <section class="site-menu__panel site-menu__hello">
        <Image class="site-menu__robot" src={robot} alt="" widths={[541, 1082]} sizes="(min-width: 1728px) 541px, 32vw" loading="lazy" />
        <img class="site-menu__micro" src="/images/menu/menu-micrographic.svg" alt="" width="380" height="224" />
        <p class="site-menu__hello-title t-body">Say hello</p>
        <ul class="site-menu__socials t-body">
          {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
        </ul>
      </section>
    </div>
  </div>
</div>

<script>
  // A different studio photo each time the menu opens (never the same twice in a row). It is
  // chosen, loaded and drawn into the CRT screen while the menu is closed, so opening shows
  // it straight away — nothing swaps or blinks during the opening animation.
  const box = document.querySelector<HTMLElement>('[data-menu-photos]');
  const imgs = box ? [...box.querySelectorAll('img')] : [];
  if (box && imgs.length > 1) {
    const html = document.documentElement;
    let current = imgs.findIndex((i) => i.classList.contains('is-current'));
    // resolves once photo `i` has loaded (it starts loading now)
    const ready = (i: number) =>
      new Promise<void>((done) => {
        const img = imgs[i];
        img.loading = 'eager';
        if (img.complete && img.naturalWidth) return done();
        img.addEventListener('load', () => done(), { once: true });
        img.addEventListener('error', () => done(), { once: true });
      });
    const put = (i: number) => {
      imgs[current].classList.remove('is-current');
      imgs[current].alt = '';
      imgs[i].classList.add('is-current');
      imgs[i].alt = 'The Hello Robo team';
      current = i;
      box.dispatchEvent(new Event('crt:update'));
    };
    const pickNext = () => {
      const next = (current + 1 + Math.floor(Math.random() * (imgs.length - 1))) % imgs.length;
      ready(next).then(() => {
        if (html.dataset.menu !== 'open') put(next);
      });
    };
    // the first one: random, ready before the menu is ever opened (phones don't show the
    // photo, so they don't load it)
    const photoShown = () => box.offsetWidth > 0;
    if (photoShown()) pickNext();
    // after each close (once it has finished), get the next one ready
    let wasOpen = false;
    let timer = 0;
    new MutationObserver(() => {
      const open = html.dataset.menu === 'open';
      if (open === wasOpen) return;
      wasOpen = open;
      clearTimeout(timer);
      if (!open && photoShown()) timer = window.setTimeout(pickNext, 800);
    }).observe(html, { attributes: true, attributeFilter: ['data-menu'] });
  }
</script>

<style>
  .site-menu {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-nav) - 1);
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear 0.72s;
  }
  :global(html[data-menu='open']) .site-menu {
    visibility: visible;
    pointer-events: auto;
    transition: none;
  }
  /* Figma: black 20% + background blur 100 */
  .site-menu__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.2);
    backdrop-filter: blur(calc(100 * var(--px)));
    -webkit-backdrop-filter: blur(calc(100 * var(--px)));
    opacity: 0;
    transition: opacity 0.5s ease 0.05s;
  }
  :global(html[data-menu='open']) .site-menu__backdrop {
    opacity: 1;
    transition: opacity 0.4s ease;
  }

  /* 1094 wide, centred; bottom edge 12 above the nav pill; 837 tall (less if the window is short) */
  .site-menu__grid {
    position: absolute;
    left: 50%;
    bottom: calc(var(--space-40) + var(--nav-height) + var(--space-12));
    width: calc(1094 * var(--px));
    height: min(calc(837 * var(--px)), calc(100vh - var(--space-40) - var(--nav-height) - var(--space-12) - var(--space-24)));
    transform: translateX(-50%);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter);
  }
  .site-menu__panel {
    position: relative;
    border-radius: calc(4 * var(--px));
    overflow: hidden;
  }

  /* ── Motion (minimal) ──
     Blocks: wipe up from their bottom edge and fade in, a beat apart; contents fade in
     once the blocks are there. Closing mirrors it, softly: contents fade first, then the
     blocks wipe back down and fade, last-opened first. */
  .site-menu__links { --p: 0; }
  .site-menu__talk { --p: 1; }
  .site-menu__photo { --p: 2; }
  .site-menu__hello { --p: 3; }
  .site-menu__links,
  .site-menu__talk,
  .site-menu__photo,
  .site-menu__hello {
    clip-path: inset(100% 0 0 0);
    opacity: 0;
    transition:
      clip-path 0.5s cubic-bezier(0.65, 0, 0.35, 1),
      opacity 0.42s ease;
    transition-delay: calc(0.08s + (3 - var(--p)) * 0.035s);
  }
  :global(html[data-menu='open']) :is(.site-menu__links, .site-menu__talk, .site-menu__photo, .site-menu__hello) {
    clip-path: inset(0);
    opacity: 1;
    transition:
      clip-path 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease;
    transition-delay: calc(var(--p) * 0.04s);
  }
  .site-menu :is(.site-menu__head, .site-menu__list, .site-menu__talk > *, .site-menu__micro, .site-menu__hello-title, .site-menu__socials) {
    opacity: 0;
    transition: opacity 0.22s ease;
  }
  :global(html[data-menu='open']) .site-menu :is(.site-menu__head, .site-menu__list, .site-menu__talk > *, .site-menu__micro, .site-menu__hello-title, .site-menu__socials) {
    opacity: 1;
    transition: opacity 0.4s ease 0.22s;
  }

  /* ── Links panel ─────────────────────────────── */
  .site-menu__links {
    display: flex;
    flex-direction: column;
    background: var(--color-grey-50);
    padding: var(--space-16);
  }
  .site-menu__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .site-menu__ja {
    width: calc(144 * var(--px));
    margin: calc(4 * var(--px)) calc(4 * var(--px)) 0 0;
    color: var(--color-orange);
  }
  /* Rows: 58 text + 32 / rule / 32; the list sits at the bottom of the panel */
  .site-menu__list {
    margin-top: auto;
    margin-bottom: var(--space-16);
  }
  .site-menu__list li + li {
    margin-top: var(--space-32);
    padding-top: var(--space-32);
    border-top: var(--line-width) solid rgb(0 0 0 / 0.1);
  }
  .site-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--color-grey-350);
    transition: color 0.2s ease;
  }
  .site-menu__link.is-active,
  .site-menu__link:focus-visible {
    color: var(--color-black);
  }
  .site-menu__arrow {
    width: calc(40 * var(--px));
    height: calc(40 * var(--px));
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .site-menu__link.is-active .site-menu__arrow,
  .site-menu__link:focus-visible .site-menu__arrow {
    opacity: 1;
  }
  /* Hover only with a real pointer: phones keep a "hover" where the finger last touched,
     so a link that opens under that spot (e.g. Team, after swiping the Work wheel) looked
     selected like the current page */
  @media (hover: hover) and (pointer: fine) {
    .site-menu__link:hover {
      color: var(--color-black);
    }
    .site-menu__link:hover .site-menu__arrow {
      opacity: 1;
    }
    .site-menu__socials a:hover {
      color: var(--color-orange);
    }
  }

  /* ── Right column: Let's talk 64 · photo 337 · Say hello 412 (12 gaps) ── */
  .site-menu__side {
    display: grid;
    grid-template-rows: auto 337fr 412fr;
    gap: var(--gutter);
    min-height: 0;
  }
  .site-menu__talk {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: max(44px, calc(64 * var(--px)));
    padding: 0 var(--space-16) 0 var(--space-24);
    background: var(--color-black);
    color: var(--color-white);
    border-radius: var(--radius-ui);
  }
  .site-menu__photo,
  .site-menu__hello {
    min-height: 0;
    background: var(--color-white);
  }
  .site-menu__photo :global(img),
  .site-menu :global(.site-menu__robot) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The studio photos are stacked; only the current one shows (CrtScreen draws it
     through Figma's CRT shader on top) */
  .site-menu__photo :global(img:not(.is-current)) {
    visibility: hidden;
  }
  /* Micrographic 380×224 at (154, -7) on the card */
  .site-menu__micro {
    position: absolute;
    left: calc(154 / 541 * 100%);
    top: calc(-7 * var(--px));
    width: calc(380 / 541 * 100%);
    height: auto;
  }
  .site-menu__hello-title {
    position: absolute;
    left: var(--space-16);
    top: var(--space-16);
  }
  .site-menu__socials {
    position: absolute;
    left: var(--space-16);
    bottom: var(--space-16);
    display: grid;
    gap: var(--space-24);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-menu * {
      transition-duration: 0.01s !important;
      transition-delay: 0s !important;
    }
  }

  /* ── Mobile: Figma "menu" (10112:25477), 390×756 ──────────
     Let's talk (64) · links panel · Say hello card, then the bottom bar. The same 16 margin
     on all four sides and 8 between everything, on every phone height: the two panels
     share the room left (Figma's 335 : 206) and the links scale with their panel, so
     nothing is cut on short screens. No logo, Japanese line or photo. */
  @media (max-width: 1023px) {
    .site-menu__grid {
      left: var(--page-margin);
      right: var(--page-margin);
      top: var(--page-margin);
      bottom: calc(var(--page-margin) + var(--nav-height) + 8px);
      width: auto;
      height: auto;
      transform: none;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 64px minmax(0, 335fr) minmax(136px, 206fr);
      gap: 8px;
    }
    .site-menu__side {
      display: contents;
    }
    /* Phones: the blocks rise from the bottom up (Say hello, links, Let's talk), towards
       the menu bar; closing goes the other way */
    .site-menu__hello { --p: 0; }
    .site-menu__links { --p: 1; }
    .site-menu__talk { --p: 2; }
    .site-menu__talk {
      grid-row: 1;
      height: 64px;
      padding: 0 16px 0 24px;
    }
    .site-menu__links {
      grid-row: 2;
      padding: 12px 16px;
      container-type: size;
    }
    .site-menu__head,
    .site-menu__photo {
      display: none;
    }
    /* Six equal rows fill the panel, text centred between the rules: Figma's
       28 text · 12 · rule · 12 on a tall phone, tighter on a short one */
    .site-menu__list {
      flex: 1;
      display: flex;
      flex-direction: column;
      margin: 0;
    }
    .site-menu__list li,
    .site-menu__list li + li {
      flex: 1;
      display: flex;
      align-items: center;
      margin-top: 0;
      padding-top: 0;
    }
    .site-menu__link {
      width: 100%;
    }
    /* Figma sets these links at 24px (H3 spacing) — not one of the 5 styles; to confirm
       with the designer. Smaller only when the panel is short. */
    .site-menu__link {
      font-size: clamp(17px, 7.7cqh, 24px);
    }
    .site-menu__arrow {
      width: 1em;
      height: 1em;
    }
    .site-menu__hello {
      grid-row: 3;
    }
    .site-menu__hello-title {
      top: 16px;
    }
    .site-menu__socials {
      bottom: 16px;
      gap: clamp(4px, 1.6svh, 12px);
    }
  }
</style>
