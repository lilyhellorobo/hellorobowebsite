---
/**
 * Pre-footer CTA — Figma "block" 1728×949 (Home 10093:2001, Careers 10100:15564).
 * Marked as a WebGL scene; the printer image is its static poster.
 * Two copy variants appear in the designs:
 *   "conversation" — "Start conversation if you are ready to make world say yes" + stamp
 *   "building"     — "Tell us what you are building" + "[Click anywhere to start]"
 */
import WebGLSlot from '../ui/WebGLSlot.astro';
import { studio } from '../../data/site';

interface Props {
  variant?: 'conversation' | 'building';
}
const { variant = 'conversation' } = Astro.props;
const title = 'Tell us what you are building';
---
<section class="prefooter" aria-label="Start a project">
  <WebGLSlot name="prefooter" class="prefooter__scene">
    <img
      class="prefooter__printer"
      src="/images/shell/prefooter-printer.png"
      alt=""
      width="994" style="--w: 994"
      height="949"
      loading="lazy"
      decoding="async"
    />
  </WebGLSlot>

  <a class="prefooter__link" href="/contact">
    {variant === 'building' ? (
      <h2 class="prefooter__title t-h2">{title}</h2>
    ) : (
      <h2 class="prefooter__title t-h2">Start conversation<br class="only-mobile" /> if you are ready to<br class="only-mobile" /> make world say yes</h2>
    )}
  </a>

  <!-- Mobile layout (Figma 10129:31418): stamp under the title; at the bottom two buttons
       side by side and "Copy our email" full width under them -->
  <div class="prefooter__actions only-mobile">
    <a class="prefooter__button t-button" href="/contact#name">Start a project</a>
    <a class="prefooter__button t-button" href="/contact#message">Drop a word</a>
    <button class="prefooter__button prefooter__button--wide t-button" type="button" data-copy-email={studio.email}>
      <span data-copy-label>Copy our email</span>
    </button>
  </div>

  {variant === 'conversation' ? (
    <img
      class="prefooter__stamp"
      src="/images/shell/stamp-human-core.svg"
      alt=""
      width="403" style="--w: 403"
      height="174"
      loading="lazy"
    />
  ) : (
    <p class="prefooter__hint t-body">[Click anywhere to start]</p>
  )}
</section>

<script>
  // "Copy our email": puts the address on the clipboard and says so for a moment
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy-email]')) {
    const label = btn.querySelector<HTMLElement>('[data-copy-label]');
    if (!label) continue;
    const text = label.textContent;
    let timer = 0;
    btn.addEventListener('click', async () => {
      const email = btn.dataset.copyEmail ?? '';
      try {
        await navigator.clipboard.writeText(email);
        label.textContent = 'Email copied';
      } catch {
        // no clipboard access (old browser / not https): open the mail app instead
        location.href = `mailto:${email}`;
        return;
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => (label.textContent = text), 2000);
    });
  }
</script>

<style>
  .prefooter {
    position: relative;
    aspect-ratio: 1728 / 949;
    background: var(--color-grey-350);
    color: var(--color-white);
    overflow: hidden;
  }
  .prefooter :global(.prefooter__scene) {
    position: absolute;
    inset: 0;
  }
  .prefooter__printer {
    position: absolute;
    top: 0;
    left: calc(607 / 1728 * 100%);
    width: calc(994 / 1728 * 100%);
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply; /* as in Figma: the photo's white ground takes the grey */
  }
  /* The whole block is clickable ("Click anywhere to start") */
  .prefooter__link {
    position: absolute;
    inset: 0;
    z-index: var(--z-raised);
    padding: var(--space-40);
  }
  .prefooter__title {
    max-width: calc(716 * var(--px));
  }
  .prefooter__stamp,
  .prefooter__hint {
    position: absolute;
    left: var(--space-40);
    bottom: var(--space-40);
    z-index: var(--z-raised);
    pointer-events: none;
  }
  .prefooter__stamp {
    width: calc(403 / 1728 * 100%);
    min-width: calc(200 * var(--px));
    height: auto;
  }

  /* ── Mobile: Figma 390×694 ─────────────────────────────── */
  @media (max-width: 1023px) {
    /* Full screen height (Figma's frame is 694 on a 390×844 phone) */
    .prefooter {
      aspect-ratio: auto;
      height: 100vh;
      height: 100svh;
      min-height: 600px;
    }
    /* Printer photo fitted (not cropped) in Figma's 424-wide box from 97 down to 38 past
       the bottom; the box stretches with the screen height */
    .prefooter__printer {
      left: 39px;
      top: 97px;
      width: 424px;
      max-width: none;
      height: calc(100% - 97px + 38px);
      object-fit: contain;
    }
    /* Only the title is the link here; the buttons below do the rest */
    .prefooter__link {
      inset: auto;
      top: 44px;
      left: var(--page-margin);
      right: var(--page-margin);
      padding: 0;
    }
    /* Figma uses Mobile/H3 for this title (line breaks as in Figma) */
    .prefooter__title {
      max-width: none;
      font-size: var(--type-h3-size);
      line-height: var(--type-h3-line);
      letter-spacing: var(--type-h3-track);
    }
    /* Stamp 224×96 under the title, at (9, 168) — the SVG's stroke overflow takes it
       7 left of the margin */
    .prefooter__stamp {
      left: calc(var(--page-margin) - 7px);
      top: 168px;
      bottom: auto;
      width: 224px;
      min-width: 0;
    }
    /* The buttons replace "[Click anywhere to start]" on mobile */
    .prefooter__hint {
      display: none;
    }
    /* Buttons: white, 48 tall, label centred; 8 between the pair, 12 above the email one.
       The block fills the screen, so they stand 8 above the fixed menu bar, not under it */
    .prefooter__actions {
      position: absolute;
      left: var(--page-margin);
      right: var(--page-margin);
      bottom: calc(var(--page-margin) + var(--nav-height) + 8px);
      z-index: var(--z-raised);
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px 8px;
    }
    .prefooter__button {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 48px;
      padding: 12px;
      background: var(--color-white);
      color: var(--color-black);
      border-radius: var(--radius-ui);
      /* Figma: 12 in the Button style (the mobile button size) */
      font-size: 12px;
      white-space: nowrap;
      transition: background-color 0.2s ease;
    }
    .prefooter__button:active {
      background: var(--color-grey-100);
    }
    .prefooter__button--wide {
      grid-column: 1 / -1;
    }
  }
</style>
