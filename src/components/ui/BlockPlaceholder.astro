---
/**
 * BlockPlaceholder — stands in for a block that hasn't been built yet.
 * Keeps the block's Figma height so every page already has its real length,
 * and links to the Figma node.
 */
interface Props {
  name: string;
  /** Figma node id, e.g. "10093:119" */
  node: string;
  /** Height of the block in the 1728px Figma frame */
  height: number;
  kind?: 'static' | 'cms' | 'webgl' | 'video';
  tone?: 'light' | 'dark';
}
const { name, node, height, kind = 'static', tone = 'light' } = Astro.props;
const figmaUrl = `https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=${node.replace(':', '-')}`;
---
<section
  class:list={['block-placeholder', `block-placeholder--${tone}`]}
  style={`--block-h: ${height}`}
  data-block={name}
>
  <div class="block-placeholder__inner container">
    <span class="t-button">{name}</span>
    <span class="block-placeholder__meta t-body">
      <span class={`kind kind--${kind}`}>{kind}</span>
      <a href={figmaUrl} target="_blank" rel="noopener">Figma {node} ↗</a>
    </span>
  </div>
</section>

<style>
  .block-placeholder {
    /* Figma height scaled to the viewport width (frame is 1728 wide) */
    min-height: calc(var(--block-h) / 1728 * min(100vw, var(--page-max)));
    display: flex;
    border-bottom: 1px dashed var(--line-on-light);
    background: var(--color-grey-100);
    color: var(--color-grey-600);
  }
  .block-placeholder--dark {
    background: var(--color-ink);
    color: rgb(255 255 255 / 0.6);
    border-bottom-color: var(--line-on-dark);
  }
  .block-placeholder__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-12);
    padding-block: var(--space-40);
  }
  .block-placeholder__meta {
    display: flex;
    gap: var(--space-16);
    align-items: center;
  }
  .block-placeholder__meta a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .kind {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border-radius: var(--radius-ui);
    background: var(--color-white);
    color: var(--color-black);
  }
  .kind--cms { background: #dfe8ff; color: #1d4fb8; }
  .kind--webgl { background: var(--color-orange); color: var(--color-white); }
  .kind--video { background: var(--color-black); color: var(--color-white); }
</style>
