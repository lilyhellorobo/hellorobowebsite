---
/**
 * VideoSlot — keeps a video's size from Figma and shows its poster frame.
 * Pass `src` once the video file exists; until then only the poster renders.
 */
interface Props {
  ratio: string;
  poster?: string;
  src?: string;
  alt?: string;
  class?: string;
}
const { ratio, poster, src, alt = '', class: className } = Astro.props;
---
<div class:list={['video-slot', className]} style={`aspect-ratio: ${ratio}`}>
  {src ? (
    <video class="video-slot__media" src={src} poster={poster} muted playsinline loop preload="none"></video>
  ) : poster ? (
    <img class="video-slot__media" src={poster} alt={alt} loading="lazy" decoding="async" />
  ) : null}
</div>

<style>
  .video-slot {
    position: relative;
    width: 100%;
    background: var(--color-ink-warm);
    overflow: hidden;
  }
  .video-slot__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
