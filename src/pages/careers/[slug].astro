---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PositionHero from '../../blocks/position/PositionHero.astro';
import PositionDetails from '../../blocks/position/PositionDetails.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const positions = await getCollection('positions');
  return positions.map((position) => ({ params: { slug: position.id }, props: { position } }));
}
const { position } = Astro.props as { position: CollectionEntry<'positions'> };
---
<BaseLayout title={position.data.title} prefooter="building" back="/careers" headerVariant="grey">
  <PositionHero title={position.data.title} />
  <PositionDetails position={position} />
</BaseLayout>
