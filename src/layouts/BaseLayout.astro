---
/**
 * BaseLayout — the shell every page shares:
 * Get in touch (top right) · page content · pre-footer CTA · footer · nav pill.
 */
import '../styles/global.css';
import GetInTouch from '../components/global/GetInTouch.astro';
import NavPill from '../components/global/NavPill.astro';
import PreFooterCTA from '../components/global/PreFooterCTA.astro';
import Footer from '../components/global/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Color of the Get in touch button: white on pages that open on black */
  headerVariant?: 'dark' | 'light' | 'grey';
  /** Shows the pre-footer contact block (false hides it; the old copy variants all show the same block now) */
  prefooter?: 'conversation' | 'building' | false;
  /** Adds the back button to the nav pill */
  back?: string;
  footer?: boolean;
  /** Get in touch + nav pill / menu; false on full-screen flows like Contact (Figma
      shows neither there) */
  chrome?: boolean;
}
const {
  title,
  description = 'Hello Robo designs the human side of robotics.',
  headerVariant = 'dark',
  prefooter = 'conversation',
  back,
  footer = true,
  chrome = true,
} = Astro.props;
const pageTitle = title === 'Home' ? 'Hello Robo — Make the world say yes to your robot' : `${title} — Hello Robo`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/AllianceNo2-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Hovering a link to another page of the site (~200ms) prepares that page in the
         background, images included, so it opens instantly. Chrome / Edge; the CMS is
         left out. Desktop only (wide screen + mouse): a page prepared in the background
         can be laid out for the wrong screen when the browser's phone view emulates a
         phone (the menu bar and everything else came out bigger after a tap), and phones
         don't hover anyway — there, pages simply load as usual. -->
    <script is:inline>
      if (HTMLScriptElement.supports?.('speculationrules') && matchMedia('(min-width: 1024px) and (hover: hover) and (pointer: fine)').matches) {
        const rules = document.createElement('script');
        rules.type = 'speculationrules';
        rules.textContent = JSON.stringify({
          prerender: [
            {
              where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/admin*' } }, { not: { href_matches: '/api/*' } }] },
              eagerness: 'moderate',
            },
          ],
        });
        document.head.append(rules);
      }
    </script>
  </head>
  <body>
    {chrome && <GetInTouch variant={headerVariant} />}
    <main>
      <slot />
    </main>
    {prefooter && <PreFooterCTA />}
    {footer && <Footer />}
    {chrome && <NavPill back={back} />}
    <script is:inline>
      // Fade images in as they arrive instead of popping (styles in global.css)
      for (const img of document.images) {
        if (img.complete && img.naturalWidth) continue;
        img.classList.add('img-wait');
        img.addEventListener('load', () => {
          img.classList.replace('img-wait', 'img-in');
          img.addEventListener('animationend', () => img.classList.remove('img-in'), { once: true });
        }, { once: true });
        img.addEventListener('error', () => img.classList.remove('img-wait'), { once: true });
      }
    </script>
  </body>
</html>
