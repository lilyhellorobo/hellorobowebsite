---
/**
 * BaseLayout — the shell every page shares:
 * Get in touch (top right) · page content · pre-footer CTA · footer · nav pill.
 */
import '../styles/global.css';
import GetInTouch from '../components/global/GetInTouch.astro';
import NavPill from '../components/global/NavPill.astro';
import PreFooterCTA from '../components/global/PreFooterCTA.astro';
import Footer from '../components/global/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Color of the Get in touch button: white on pages that open on black */
  headerVariant?: 'dark' | 'light' | 'grey';
  /** Shows the pre-footer contact block (false hides it; the old copy variants all show the same block now) */
  prefooter?: 'conversation' | 'building' | false;
  /** Adds the back button to the nav pill */
  back?: string;
  footer?: boolean;
  /** Get in touch + nav pill / menu */
  chrome?: boolean;
  /** "Close" instead of "Get in touch" (the /contact page) */
  close?: boolean;
}
const {
  title,
  description = 'Hello Robo designs the human side of robotics.',
  headerVariant = 'dark',
  prefooter = 'conversation',
  back,
  footer = true,
  chrome = true,
  close = false,
} = Astro.props;
const pageTitle = title === 'Home' ? 'Hello Robo — Make the world say yes to your robot' : `${title} — Hello Robo`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/AllianceNo2-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Page transition (src/scripts/page-transition.ts): a page reached through it opens
         covered by the black columns, before its first paint; one being prepared in the
         background while hovering a link does too (uncovered on arrival if it wasn't). -->
    <script is:inline>
      (() => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        let came = false;
        try {
          came = sessionStorage.getItem('pt') === '1';
        } catch {}
        if (came || document.prerendering) document.documentElement.classList.add('pt-cover');
      })();
    </script>
    <!-- Hovering a link to another page of the site (~200ms) prepares that page in the
         background, images included, so it opens instantly. Chrome / Edge; the CMS is
         left out. Desktop only (wide screen + mouse): a page prepared in the background
         can be laid out for the wrong screen when the browser's phone view emulates a
         phone (the menu bar and everything else came out bigger after a tap), and phones
         don't hover anyway — there, pages simply load as usual. -->
    <script is:inline>
      if (HTMLScriptElement.supports?.('speculationrules') && matchMedia('(min-width: 1024px) and (hover: hover) and (pointer: fine)').matches) {
        const rules = document.createElement('script');
        rules.type = 'speculationrules';
        rules.textContent = JSON.stringify({
          prerender: [
            {
              where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/admin*' } }, { not: { href_matches: '/api/*' } }] },
              eagerness: 'moderate',
            },
          ],
        });
        document.head.append(rules);
      }
    </script>
  </head>
  <body>
    <div class="pt" aria-hidden="true">
      <span class="pt__col" style="--i: 0"></span><span class="pt__col" style="--i: 1"></span><span class="pt__col" style="--i: 2"></span><span class="pt__col" style="--i: 3"></span><span class="pt__col pt__col--wide" style="--i: 4"></span><span class="pt__col pt__col--wide" style="--i: 5"></span><span class="pt__col pt__col--wide" style="--i: 6"></span><span class="pt__col pt__col--wide" style="--i: 7"></span>
      <span class="pt__logo" data-pt-logo>
        <img class="pt__eyes-open" src="/images/transition/logo-open.svg" alt="" width="94" height="51" />
        <img class="pt__eyes-closed" src="/images/transition/logo-blink.svg" alt="" width="94" height="51" />
      </span>
    </div>
    {chrome && <GetInTouch variant={headerVariant} close={close} />}
    <main>
      <slot />
    </main>
    {prefooter && <PreFooterCTA />}
    {footer && <Footer />}
    {chrome && <NavPill back={back} />}
    <script>
      import '../scripts/button-hover';
      import '../scripts/headline-reveal';
      import '../scripts/image-reveal';
      import '../scripts/text-reveal';
      import '../scripts/page-transition';
    </script>
    <script is:inline>
      // Fade images in as they arrive instead of popping (styles in global.css)
      for (const img of document.images) {
        if ((img.complete && img.naturalWidth) || img.closest('.pt')) continue;
        img.classList.add('img-wait');
        img.addEventListener('load', () => {
          img.classList.replace('img-wait', 'img-in');
          img.addEventListener('animationend', () => img.classList.remove('img-in'), { once: true });
        }, { once: true });
        img.addEventListener('error', () => img.classList.remove('img-wait'), { once: true });
      }

      // Headings never end a line on a one- or two-letter word ("We", "a", "to", "&"):
      // the space after such a word becomes a no-break space, so it moves down with the
      // next word. Runs before the first paint, on CMS text too.
      for (const h of document.querySelectorAll('h1, h2, h3, .t-h1, .t-h2, .t-h3')) {
        const walker = document.createTreeWalker(h, NodeFilter.SHOW_TEXT);
        for (let node = walker.nextNode(); node; node = walker.nextNode()) {
          const text = node.nodeValue;
          // inside one text node: "calling. We think" → "calling. We\u00a0think"
          let next = text.replace(/(^|[\s\u00a0])([^\s\u00a0]{1,2}) +(?=\S)/g, '$1$2\u00a0');
          next = next.replace(/(^|[\s\u00a0])([^\s\u00a0]{1,2}) +(?=\S)/g, '$1$2\u00a0'); // runs like "is a to"
          // words split into their own elements (e.g. reveal masks): a lone space after a short one
          if (/^ +$/.test(text)) {
            const prev = node.previousSibling;
            if (prev && prev.textContent.trim().length > 0 && prev.textContent.trim().length <= 2) next = '\u00a0';
          }
          if (next !== text) node.nodeValue = next;
        }
      }
    </script>
  </body>
</html>
